From 69646b4c59dc0c880a97683469d4a8026066f932 Mon Sep 17 00:00:00 2001
From: Allen Gregory <allengregoryiv@gmail.com>
Date: Fri, 6 Nov 2026 06:12:20 -0600
Subject: [PATCH 1/3] Native camera: passthrough input stream (the camera's own
 JPEG, no re-encode) and rising sequence IDs across a handover

NativeFrameProvider pumps cameraLatestJpeg into the input MjpegServer through a raw MJPEG source (compression -1) at the stream rate while it is watched (SPECTRUM_STREAM_PASSTHROUGH=0 off); the Java pipeline is raised to the stream rate only for Mat-fed streams (the output overlay stream). The native publish continues the camera's sequence IDs (cameraOpenSeq) and the Java path continues from the native one at a handover, so IDs never go back (the 21 tag-quality mismatches in the handover test were IDs reused across the switch).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../org/photonvision/jni/NapaDetectorJNI.java |  7 ++
 .../frame/consumer/MJPGFrameConsumer.java     | 51 ++++++++++-
 .../frame/provider/NativeFrameProvider.java   | 88 ++++++++++++++++++-
 .../vision/processes/VisionModule.java        |  7 ++
 .../vision/processes/VisionRunner.java        |  2 +-
 5 files changed, 150 insertions(+), 5 deletions(-)

diff --git a/photon-core/src/main/java/org/photonvision/jni/NapaDetectorJNI.java b/photon-core/src/main/java/org/photonvision/jni/NapaDetectorJNI.java
index 6b671fe2..cd7f2c98 100644
--- a/photon-core/src/main/java/org/photonvision/jni/NapaDetectorJNI.java
+++ b/photon-core/src/main/java/org/photonvision/jni/NapaDetectorJNI.java
@@ -163,6 +163,13 @@ public final class NapaDetectorJNI {
      */
     public static native int cameraLatestJpeg(long handle, java.nio.ByteBuffer direct);
 
+    /** As cameraOpen; the first published result's sequence ID is lastSeq + 1. */
+    public static native long cameraOpenSeq(
+            String dev, int width, int height, int fps, String family, long lastSeq);
+
+    /** The last sequence ID the camera's native publish used. */
+    public static native long cameraSequence(long handle);
+
     // The device itself, without a capture handle (NativeCameraSettables: no cscore UsbCamera)
 
     /**
diff --git a/photon-core/src/main/java/org/photonvision/vision/frame/consumer/MJPGFrameConsumer.java b/photon-core/src/main/java/org/photonvision/vision/frame/consumer/MJPGFrameConsumer.java
index f3cbe24c..49bb573e 100644
--- a/photon-core/src/main/java/org/photonvision/vision/frame/consumer/MJPGFrameConsumer.java
+++ b/photon-core/src/main/java/org/photonvision/vision/frame/consumer/MJPGFrameConsumer.java
@@ -69,12 +69,55 @@ public class MJPGFrameConsumer implements AutoCloseable {
      * (CS_CONNECTION_AUTO_MANAGE).
      */
     public boolean hasViewers() {
-        return cvSource != null && cvSource.isEnabled();
+        return (cvSource != null && cvSource.isEnabled())
+                || (rawSource != null && rawSource.isEnabled());
+    }
+
+    // Spectrum (sc/mjpeg-napa) native camera backend: the camera's own JPEG served as it came (no
+    // decode, no re-encode). The server is switched to a raw MJPEG source while it is fed this way
+    // and
+    // back to the CvSource when Mat frames come again (e.g. the cscore handover for calibration).
+    private org.wpilib.vision.camera.raw.RawSource rawSource;
+    private volatile boolean onRaw = false;
+
+    /** True while any stream fed with Mats (frames the Java pipeline must make) has a viewer. */
+    public static boolean anyMatViewers() {
+        for (var c : OPEN) {
+            try {
+                if (!c.onRaw && c.cvSource != null && c.cvSource.isEnabled()) return true;
+            } catch (RuntimeException e) {
+                // closing concurrently
+            }
+        }
+        return false;
+    }
+
+    /** Serves this JPEG (a direct buffer, position 0, limit = its length) without re-encoding. */
+    public synchronized void acceptJpeg(java.nio.ByteBuffer jpeg, int width, int height) {
+        if (mjpegServer == null) return;
+        if (rawSource == null)
+            rawSource =
+                    new org.wpilib.vision.camera.raw.RawSource(
+                            cvSource.getName() + "_jpeg", PixelFormat.MJPEG, width, height, 30);
+        if (!onRaw) {
+            mjpegServer.setSource(rawSource);
+            mjpegServer.setCompression(-1); // pass the camera's JPEG through
+            onRaw = true;
+        }
+        rawSource.putFrame(jpeg, width, height, 0, PixelFormat.MJPEG);
+    }
+
+    private synchronized void backToMats() {
+        if (!onRaw || mjpegServer == null) return;
+        mjpegServer.setSource(cvSource);
+        mjpegServer.setCompression(75);
+        onRaw = false;
     }
 
     public void accept(CVMat image) {
         long now = NetworkTablesJNI.now();
 
+        if (onRaw) backToMats();
         if (image == null || image.getMat() == null || image.getMat().empty()) {
             image.copyFrom(StaticFrames.LOST_MAT);
         }
@@ -86,11 +129,15 @@ public class MJPGFrameConsumer implements AutoCloseable {
     }
 
     @Override
-    public void close() {
+    public synchronized void close() {
         OPEN.remove(this);
         CameraServer.removeServer(mjpegServer.getName());
         mjpegServer.close();
         cvSource.close();
+        synchronized (this) {
+            if (rawSource != null) rawSource.close();
+            rawSource = null;
+        }
         mjpegServer = null;
         cvSource = null;
     }
diff --git a/photon-core/src/main/java/org/photonvision/vision/frame/provider/NativeFrameProvider.java b/photon-core/src/main/java/org/photonvision/vision/frame/provider/NativeFrameProvider.java
index 8dca44de..0dbf04d0 100644
