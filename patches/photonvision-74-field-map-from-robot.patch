+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package org.photonvision.fieldmap;
+
+import edu.wpi.first.apriltag.AprilTag;
+import edu.wpi.first.apriltag.AprilTagFieldLayout;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HexFormat;
+import java.util.Locale;
+
+/**
+ * SpectrumJetson (photonvision-74): the field-map hash robot code and the Jetson both compute, so
+ * each can tell the other which map it means. The robot side computes the same thing; change it
+ * only together with robot code.
+ *
+ * <p>Tags sorted by ID, one line each, {@code id,x,y,z,qw,qx,qy,qz} (meters, the tag pose's
+ * rotation quaternion), then {@code field,<length>,<width>}; every number {@code %.4f} in
+ * {@link Locale#ROOT}; lines joined with "\n", no trailing newline; SHA-256 of the UTF-8 bytes,
+ * lowercase hex, first 16 characters.
+ *
+ * <p>Java's {@code %.4f} rounds the shortest decimal form of the double half-up, and keeps the
+ * sign of a value that rounds to zero ("-0.0000"). Python's {@code f"{v:.4f}"} rounds the exact
+ * binary value half-even, so it disagrees on ties: the 2026 field's 0.55245 m tag height is
+ * "0.5525" here and "0.5524" in Python. A non-Java implementation has to round like Java.
+ */
+public final class FieldMapHash {
+    private FieldMapHash() {}
+
+    /** The text the hash is taken of. */
+    public static String canonical(AprilTagFieldLayout layout) {
+        var tags = new ArrayList<AprilTag>(layout.getTags());
+        tags.sort(Comparator.comparingInt(t -> t.ID));
+        var sb = new StringBuilder();
+        for (AprilTag tag : tags) {
+            var p = tag.pose;
+            var q = p.getRotation().getQuaternion();
+            sb.append(tag.ID);
+            for (double v : new double[] {p.getX(), p.getY(), p.getZ(), q.getW(), q.getX(), q.getY(), q.getZ()}) {
+                sb.append(',').append(format(v));
+            }
+            sb.append('\n');
+        }
+        sb.append("field,")
+                .append(format(layout.getFieldLength()))
+                .append(',')
+                .append(format(layout.getFieldWidth()));
+        return sb.toString();
+    }
+
+    public static String hash(AprilTagFieldLayout layout) {
+        return hashText(canonical(layout));
+    }
+
+    static String format(double v) {
+        return String.format(Locale.ROOT, "%.4f", v);
+    }
+
+    static String hashText(String canonical) {
+        try {
+            var md = MessageDigest.getInstance("SHA-256");
+            var digest = md.digest(canonical.getBytes(StandardCharsets.UTF_8));
+            return HexFormat.of().formatHex(digest).substring(0, 16);
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
diff --git a/photon-core/src/main/java/org/photonvision/fieldmap/FieldMapNT.java b/photon-core/src/main/java/org/photonvision/fieldmap/FieldMapNT.java
