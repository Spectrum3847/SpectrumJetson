+                <td>{{ c }}</td>
+                <td>{{ fmt(results.rmsPxByCamera[c], 2) }}</td>
+                <td>{{ fmt((m.robotToCamera ?? m.rigFrame).z, 3) }}</td>
+                <td>{{ fmt((m.robotToCamera ?? m.rigFrame).pitchDeg, 2) }}</td>
+                <td>{{ fmt((m.robotToCamera ?? m.rigFrame).rollDeg, 2) }}</td>
+                <td>{{ m.robotToCamera ? fmt(m.robotToCamera.x, 3) : "rel." }}</td>
+                <td>{{ m.robotToCamera ? fmt(m.robotToCamera.y, 3) : "rel." }}</td>
+                <td>{{ m.robotToCamera ? fmt(m.robotToCamera.yawDeg, 2) : "rel." }}</td>
+                <td class="text-caption">
+                  <span v-if="m.minusCad"
+                    >{{ fmt(m.minusCad.z * 100) }} cm high, {{ fmt(m.minusCad.pitchDeg, 2) }}° pitch,
+                    {{ fmt(m.minusCad.rollDeg, 2) }}° roll, {{ fmt(m.minusCad.x * 100) }}/{{
+                      fmt(m.minusCad.y * 100)
+                    }}
+                    cm, {{ fmt(m.minusCad.yawDeg, 2) }}° yaw</span
+                  >
+                </td>
+                <td>
+                  <v-chip v-if="results.lensCheck[c]?.recalibrate" size="small" color="error">recalibrate</v-chip>
+                </td>
