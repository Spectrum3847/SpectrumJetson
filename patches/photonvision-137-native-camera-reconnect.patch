+        if ((cam == sentCam && opens == sentCamOpens) || lastParams == null) return;
         NapaDetectorJNI.setParams(
                 cam,
                 (int) lastParams[0],
@@ -100,6 +102,7 @@ public class NapaDetector implements Releasable {
                 (int) lastParams[3],
                 (double) lastParams[4]);
         sentCam = cam;
+        sentCamOpens = opens;
     }
 
     private static Boolean streamOn = null;
