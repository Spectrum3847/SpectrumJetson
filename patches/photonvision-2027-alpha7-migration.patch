+  () => useCameraSettingsStore().currentPipelineSettings
+);
+const { mdAndDown } = useDisplay();
+const interactiveCols = computed(() =>
+  mdAndDown.value && (!useStateStore().sidebarFolded || useCameraSettingsStore().isDriverMode) ? 8 : 7
+);
