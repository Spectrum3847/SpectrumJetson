+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package org.photonvision.common.hardware;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.photonvision.common.configuration.ConfigManager;
+import org.photonvision.common.dataflow.networktables.NetworkTablesManager;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+import org.photonvision.vision.processes.VisionSourceManager;
+
+/**
+ * SpectrumJetson (photonvision-87): Thriftiest Cam firmware from Settings > Thriftiest Cam firmware.
+ *
+ * <ul>
+ *   <li>Which firmware each camera runs: {@code thriftiest-fw.py variant}, which reads a few flash
+ *       bytes through the video driver while the camera streams (every variant reports 5.13).
+ *   <li>Firmware files are uploaded once and kept on the settings partition ({@link #store()}),
+ *       checked with {@code thriftiest-fw.py check-image}. None ship with PhotonVision.
+ *   <li>A flash runs {@code thriftiest-flash-job.sh} as a transient systemd unit: it stops
+ *       PhotonVision (whose camera watchdog would reset the camera mid-write), flashes with a backup
+ *       and every check, and starts PhotonVision again. Its progress is in {@link #JOB_STATUS}.
+ * </ul>
+ *
+ * The scripts are the repo's own, found through /opt/photonvision/health-check.sh, the link
+ * 06-install-fork-jar.sh makes to the repo's scripts/jetson.
+ */
+public final class ThriftiestFirmware {
+    private static final Logger logger = new Logger(ThriftiestFirmware.class, LogGroup.General);
+    private static final ObjectMapper json = new ObjectMapper();
+    private static final Path JOB_STATUS = Path.of("/run/spectrum/thriftiest-flash.json");
+    private static final long MAX_IMAGE_BYTES = 512 * 1024;
+
+    private record CheckedImage(long size, long mtime, JsonNode check) {}
+
+    private static final Map<String, CheckedImage> checked = new HashMap<>();
+
+    private ThriftiestFirmware() {}
+
+    private static Path scripts() throws IOException {
+        return Path.of("/opt/photonvision/health-check.sh").toRealPath().getParent();
+    }
+
+    private static Path store() {
+        return ConfigManager.getInstance().getLogsDir().getParent().resolve("thriftiest-firmware");
+    }
+
+    /** Runs thriftiest-fw.py with these arguments and parses its JSON output. */
+    private static JsonNode tool(String... args) throws IOException {
+        var cmd = new ArrayList<String>(List.of("python3", scripts().resolve("thriftiest-fw.py").toString()));
+        cmd.addAll(List.of(args));
+        var p = new ProcessBuilder(cmd).redirectError(ProcessBuilder.Redirect.DISCARD).start();
+        String out = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
+        try {
+            if (!p.waitFor(15, TimeUnit.SECONDS)) {
+                p.destroyForcibly();
+                throw new IOException("thriftiest-fw.py " + args[0] + " timed out");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("interrupted");
+        }
+        if (out.isBlank()) throw new IOException("thriftiest-fw.py " + args[0] + " gave no answer");
+        return json.readTree(out);
+    }
+
+    /** USB port ("2.1") -> PhotonVision camera nickname, for the cameras PhotonVision runs. */
+    private static Map<String, String> nicknames() {
+        var out = new HashMap<String, String>();
+        for (var m : VisionSourceManager.getInstance().vmm.getModules()) {
+            try {
+                var video = Path.of(m.getCameraConfiguration().getDevicePath()).toRealPath().getFileName();
+                var usb = Path.of("/sys/class/video4linux", video.toString(), "device").toRealPath().getParent();
+                String port = usb.getFileName().toString(); // 1-2.3
+                out.put(port.substring(port.indexOf('-') + 1), m.getCameraConfiguration().nickname);
+            } catch (Exception e) {
+                // not on USB right now
+            }
+        }
+        return out;
+    }
+
+    private static boolean robotEnabled() {
+        var ntm = NetworkTablesManager.getInstance();
+        if (!ntm.getNTInst().isConnected()) return false;
+        var ds = ntm.getDriverStation();
+        return ds != null && ds.hasControlWord() && ds.current().m_enabled();
+    }
+
+    private static JsonNode job() {
+        try {
+            return Files.exists(JOB_STATUS) ? json.readTree(JOB_STATUS.toFile()) : null;
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private static boolean jobRunning() {
+        var j = job();
+        return j != null
+                && "running".equals(j.path("state").asText())
+                && System.currentTimeMillis() / 1000 - j.path("updated").asLong() < 120;
+    }
+
+    /** Cameras with their firmware, the stored firmware files, the flash job, and the robot's state. */
+    public static synchronized Map<String, Object> status() {
+        var out = new LinkedHashMap<String, Object>();
+        var names = nicknames();
+        try {
+            var cams = tool("variant", "--json");
+            for (var c : cams) {
+                ((com.fasterxml.jackson.databind.node.ObjectNode) c).put("camera", names.getOrDefault(c.path("port").asText(), ""));
+            }
+            out.put("cameras", cams);
+        } catch (IOException e) {
+            out.put("cameras", List.of());
+            out.put("error", "Couldn't read the cameras' firmware: " + e.getMessage());
+        }
+        var images = new ArrayList<JsonNode>();
+        try (var files = Files.list(store())) {
+            for (var f : files.filter(f -> f.toString().endsWith(".bin")).sorted().toList()) {
+                long size = Files.size(f), mtime = Files.getLastModifiedTime(f).toMillis();
+                var c = checked.get(f.getFileName().toString());
+                if (c == null || c.size() != size || c.mtime() != mtime) {
+                    c = new CheckedImage(size, mtime, tool("check-image", "--json", f.toString()));
+                    checked.put(f.getFileName().toString(), c);
+                }
+                images.add(c.check());
+            }
+        } catch (IOException e) {
+            // no store yet
+        }
+        out.put("images", images);
+        out.put("job", job());
+        out.put("robotEnabled", robotEnabled());
+        return out;
+    }
+
+    /** Stores an uploaded firmware file, after checking it's a Thriftiest Cam image. */
+    public static synchronized JsonNode upload(String name, InputStream content) throws IOException {
+        name = Path.of(name).getFileName().toString();
+        if (!name.matches("[A-Za-z0-9._+-]{1,100}\\.bin")) {
+            throw new IOException("Firmware files are .bin, named with letters, digits and . _ + - only");
+        }
+        Files.createDirectories(store());
+        var tmp = store().resolve(name + ".upload");
+        try {
+            byte[] bytes = content.readNBytes((int) MAX_IMAGE_BYTES + 1);
+            if (bytes.length > MAX_IMAGE_BYTES) throw new IOException("Too big for the camera's 512 KiB flash");
+            Files.write(tmp, bytes);
+            var check = tool("check-image", "--json", tmp.toString());
+            if (!check.path("error").isNull() && !check.path("error").asText().isEmpty()) {
+                throw new IOException(check.path("error").asText());
+            }
+            Files.move(tmp, store().resolve(name), StandardCopyOption.REPLACE_EXISTING);
+            ((com.fasterxml.jackson.databind.node.ObjectNode) check).put("file", name); // not the temporary name
+            logger.info("Stored Thriftiest Cam firmware " + name + " (" + check.path("label").asText() + ")");
+            return check;
+        } finally {
+            Files.deleteIfExists(tmp);
+        }
+    }
+
+    public static synchronized void delete(String name) throws IOException {
+        var f = store().resolve(Path.of(name).getFileName().toString());
+        if (!f.toString().endsWith(".bin") || !Files.deleteIfExists(f)) throw new IOException("No firmware file " + name);
+        checked.remove(f.getFileName().toString());
+    }
+
+    /**
+     * Starts flashing a stored firmware file onto the camera in a USB port. PhotonVision is stopped
+     * for about a minute (every camera) and started again by the job.
+     */
+    public static synchronized void flash(String port, String image) throws IOException {
+        if (robotEnabled()) throw new IOException("The robot is enabled: disable it first");
+        if (jobRunning()) throw new IOException("A camera is already being flashed");
+        boolean known = false;
+        for (var c : tool("variant", "--json")) known |= c.path("port").asText().equals(port);
+        if (!known) throw new IOException("No Thriftiest Cam on USB port " + port);
+        var file = store().resolve(Path.of(image).getFileName().toString());
+        if (!Files.exists(file)) throw new IOException("No firmware file " + image);
+        Files.createDirectories(JOB_STATUS.getParent());
+        Files.writeString(
+                JOB_STATUS,
+                json.writeValueAsString(
+                        Map.of(
+                                "state", "running", "message", "Starting", "port", port, "image", file.getFileName().toString(),
+                                "started", System.currentTimeMillis() / 1000, "updated", System.currentTimeMillis() / 1000,
+                                "log", List.of())));
+        logger.warn("Flashing " + file.getFileName() + " onto the Thriftiest Cam on USB port " + port + ": PhotonVision stops for about a minute");
+        new ProcessBuilder(
+                        "systemd-run", "--unit=spectrum-thriftiest-flash", "--collect", "/bin/bash",
+                        scripts().resolve("thriftiest-flash-job.sh").toString(), port, file.toString())
+                .redirectErrorStream(true)
+                .redirectOutput(ProcessBuilder.Redirect.DISCARD)
+                .start();
+    }
+}
diff --git a/photon-server/src/main/java/org/photonvision/server/RequestHandler.java b/photon-server/src/main/java/org/photonvision/server/RequestHandler.java
index 69ad1db6..27127ce9 100644
--- a/photon-server/src/main/java/org/photonvision/server/RequestHandler.java
+++ b/photon-server/src/main/java/org/photonvision/server/RequestHandler.java
@@ -748,6 +748,50 @@ public class RequestHandler {
         return out;
     }
 
+    // SpectrumJetson (photonvision-87): Settings > Thriftiest Cam firmware.
+    private record ThriftiestFlashRequest(String port, String image) {}
+
+    public static void onThriftiestFirmwareRequest(Context ctx) {
+        snapshotJson(ctx, org.photonvision.common.hardware.ThriftiestFirmware.status());
+    }
+
+    public static void onThriftiestFirmwareUploadRequest(Context ctx) {
+        var file = ctx.uploadedFile("data");
+        if (file == null) {
+            ctx.status(400);
+            ctx.result("No file was sent (form field 'data')");
+            return;
+        }
+        try {
+            snapshotJson(ctx, org.photonvision.common.hardware.ThriftiestFirmware.upload(file.filename(), file.content()));
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result("Not stored: " + e.getMessage());
+        }
+    }
+
+    public static void onThriftiestFirmwareDeleteRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), ThriftiestFlashRequest.class);
