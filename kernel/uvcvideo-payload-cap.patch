+/*
+ * SpectrumJetson: cap the isochronous bandwidth specific cameras reserve.
+ * Some MJPEG cameras request the largest alternate setting in every mode
+ * (e.g. 1bcf:28c5, the Thriftiest Cam: 3 x 1020 bytes per microframe, about
+ * 196 Mbps) while sending a fraction of it, and every USB 2.0 port on a Jetson
+ * shares one budget, so only two fit. Capping dwMaxPayloadTransferSize makes
+ * the driver pick a smaller alternate setting. Entries, comma separated:
+ *   vid:pid:bytes   every camera of that model (ids in hex)
+ *   port:bytes      the camera on that USB port, e.g. 1-2.4:944 (wins over
+ *                   vid:pid; 0 means uncapped)
+ * Writable at run time (root): a change applies when a camera next starts
+ * streaming, e.g. when PhotonVision reconnects it.
+ */
+module_param_string(payload_cap, uvc_payload_cap_param, sizeof(uvc_payload_cap_param), 0644);
+MODULE_PARM_DESC(payload_cap, "Cap the max payload per interval: vid:pid:bytes or port:bytes, comma separated");
 
