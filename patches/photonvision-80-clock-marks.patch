+    /**
+     * photonvision-80: a log line pairing the Jetson's clocks, so tools can place any journal line
+     * (stamped on the kernel's monotonic clock) on jetson_us and the robot's clock. Every 60 s, and
+     * when the robot connects, disconnects or the time-sync offset moves by more than 1 ms.
+     */
+    private void clockMark(long nowUs, boolean connected) {
+        long offset = NetworkTablesManager.getInstance().getOffset();
+        if (nowUs - lastClockMarkUs < 60_000_000L
+                && connected == lastMarkConnected
+                && Math.abs(offset - lastMarkOffsetUs) <= 1000) return;
+        lastClockMarkUs = nowUs;
+        lastMarkOffsetUs = offset;
+        lastMarkConnected = connected;
+        logger.info(
+                String.format(
+                        "Clock mark: jetson_us=%d mono_us=%d unix_ms=%d robot_offset_us=%d nt=%d",
+                        nowUs,
+                        System.nanoTime() / 1000, // CLOCK_MONOTONIC, the journal's monotonic stamp
+                        System.currentTimeMillis(),
+                        offset,
+                        connected ? 1 : 0));
+    }
