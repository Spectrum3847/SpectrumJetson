+++ b/photon-client/src/components/settings/SnapshotsCard.vue
@@ -0,0 +1,192 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-53): named snapshots of every setting (cameras, pipelines,
+// calibrations, Robot state, Rewind), kept on the Jetson. Restoring saves the current settings
+// first ("Before restoring ..."), then restarts PhotonVision.
+import { computed, onMounted, ref, watch } from "vue";
+import axios from "axios";
+import { useStateStore } from "@/stores/StateStore";
+import { useTheme } from "vuetify";
+
+interface Snapshot {
+  id: string;
+  name: string;
+  reason: string;
+  createdAt: number;
+  version: string;
+  bytes: number;
+  cameras: { nickname: string; pipelines: string[] }[];
+}
+
+const theme = useTheme();
+const snapshots = ref<Snapshot[]>([]);
+const newName = ref("");
+const busy = ref(false);
+const confirmRestore = ref<Snapshot | null>(null);
+const confirmDelete = ref<Snapshot | null>(null);
+
+const load = async () => {
+  try {
+    snapshots.value = (await axios.get<Snapshot[]>("/snapshots")).data;
+  } catch {
+    snapshots.value = [];
+  }
+};
+onMounted(load);
+// After a restore PhotonVision restarts; reload the list (with its new "Before restoring" entry)
+// when this page reconnects.
+watch(
+  () => useStateStore().backendConnected,
+  (connected) => connected && load()
+);
+
+const say = (message: string, color = "success") => useStateStore().showSnackbarMessage({ message, color, timeout: 6000 });
+
+const save = async () => {
+  busy.value = true;
+  try {
+    const s = (await axios.post<Snapshot>("/snapshots", { name: newName.value })).data;
+    newName.value = "";
+    say(`Saved '${s.name}'`);
+    await load();
+  } catch (e: any) {
+    say(e?.response?.data || "Couldn't save the snapshot", "error");
+  } finally {
+    busy.value = false;
+  }
+};
+const restore = async (s: Snapshot) => {
+  confirmRestore.value = null;
+  busy.value = true;
+  try {
+    const before = (await axios.post<Snapshot>("/snapshots/restore", { id: s.id })).data;
+    say(`Restoring '${s.name}': PhotonVision is restarting. The settings before it are saved as '${before.name}'.`, "info");
+  } catch (e: any) {
+    say(e?.response?.data || "Couldn't restore", "error");
+  } finally {
+    busy.value = false;
+  }
+};
+const remove = async (s: Snapshot) => {
+  confirmDelete.value = null;
+  try {
+    snapshots.value = (await axios.post<Snapshot[]>("/snapshots/delete", { id: s.id })).data;
+    say(`Deleted '${s.name}'`);
+  } catch (e: any) {
+    say(e?.response?.data || "Couldn't delete", "error");
+  }
+};
+
+const when = (ms: number) => new Date(ms).toLocaleString();
+const reasonText: Record<string, string> = {
+  manual: "saved by hand",
+  "before restore": "automatic, before a restore",
+  "field connected": "automatic, field connected"
+};
+const summary = (s: Snapshot) =>
+  s.cameras.map((c) => `${c.nickname}: ${c.pipelines.map((p, i) => `${i}: ${p}`).join(", ")}`).join("; ");
+const nameOk = computed(() => /^[\w .()-]{0,60}$/.test(newName.value));
+</script>
+
+<template>
+  <v-card class="mb-3 rounded-12" color="surface">
+    <v-card-title class="pb-10px">Settings snapshots</v-card-title>
+    <v-card-text class="pt-0">
+      <p class="pb-2 text-body-2">
+        Every camera, pipeline and calibration, plus Robot state and Rewind, saved on the Jetson under a name. Save one
+        before an event and after tuning; restoring one brings every camera back to it. PhotonVision also saves one the
+        first time the field connects each day.
+      </p>
+      <div class="d-flex align-center ga-2 pb-3">
+        <v-text-field
+          v-model="newName"
+          data-testid="snapshot-name"
+          label="Name (e.g. Before Houston, tuned exposure)"
+          density="compact"
+          variant="underlined"
+          hide-details="auto"
+          :error-messages="nameOk ? [] : ['Letters, numbers, spaces and . ( ) - _ only']"
+          @keydown.enter="nameOk && !busy && save()"
+        />
+        <v-btn color="buttonActive" variant="tonal" :disabled="busy || !nameOk" data-testid="snapshot-save" @click="save">
+          Save snapshot
+        </v-btn>
+      </div>
+      <v-table v-if="snapshots.length" density="compact" data-testid="snapshot-table">
+        <thead>
+          <tr>
+            <th>Name</th>
+            <th>Saved</th>
+            <th>Cameras and pipelines</th>
+            <th></th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr v-for="s in snapshots" :key="s.id" :data-testid="`snapshot-${s.id}`">
+            <td>
+              <b>{{ s.name }}</b>
+              <div class="text-caption">{{ reasonText[s.reason] ?? s.reason }}</div>
+            </td>
+            <td class="text-no-wrap">{{ when(s.createdAt) }}</td>
+            <td class="text-caption">{{ summary(s) }}</td>
+            <td class="text-no-wrap">
+              <v-btn size="small" variant="text" :href="`/api/snapshots/download?id=${s.id}`" icon="mdi-download" />
+              <v-btn
+                size="small"
+                variant="text"
+                color="warning"
+                :disabled="busy"
+                icon="mdi-backup-restore"
+                data-testid="snapshot-restore"
+                @click="confirmRestore = s"
+              />
+              <v-btn
+                size="small"
+                variant="text"
+                color="error"
+                icon="mdi-delete"
+                data-testid="snapshot-delete"
+                @click="confirmDelete = s"
+              />
+            </td>
+          </tr>
+        </tbody>
+      </v-table>
+      <p v-else class="text-caption">No snapshots yet.</p>
+    </v-card-text>
+
+    <v-dialog :model-value="!!confirmRestore" width="520" @update:model-value="(v) => !v && (confirmRestore = null)">
+      <v-card v-if="confirmRestore" color="surface">
+        <v-card-title>Restore '{{ confirmRestore.name }}'?</v-card-title>
+        <v-card-text>
+          Every camera's pipelines, settings and calibrations go back to {{ when(confirmRestore.createdAt) }}, and
+          PhotonVision restarts (cameras are back in about 20 s). The current settings are saved first as a snapshot, so
+          this can be undone.
+        </v-card-text>
+        <v-card-actions>
+          <v-spacer />
+          <v-btn :variant="theme.global.current.value.dark ? 'outlined' : 'elevated'" @click="confirmRestore = null">
+            Cancel
+          </v-btn>
+          <v-btn
+            color="warning"
+            :variant="theme.global.current.value.dark ? 'outlined' : 'elevated'"
+            data-testid="snapshot-restore-confirm"
+            @click="restore(confirmRestore)"
+          >
+            Restore and restart
+          </v-btn>
+        </v-card-actions>
+      </v-card>
+    </v-dialog>
+    <v-dialog :model-value="!!confirmDelete" width="440" @update:model-value="(v) => !v && (confirmDelete = null)">
+      <v-card v-if="confirmDelete" color="surface">
+        <v-card-title>Delete '{{ confirmDelete.name }}'?</v-card-title>
+        <v-card-actions>
+          <v-spacer />
+          <v-btn @click="confirmDelete = null">Cancel</v-btn>
+          <v-btn color="error" data-testid="snapshot-delete-confirm" @click="remove(confirmDelete)">Delete</v-btn>
+        </v-card-actions>
+      </v-card>
+    </v-dialog>
+  </v-card>
+</template>
diff --git a/photon-client/src/lib/FieldElements.ts b/photon-client/src/lib/FieldElements.ts
new file mode 100644
index 00000000..733d924d
--- /dev/null
+++ b/photon-client/src/lib/FieldElements.ts
@@ -0,0 +1,223 @@
+// SpectrumJetson (photonvision-30): simplified 3D field elements, like Limelight's field view.
+// Each element is placed by the tags mounted on it, not by fixed coordinates: the same code draws
+// the AndyMark and welded fields, and after a field calibration the elements sit where their tags
+// really are (a misplaced hub shows up misplaced). Dimensions: the 2026 game manual (arena section).
+import type * as ThreeNS from "three";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+
+type Three = typeof ThreeNS;
+type TagPose = { x: number; y: number; z: number; yaw: number };
+
+export type FieldGame = { id: string; name: string };
+export const FIELD_GAMES: FieldGame[] = [
+  { id: "2026cad", name: "2026 REBUILT: FIRST's field CAD" },
+  { id: "2026", name: "2026 REBUILT: simple shapes" },
+  { id: "none", name: "Tags and walls only" }
+];
+
+/** Which game a layout is for, from its size and tags. */
+export const detectGame = (layout: AprilTagFieldLayout): string =>
+  layout.tags.length === 32 && Math.abs(layout.field.length - 16.54) < 0.1 && Math.abs(layout.field.width - 8.05) < 0.1
+    ? "2026cad"
+    : "none";
+
+/** The CAD model for a game, if there is one (served from PhotonVision's web root). */
+export const fieldModelUrl = (game: string): string | null =>
+  game === "2026cad" ? "fieldmodels/2026-rebuilt.glb" : null;
+
+const IN = 0.0254;
+const BLUE = 0x1e63d6;
+const RED = 0xd63a2f;
+const GREY = 0x9aa0a6;
+
+// 2026 REBUILT: which tags sit on which element (blue, red).
+const REBUILT = {
+  hubs: [
+    [18, 19, 20, 21, 24, 25, 26, 27],
+    [2, 3, 4, 5, 8, 9, 10, 11]
+  ],
+  trenches: [
+    [17, 28],
+    [22, 23],
+    [1, 12],
+    [6, 7]
+  ],
+  outposts: [
+    [29, 30],
+    [13, 14]
+  ],
+  towers: [
+    [31, 32],
+    [15, 16]
+  ]
+};
+const HUB = { size: 47 * IN, height: 72 * IN };
+const TRENCH = {
+  width: 65.65 * IN,
+  depth: 47.0 * IN,
+  height: 40.25 * IN,
+  openWidth: 50.34 * IN,
+  openHeight: 22.25 * IN
+};
+const BUMP = { depth: 44.4 * IN, height: 6.513 * IN };
+const TOWER = { width: 49.25 * IN, depth: 45.0 * IN, height: 78.25 * IN, upright: 72.1 * IN, spacing: 32.25 * IN };
+const RUNGS = [27.0 * IN, 45.0 * IN, 63.0 * IN];
+const GUARDRAIL = 20.0 * IN;
+const WALL = 78 * IN; // driver station wall with its transparent panel
+
+export const yawOf = (q: { W: number; X: number; Y: number; Z: number }) =>
+  Math.atan2(2 * (q.W * q.Z + q.X * q.Y), 1 - 2 * (q.Y * q.Y + q.Z * q.Z));
+
+/** The field, walls and elements for a layout; tags are drawn by the caller. */
+export function buildField(T: Three, layout: AprilTagFieldLayout, game: string): ThreeNS.Group {
+  const g = new T.Group();
+  const L = layout.field.length,
+    W = layout.field.width;
+  const mat = (color: number, opacity = 1) =>
+    new T.MeshLambertMaterial({ color, transparent: opacity < 1, opacity, side: T.DoubleSide });
+  const box = (
+    sx: number,
+    sy: number,
+    sz: number,
+    x: number,
+    y: number,
+    z: number,
+    yaw: number,
+    m: ThreeNS.Material
+  ) => {
+    const b = new T.Mesh(new T.BoxGeometry(sx, sy, sz), m);
+    b.position.set(x, y, z);
+    b.rotation.z = yaw;
+    g.add(b);
+    return b;
+  };
+
+  // Carpet, alliance zones and centre line.
+  const carpet = new T.Mesh(new T.PlaneGeometry(L, W), mat(0x5a5f63));
+  carpet.position.set(L / 2, W / 2, 0);
+  g.add(carpet);
+  const line = (x: number, color: number) => {
+    const l = new T.Mesh(new T.PlaneGeometry(0.05, W), mat(color));
+    l.position.set(x, W / 2, 0.002);
+    g.add(l);
+  };
+  line(L / 2, 0xffffff);
+  // Guardrails and alliance walls (translucent so the field stays visible).
+  box(L, 0.05, GUARDRAIL, L / 2, -0.025, GUARDRAIL / 2, 0, mat(GREY, 0.35));
+  box(L, 0.05, GUARDRAIL, L / 2, W + 0.025, GUARDRAIL / 2, 0, mat(GREY, 0.35));
+  // Alliance walls: faint, with their edges drawn, so the view through them stays clear.
+  for (const [x, c] of [
+    [-0.025, BLUE],
+    [L + 0.025, RED]
+  ]) {
+    const w = box(0.05, W, WALL, x, W / 2, WALL / 2, 0, mat(c, 0.08));
+    w.add(new T.LineSegments(new T.EdgesGeometry(w.geometry), new T.LineBasicMaterial({ color: c })));
+  }
+
+  if (game !== "2026") return g;
+
+  const tags = new Map<number, TagPose>();
+  for (const t of layout.tags) {
+    tags.set(t.ID, {
+      x: t.pose.translation.x,
+      y: t.pose.translation.y,
+      z: t.pose.translation.z,
+      yaw: yawOf(t.pose.rotation.quaternion)
+    });
+  }
+  const group = (ids: number[]) => ids.map((i) => tags.get(i)).filter((t): t is TagPose => !!t);
+  const mean = (ts: TagPose[]) => ({
+    x: ts.reduce((a, t) => a + t.x, 0) / ts.length,
+    y: ts.reduce((a, t) => a + t.y, 0) / ts.length
+  });
+  const colour = (x: number) => (x < L / 2 ? BLUE : RED);
+
+  // HUBs: a 47 in square, 72 in tall, centred on its tags, square to them.
+  const hubs: { x: number; y: number }[] = [];
+  for (const ids of REBUILT.hubs) {
+    const ts = group(ids);
+    if (ts.length < 3) continue;
+    const c = mean(ts);
+    hubs.push(c);
+    box(HUB.size, HUB.size, HUB.height, c.x, c.y, HUB.height / 2, ts[0].yaw, mat(colour(c.x), 0.55));
+    // the hexagonal opening at the top, as a dark ring
+    const ring = new T.Mesh(new T.CylinderGeometry(0.53, 0.53, 0.04, 6, 1, true), mat(0x222222));
+    ring.rotation.x = Math.PI / 2;
+    ring.position.set(c.x, c.y, HUB.height);
+    g.add(ring);
+  }
+
+  // TRENCHes: against the guardrail, a slab on two legs over a 22.25 in tall tunnel.
+  for (const ids of REBUILT.trenches) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const nearZero = c.y < W / 2;
+    const y0 = nearZero ? 0 : W - TRENCH.width;
+    const yc = y0 + TRENCH.width / 2;
+    const m = mat(colour(c.x), 0.6);
+    const slab = TRENCH.height - TRENCH.openHeight;
+    box(TRENCH.depth, TRENCH.width, slab, c.x, yc, TRENCH.openHeight + slab / 2, 0, m);
+    const leg = (TRENCH.width - TRENCH.openWidth) / 2;
+    box(TRENCH.depth, leg, TRENCH.openHeight, c.x, y0 + leg / 2, TRENCH.openHeight / 2, 0, m);
+    box(TRENCH.depth, leg, TRENCH.openHeight, c.x, y0 + TRENCH.width - leg / 2, TRENCH.openHeight / 2, 0, m);
+  }
+
+  // BUMPs: 15-degree ramps either side of each hub, out to the trenches.
+  for (const h of hubs) {
+    for (const [a, b] of [
+      [TRENCH.width, h.y - HUB.size / 2],
+      [h.y + HUB.size / 2, W - TRENCH.width]
+    ]) {
+      if (b - a < 0.2) continue;
+      const shape = new T.Shape();
+      shape.moveTo(-BUMP.depth / 2, 0);
+      shape.lineTo(0, BUMP.height);
+      shape.lineTo(BUMP.depth / 2, 0);
+      shape.lineTo(-BUMP.depth / 2, 0);
+      const geo = new T.ExtrudeGeometry(shape, { depth: b - a, bevelEnabled: false });
+      const bump = new T.Mesh(geo, mat(colour(h.x), 0.8));
+      // shape x -> field x, shape y -> up, extrusion -> field y
+      bump.rotation.x = Math.PI / 2;
+      bump.position.set(h.x, b, 0);
+      g.add(bump);
+    }
+  }
+
+  // TOWERs: on the alliance wall at its tags, a base, two uprights and three rungs.
+  for (const ids of REBUILT.towers) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const dir = Math.cos(ts[0].yaw) >= 0 ? 1 : -1; // into the field
+    const m = mat(colour(c.x), 0.85);
+    const xMid = c.x + (dir * TOWER.depth) / 2;
+    box(TOWER.depth, TOWER.width, 0.04, xMid, c.y, 0.02, 0, m);
+    box(0.05, TOWER.width, TOWER.height, c.x + dir * 0.03, c.y, TOWER.height / 2, 0, mat(colour(c.x), 0.3));
+    for (const s of [-1, 1])
+      box(0.06, 0.06, TOWER.upright, xMid, c.y + (s * TOWER.spacing) / 2, TOWER.upright / 2, 0, m);
+    for (const z of RUNGS) {
+      const rung = new T.Mesh(new T.CylinderGeometry(0.03, 0.03, TOWER.spacing, 12), mat(0xdddddd));
+      rung.position.set(xMid, c.y, z);
+      g.add(rung);
+    }
+  }
+
+  // OUTPOSTs: a panel in the alliance wall at its tags, with the low corral in front.
+  for (const ids of REBUILT.outposts) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const dir = Math.cos(ts[0].yaw) >= 0 ? 1 : -1;
+    box(0.12, 1.1, 1.2, c.x + dir * 0.06, c.y, 0.6, 0, mat(colour(c.x), 0.5));
+    const cw = 35.8 * IN,
+      cd = 37.6 * IN,
+      ch = 8.13 * IN;
+    const m = mat(colour(c.x), 0.7);
+    const x0 = c.x + dir * 0.12;
+    box(cd, 0.03, ch, x0 + (dir * cd) / 2, c.y - cw / 2, ch / 2, 0, m);
+    box(cd, 0.03, ch, x0 + (dir * cd) / 2, c.y + cw / 2, ch / 2, 0, m);
+    box(0.03, cw, ch, x0 + dir * cd, c.y, ch / 2, 0, m);
+  }
+  return g;
+}
