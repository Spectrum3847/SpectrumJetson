# Upstream versions we have read but do not build, so nothing else in the repo pins them.
# scripts/ci/upstream_watch.py reports commits after these; move them forward once reviewed.

# RealtimeRoboticsGroup/aos: where Austin Schuh develops the CUDA detector now (frc/orin) and the
# localizer (frc/vision). We build the detector from frc971/bos. Last read 2026-10-01: the NVJPEG
# fix (5f52ccc23) stays one frame behind, ours does not; the rest is ABSL_* macro renames.
AOS_REVIEWED=443830cf4

# PhotonVision next-season releases already read. v2027.0.0-alpha-2 is the robot's PhotonLib; the
# Jetson moves to 2027 through the alpha-7 port. Same-season prereleases (v2026.7, April Fools) are skipped.
PV_NEXT_REVIEWED=v2027.0.0-alpha-2

# allwpilib tags already read. The detector's allwpilib must match the PhotonVision fork's
# wpilibVersion (2026.2.1). v2026.2.2 changes no wpiutil or apriltag code, and in wpimath only
# PoseEstimator and SlewRateLimiter, which the detector doesn't use.
ALLWPILIB_REVIEWED=v2026.2.2
