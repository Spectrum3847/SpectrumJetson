+        s.cameraBrightness = BRIGHTNESS;
+        s.cameraAutoWhiteBalance = AUTO_WHITE_BALANCE;
+        s.cameraWhiteBalanceTemp = WHITE_BALANCE_TEMP;
+        s.blockForFrames = LOW_LATENCY_MODE;
+        s.streamingFrameDivisor = STREAM_DIVISOR;
