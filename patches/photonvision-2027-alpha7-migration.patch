+    public static native void setparams(
+            long handle,
+            double fx,
+            double cx,
+            double fy,
+            double cy,
+            double k1,
+            double k2,
+            double p1,
+            double p2,
+            double k3);
+
+    public static native AprilTagDetection[] processimage(long handle, long pointer);
+
+    /**
+     * SpectrumJetson (photonvision-40, bos-07): the detection mask. mode 0 off, 1 ignore inside
+     * the boxes, 2 search only inside them; boxes: x, y, w, h fractions of the image, 4 per box.
+     */
+    public static native void setMask(long handle, int mode, double[] boxes);
+
+    /**
+     * Decodes an MJPEG RawFrame straight into an 8-bit grayscale OpenCV Mat.
+     *
+     * @return 0 on success, -1 for a non-MJPEG frame, -2 for a bad frame, -3 for the wrong Mat
+     */
+    public static native int decodeMjpegGray(long rawFramePtr, long cvMatPtr);
+
+    /** Returns true when PhotonVision should use the Jetson's hardware MJPEG decoder. */
+    public static native boolean hardwareJpegDecode();
+
+    /**
+     * Decodes an MJPEG RawFrame straight into an 8-bit BGR OpenCV Mat.
+     *
+     * @return 0 on success, -1 for a non-MJPEG frame, -2 for a bad frame, -3 for the wrong Mat
+     */
+    public static native int decodeMjpegBgr(long rawFramePtr, long cvMatPtr);
+
+    /** Sets all eight coefficients of PhotonVision's OpenCV rational calibration model. */
+    public static native void setparams8(
+            long handle,
+            double fx,
+            double cx,
+            double fy,
+            double cy,
+            double k1,
+            double k2,
+            double p1,
+            double p2,
+            double k3,
+            double k4,
+            double k5,
+            double k6);
