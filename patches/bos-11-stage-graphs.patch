+// SpectrumJetson (bos-11): the pieces that let the stages after the first run as CUDA graphs.
+// A graph's sizes are fixed, so each step runs over a size bucket (StageBucket) at least as large
+// as the real count, which stays on the GPU. The entries past the real count are made harmless:
+// sort keys that sort after every real one (a stable radix sort then leaves the real entries
+// exactly where they were), and filters that drop them. Every output for the real entries is the
+// same as the one-by-one path's (the scans and reductions are integer, and each output depends
+// only on the entries before it).
+bool SpectrumStageGraphs() {
+  static const bool on = [] {
+    const char* v = std::getenv("SPECTRUM_971_GRAPHS");
+    return !(v && std::string(v) == "0");
+  }();
+  static SpectrumKnob knob("/tmp/spectrum-971-graphs", 1);
+  return on && knob.Get() != 0;
+}
+
+// The smallest bucket >= n, from 1024 up in steps of about 25% (multiples of 256), at most cap.
+size_t StageBucket(size_t n, size_t cap) {
+  size_t b = 1024;
+  while (b < n) b = (b + b / 4 + 255) & ~static_cast<size_t>(255);
+  return std::min(b, cap);
+}
+
+// Fills p[*count, bucket) with pad (keys that sort after every real key).
+template <typename T>
+__global__ void PadTail(T* p, const int* count, size_t bucket, T pad) {
+  const size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+  if (i < bucket && i >= static_cast<size_t>(*count)) p[i] = pad;
+}
+template <typename T>
+void LaunchPadTail(T* p, const int* count, size_t bucket, T pad, cudaStream_t stream) {
+  PadTail<<<(bucket + 255) / 256, 256, 0, stream>>>(p, count, bucket, pad);
+}
+
+// A reduce-by-key over a padded bucket finds one extra run (the pad keys) when there was padding.
+template <typename C>
+__global__ void DropPadRun(C* runs, const int* count, size_t bucket) {
+  if (static_cast<size_t>(*count) < bucket) --*runs;
+}
+
+// num_quads as an int, and 0 when there are more than the buffers hold (the host then skips the
+// frame, as the one-by-one path does before it uses them).
+__global__ void QuadsToInt(const size_t* num_quads, int* out, size_t max_quads) {
+  *out = *num_quads > max_quads ? 0 : static_cast<int>(*num_quads);
+}
+
+constexpr uint64_t kPadKey = ~uint64_t{0};
+
+// RewriteToIndexPoint with the counts on the GPU: points past the real count become kPadKey.
+// A real IndexPoint here has no angle yet (bits 24-51 zero), so it is never kPadKey.
+class RewriteToIndexPointDevice {
+ public:
+  RewriteToIndexPointDevice(MinMaxExtents* extents_device, const int* num_extents_device,
+                            const int* num_points_device)
+      : extents_device_(extents_device),
+        num_extents_device_(num_extents_device),
+        num_points_device_(num_points_device) {}
+
+  __host__ __device__ __forceinline__ IndexPoint
+  operator()(cub::KeyValuePair<long, QuadBoundaryPoint> pt) const {
+    IndexPoint result;
+    if (pt.key >= *num_points_device_ || *num_extents_device_ == 0) {
+      result.key = kPadKey;
+      return result;
+    }
+    // BlobExtentsIndexFinder::FindBlobIndex (its constructor is host-only).
+    const apriltag_size_t num_extents = *num_extents_device_;
+    const apriltag_size_t point_index = pt.key;
+    apriltag_size_t min = 0;
+    apriltag_size_t max = num_extents;
+    while (min + 1 != max) {
+      const apriltag_size_t average = min + (max - min) / 2;
+      if (average < num_extents && extents_device_[average].starting_offset <= point_index) {
+        min = average;
+      } else {
+        max = average;
+      }
+    }
+    return IndexPoint(min, pt.value.point_bits());
+  }
+
+ private:
+  MinMaxExtents* extents_device_;
+  const int* num_extents_device_;
+  const int* num_points_device_;
+};
+
+class NonzeroBlobsDevice {
+ public:
+  NonzeroBlobsDevice(const cub::KeyValuePair<long, MinMaxExtents>* extents_device)
+      : extents_device_(extents_device) {}
+
+  __host__ __device__ __forceinline__ bool operator()(const IndexPoint& a) const {
+    return a.key != kPadKey && extents_device_[a.blob_index()].value.count > 0;
+  }
+
+ private:
+  const cub::KeyValuePair<long, MinMaxExtents>* extents_device_;
+};
+
+// The line-fit peaks, with the ones past the real point count read as "no peak".
+struct PeakOrNone {
+  const Peak* peaks;
+  const int* count;
+  __host__ __device__ __forceinline__ Peak operator()(int i) const {
+    if (i < *count) return peaks[i];
+    Peak p;
+    p.error = 0;
+    p.filtered_point_index = 0;
+    p.blob_index = Peak::kNoPeak();
+    return p;
+  }
+};
+
+// The blob extents' inclusive scan (SumPoints over TransformZeroFilteredBlobSizes) for the stage 2
+// graph: one block over the real number of quads (on the GPU), where cub::DeviceScan had to run
+// over the whole size bucket (up to kMaxBlobs, 36 us a frame instead of 7). Integer and
+// associative, so any order of combining gives the same values as CUB's scan.
+struct ScanPrefix {
+  cub::KeyValuePair<long, MinMaxExtents> running;
+  __device__ cub::KeyValuePair<long, MinMaxExtents> operator()(
+      const cub::KeyValuePair<long, MinMaxExtents>& block_aggregate) {
+    const cub::KeyValuePair<long, MinMaxExtents> old = running;
+    running = SumPoints()(running, block_aggregate);
+    return old;
+  }
+};
+
+__device__ __forceinline__ cub::KeyValuePair<long, MinMaxExtents> ScanIdentity() {
+  // SumPoints(identity, b) == b in every field SumPoints sets.
+  cub::KeyValuePair<long, MinMaxExtents> id;
+  id.key = -1;
+  id.value = MinMaxExtents{};
+  return id;
+}
+
+constexpr int kScanThreads = 1024;
+__global__ void ScanSelectedExtents(const MinMaxExtents* extents, const int* count,
+                                    TransformZeroFilteredBlobSizes rewrite,
+                                    cub::KeyValuePair<long, MinMaxExtents>* out) {
+  using BlockScan = cub::BlockScan<cub::KeyValuePair<long, MinMaxExtents>, kScanThreads>;
+  __shared__ typename BlockScan::TempStorage temp;
+  const int n = *count;
+  ScanPrefix prefix{ScanIdentity()};
+  for (int base = 0; base < n; base += kScanThreads) {
+    const int i = base + threadIdx.x;
+    cub::KeyValuePair<long, MinMaxExtents> v = ScanIdentity();
+    if (i < n) v = rewrite(cub::KeyValuePair<long, MinMaxExtents>(i, extents[i]));
+    BlockScan(temp).InclusiveScan(v, v, SumPoints(), prefix);
+    if (i < n) out[i] = v;
+    __syncthreads();
+  }
+}
+
+// A recorded graph's memset and small memcpy nodes, as kernels. On this GPU each memset or copy
+// node costs 3-8 us of CPU in cudaGraphLaunch (it goes to a different engine) and a kernel node
+// almost nothing; the stage graphs have ~10 of them (CUB's own memsets, the counts' copies back).
+// A contiguous memset of `bytes` bytes with the 32-bit pattern p32 (the value repeated, as seen
+// from dst): 16-byte stores in the aligned middle.
+__global__ void GraphFillContiguous(char* dst, size_t bytes, uint32_t p32) {
+  const size_t head = std::min<size_t>(bytes, (16 - reinterpret_cast<uintptr_t>(dst) % 16) % 16);
+  const size_t vectors = (bytes - head) / 16;
+  const size_t tail_start = head + vectors * 16;
+  // The pattern as seen from the first aligned byte.
+  const unsigned rot = 8 * (head % 4);
+  const uint32_t w = rot ? (p32 >> rot) | (p32 << (32 - rot)) : p32;
+  const uint4 v = make_uint4(w, w, w, w);
+  uint4* mid = reinterpret_cast<uint4*>(dst + head);
+  const size_t stride = static_cast<size_t>(blockDim.x) * gridDim.x;
+  const size_t t = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+  for (size_t i = t; i < vectors; i += stride) mid[i] = v;
+  if (t < 16) {
+    if (t < head) dst[t] = static_cast<char>(p32 >> (8 * (t % 4)));
+    const size_t j = tail_start + t;
+    if (j < bytes) dst[j] = static_cast<char>(p32 >> (8 * (j % 4)));
+  }
+}
+
+__global__ void GraphFill(char* dst, size_t pitch, unsigned value, unsigned element_size,
+                          size_t width, size_t height) {
+  const size_t total = width * height;
+  for (size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x; i < total;
+       i += static_cast<size_t>(blockDim.x) * gridDim.x) {
+    char* p = dst + (i / width) * pitch + (i % width) * element_size;
+    if (element_size == 1) {
+      *reinterpret_cast<uint8_t*>(p) = static_cast<uint8_t>(value);
+    } else if (element_size == 2) {
+      *reinterpret_cast<uint16_t*>(p) = static_cast<uint16_t>(value);
+    } else {
+      *reinterpret_cast<uint32_t*>(p) = value;
+    }
+  }
+}
+
+static_assert(sizeof(FitQuad) % sizeof(uint32_t) == 0);
+// Copies min(*count, max_count) records of words_per_record 32-bit words.
+__global__ void CopyCounted(uint32_t* dst, const uint32_t* src, const int* count,
+                            size_t words_per_record, size_t max_count) {
+  const size_t n = std::min<size_t>(static_cast<size_t>(std::max(*count, 0)), max_count);
+  const size_t words = n * words_per_record;
+  for (size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x; i < words;
+       i += static_cast<size_t>(blockDim.x) * gridDim.x) {
+    dst[i] = src[i];
+  }
+}
+
+__global__ void GraphCopy(char* dst, const char* src, size_t bytes) {
+  for (size_t i = threadIdx.x; i < bytes; i += blockDim.x) dst[i] = src[i];
+}
+
+// The device address of p (pinned host memory has one; device memory is its own).
+void* DeviceAddress(void* p) {
+  cudaPointerAttributes a{};
+  if (cudaPointerGetAttributes(&a, p) != cudaSuccess) {
+    cudaGetLastError();
+    return nullptr;
+  }
+  if (a.type == cudaMemoryTypeDevice || a.type == cudaMemoryTypeManaged) return p;
+  if (a.type == cudaMemoryTypeHost) return a.devicePointer;
+  return nullptr;
+}
+
+// Replaces node with a kernel node (same dependencies both ways). False on any failure.
+bool ReplaceWithKernel(cudaGraph_t graph, cudaGraphNode_t node, cudaKernelNodeParams* params) {
+  size_t n_deps = 0, n_dependents = 0;
+  if (cudaGraphNodeGetDependencies(node, nullptr, nullptr, &n_deps) != cudaSuccess ||
+      cudaGraphNodeGetDependentNodes(node, nullptr, nullptr, &n_dependents) != cudaSuccess) {
+    return false;
+  }
+  std::vector<cudaGraphNode_t> deps(n_deps), dependents(n_dependents);
+  if ((n_deps && cudaGraphNodeGetDependencies(node, deps.data(), nullptr, &n_deps) != cudaSuccess) ||
+      (n_dependents && cudaGraphNodeGetDependentNodes(node, dependents.data(), nullptr,
+                                                      &n_dependents) != cudaSuccess)) {
+    return false;
+  }
+  cudaGraphNode_t kernel = nullptr;
+  if (cudaGraphAddKernelNode(&kernel, graph, deps.data(), n_deps, params) != cudaSuccess) {
+    return false;
+  }
+  for (cudaGraphNode_t d : dependents) {
+    if (cudaGraphAddDependencies(graph, &kernel, &d, nullptr, 1) != cudaSuccess) return false;
+  }
+  return cudaGraphDestroyNode(node) == cudaSuccess;
+}
+
+// The pass. Returns false if the graph may be broken (don't use it).
+bool CopiesAsKernels(cudaGraph_t graph) {
+  size_t n = 0;
+  if (cudaGraphGetNodes(graph, nullptr, &n) != cudaSuccess) return false;
+  std::vector<cudaGraphNode_t> nodes(n);
+  if (n && cudaGraphGetNodes(graph, nodes.data(), &n) != cudaSuccess) return false;
+  for (cudaGraphNode_t node : nodes) {
+    cudaGraphNodeType type;
+    if (cudaGraphNodeGetType(node, &type) != cudaSuccess) return false;
+    if (type == cudaGraphNodeTypeMemset) {
+      cudaMemsetParams m{};
+      if (cudaGraphMemsetNodeGetParams(node, &m) != cudaSuccess) return false;
+      if (m.elementSize != 1 && m.elementSize != 2 && m.elementSize != 4) continue;
+      char* dst = static_cast<char*>(DeviceAddress(m.dst));
+      if (!dst) continue;
+      size_t pitch = m.height > 1 ? m.pitch : m.width * m.elementSize;
+      unsigned value = m.value, element_size = m.elementSize;
+      size_t width = m.width, height = m.height ? m.height : 1;
+      cudaKernelNodeParams k{};
+      k.blockDim = dim3(256, 1, 1);
+      if (height == 1 || pitch == width * element_size) {
+        // Contiguous: a 32-bit pattern (dst is aligned to the element size).
+        size_t bytes = width * height * element_size;
+        uint32_t p32 = element_size == 1   ? (value & 0xff) * 0x01010101u
+                       : element_size == 2 ? (value & 0xffff) * 0x00010001u
+                                           : value;
+        void* args[] = {&dst, &bytes, &p32};
+        k.func = reinterpret_cast<void*>(GraphFillContiguous);
+        k.gridDim = dim3(static_cast<unsigned>(
+            std::max<size_t>(1, std::min<size_t>(512, (bytes / 16 + 255) / 256))), 1, 1);
+        k.kernelParams = args;
+        if (!ReplaceWithKernel(graph, node, &k)) return false;
+        continue;
+      }
+      void* args[] = {&dst, &pitch, &value, &element_size, &width, &height};
+      k.func = reinterpret_cast<void*>(GraphFill);
+      k.gridDim = dim3(static_cast<unsigned>(
+          std::max<size_t>(1, std::min<size_t>(1024, (width * height + 255) / 256))), 1, 1);
+      k.kernelParams = args;
+      if (!ReplaceWithKernel(graph, node, &k)) return false;
+    } else if (type == cudaGraphNodeTypeMemcpy) {
+      cudaMemcpy3DParms c{};
+      if (cudaGraphMemcpyNodeGetParams(node, &c) != cudaSuccess) return false;
+      if (c.srcArray || c.dstArray || c.extent.height != 1 || c.extent.depth != 1 ||
+          c.srcPos.x || c.srcPos.y || c.srcPos.z || c.dstPos.x || c.dstPos.y || c.dstPos.z ||
+          c.extent.width > 4096) {
+        continue;
+      }
+      char* dst = static_cast<char*>(DeviceAddress(c.dstPtr.ptr));
+      char* src = static_cast<char*>(DeviceAddress(c.srcPtr.ptr));
+      if (!dst || !src) continue;
+      size_t bytes = c.extent.width;
+      void* args[] = {&dst, &src, &bytes};
+      cudaKernelNodeParams k{};
+      k.func = reinterpret_cast<void*>(GraphCopy);
+      k.blockDim = dim3(32, 1, 1);
+      k.gridDim = dim3(1, 1, 1);
+      k.kernelParams = args;
+      if (!ReplaceWithKernel(graph, node, &k)) return false;
+    }
+  }
+  return true;
+}
