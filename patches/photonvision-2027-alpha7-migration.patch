@@ -0,0 +1,65 @@
+// SpectrumJetson (photonvision-30): the real field CAD in the 3D view. The model is built from
+// FIRST's official field STEP by tools/fieldmodel in the SpectrumJetson repo and served from
+// fieldmodels/. Each element's node is named "kind@tag,tag,...#..." and holds only that element's
+// placement: here it's moved to where those tags are in the layout in use, so the model fits the
+// AndyMark and welded layouts, and a calibrated layout moves each element to where it really is.
+// The perimeter's four sides follow the layout's field size; the carpet ("carpet@") stays put.
+import type * as ThreeNS from "three";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+import { yawOf } from "@/lib/FieldElements";
+
+type Three = typeof ThreeNS;
+
+const cache = new Map<string, Promise<ThreeNS.Group | null>>();
+
+/** The model for a game, or null if it can't be loaded (the caller falls back to simple shapes). */
+export function loadFieldModel(T: Three, url: string): Promise<ThreeNS.Group | null> {
+  let p = cache.get(url);
+  if (!p) {
+    p = (async () => {
+      try {
+        const { GLTFLoader } = await import("three/examples/jsm/loaders/GLTFLoader");
+        const { MeshoptDecoder } = await import("three/examples/jsm/libs/meshopt_decoder.module");
+        const loader = new GLTFLoader();
+        loader.setMeshoptDecoder(MeshoptDecoder);
+        const gltf = await loader.loadAsync(url);
+        return gltf.scene as unknown as ThreeNS.Group;
+      } catch (e) {
+        console.warn("Field model " + url + " not loaded; using simple shapes", e);
+        return null;
+      }
+    })();
+    cache.set(url, p);
+  }
+  return p.then((g) => (g ? (g.clone(true) as ThreeNS.Group) : null));
+}
+
+/**
+ * Moves each element of the model to where its tags are in the layout, and each side of the
+ * perimeter to the layout's field edges (@x0, @xL, @y0, @yW), so it fits AndyMark and welded fields.
+ */
+export function anchorFieldModel(T: Three, model: ThreeNS.Object3D, layout: AprilTagFieldLayout) {
+  const tags = new Map(layout.tags.map((t) => [t.ID, t]));
+  const L = layout.field.length,
+    W = layout.field.width;
+  const edges: Record<string, [number, number]> = { x0: [0, 0], xL: [L, 0], y0: [0, 0], yW: [0, W] };
+  model.traverse((o) => {
+    const m = /^(\w+)@([\w,]*)#/.exec(o.name);
+    if (!m || !m[2]) return;
+    let x: number, y: number, yaw: number;
+    if (edges[m[2]]) {
+      [x, y] = edges[m[2]];
+      yaw = 0;
+    } else {
+      const ts = m[2].split(",").map((i) => tags.get(Number(i)));
+      if (ts.some((t) => !t)) return; // a tag the layout doesn't have: leave the element as drawn
+      x = ts.reduce((a, t) => a + t!.pose.translation.x, 0) / ts.length;
+      y = ts.reduce((a, t) => a + t!.pose.translation.y, 0) / ts.length;
+      yaw = yawOf(ts[0]!.pose.rotation.quaternion);
+    }
+    o.position.set(x, y, 0);
+    o.quaternion.setFromAxisAngle(new T.Vector3(0, 0, 1), yaw);
+    o.scale.set(1, 1, 1);
+    o.updateMatrix();
+  });
+}
