+    }
+
+    private volatile State state = State.IDLE;
+    private volatile String session = "";
+    private volatile String message = "";
+    private long recordStartNs = 0;
+
+    private final Map<String, CamLive> live = new TreeMap<>();
+    private long lastMotionNs = 0;
+    private long lastStillEvidenceNs = 0;
+    private Spot current = null;
+    private final List<Spot> spots = new ArrayList<>();
+    private final Map<Integer, Set<Integer>> tagSpots = new TreeMap<>(); // tag -> spots that saw it
+    private final Map<String, Integer> cameraSpots = new TreeMap<>();
