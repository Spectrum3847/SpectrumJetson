+                                      num_quad_peaked_quads_device_.get(),
+                                      sizeof(FitQuad) / sizeof(uint32_t), kMaxBlobs);
+  return absl::OkStatus();
+}
+
+bool GpuDetector::StageGraphsWanted() {
+  return !pending_stage_graphs_.empty() && SecondStageGraphs();
+}
+
+// The recorded graph for a stage (2 or 3) and size bucket, or nullptr (then noted for
+// RecordStageGraphs).
+cudaGraphExec_t GpuDetector::StageGraph(int stage, size_t points_bucket, size_t quads_bucket) {
+  const auto key = std::make_tuple(stage, points_bucket, quads_bucket);
+  if (auto it = stage_graphs_.find(key); it != stage_graphs_.end()) return it->second;
+  if (pending_stage_graphs_.size() < 64) pending_stage_graphs_.insert(key);
+  return nullptr;
+}
+
+absl::Status GpuDetector::RecordStageGraphs() {
+  // Buckets grow ~25% a step, so a detector needs a few dozen at most; this only bounds memory.
+  if (stage_graphs_.size() + pending_stage_graphs_.size() > 256) {
+    for (auto& [k, exec] : stage_graphs_) cudaGraphExecDestroy(exec);
+    stage_graphs_.clear();
+  }
+  for (const auto& [stage, points_bucket, quads_bucket] : pending_stage_graphs_) {
+    if (stage_graphs_failed_) break;
+    if (!RecordStageGraph(stage, points_bucket, quads_bucket)) {
+      pending_stage_graphs_.clear();
+      return absl::UnknownError("recording a stage graph failed; running those steps one by one");
+    }
+  }
+  pending_stage_graphs_.clear();
+  return absl::OkStatus();
+}
+
+// Records one stage graph; nullptr (and no more graphs for this detector) when that fails.
+cudaGraphExec_t GpuDetector::RecordStageGraph(int stage, size_t points_bucket,
+                                              size_t quads_bucket) {
+  const auto key = std::make_tuple(stage, points_bucket, quads_bucket);
+  if (auto it = stage_graphs_.find(key); it != stage_graphs_.end()) return it->second;
+  auto fail = [&](const std::string& what, cudaError_t e) -> cudaGraphExec_t {
+    cudaGetLastError();
+    LOG(WARNING) << "971 detector: recording the stage " << stage << " graph failed (" << what
+                 << ": " << cudaGetErrorString(e) << "); running the steps one by one";
+    stage_graphs_failed_ = true;
+    return nullptr;
+  };
+  if (!capture_stream_) {
+    cudaError_t e = cudaStreamCreateWithFlags(&capture_stream_, cudaStreamNonBlocking);
+    if (e != cudaSuccess) {
+      capture_stream_ = nullptr;
+      return fail("stream", e);
+    }
+  }
+  cudaError_t e = cudaStreamBeginCapture(capture_stream_, cudaStreamCaptureModeThreadLocal);
+  if (e != cudaSuccess) return fail("begin", e);
+  absl::Status status;
+  try {
+    status = stage == 2 ? EnqueueSecondStage(points_bucket, capture_stream_)
+                        : EnqueueThirdStage(points_bucket, quads_bucket, capture_stream_);
+  } catch (const std::exception& ex) {
+    status = absl::UnknownError(ex.what());
+  }
+  cudaGraph_t graph = nullptr;
+  e = cudaStreamEndCapture(capture_stream_, &graph);
+  if (!status.ok() || e != cudaSuccess || !graph) {
+    if (graph) cudaGraphDestroy(graph);
+    return fail(status.ok() ? "capture" : std::string(status.message()), e);
+  }
+  if (!CopiesAsKernels(graph)) {
+    cudaGraphDestroy(graph);
+    return fail("copies as kernels", cudaGetLastError());
+  }
+  cudaGraphExec_t exec = nullptr;
+  e = cudaGraphInstantiate(&exec, graph, 0);
+  cudaGraphDestroy(graph);
+  if (e != cudaSuccess) return fail("instantiate", e);
+  cudaGraphUpload(exec, stream_.get());  // now, not on its first launch
+  stage_graphs_[key] = exec;
+  return exec;
+}
+
+// Detect() after the first-stage graph, as two graphs. *done: nothing to detect (no candidate
+// points), detections cleared by the caller. Unavailable: a graph couldn't be recorded, and the
+// caller runs the steps one by one instead (they recompute everything a graph wrote).
+absl::Status GpuDetector::DetectGraphStages(int* num_selected_blobs, int* num_compressed_peaks,
+                                            int* num_quad_peaked_quads, bool* done) {
+  const size_t points_capacity = sorted_union_marker_pair_device_.size();
+  // The first-stage graph's point count.
+  CHECK_CUDA(cudaStreamSynchronize(stream_.get()));
+  const size_t n = static_cast<size_t>(*num_compressed_union_marker_pair_host_.get());
+  cudaGraphExec_t second = StageGraph(2, StageBucket(n, points_capacity), 0);
+  if (!second) return absl::UnavailableError("no stage 2 graph");
+  CHECK_CUDA(cudaGraphLaunch(second, stream_.get()));
+  CHECK_CUDA(cudaStreamSynchronize(stream_.get()));
+  if (*num_quads_host_.get() > kMaxBlobs) {
+    return absl::ResourceExhaustedError(
+        "more candidate quads (" + std::to_string(*num_quads_host_.get()) +
+        ") than the detector's buffers hold (" + std::to_string(kMaxBlobs) +
+        "): frame skipped");
+  }
+  *num_selected_blobs = stage_counts_host_.get()[0];
+  if (*num_selected_blobs == 0) {
+    *done = true;
+    return absl::OkStatus();
+  }
+  cudaGraphExec_t third =
+      StageGraph(3, StageBucket(static_cast<size_t>(*num_selected_blobs), points_capacity),
+                 StageBucket(*num_quads_host_.get(), kMaxBlobs));
+  if (!third) return absl::UnavailableError("no stage 3 graph");
+  CHECK_CUDA(cudaGraphLaunch(third, stream_.get()));
+  CHECK_CUDA(cudaStreamSynchronize(stream_.get()));
+  *num_quad_peaked_quads = stage_counts_host_.get()[1];
+  *num_compressed_peaks = -1;  // only for VLOG; stays on the GPU
+  return absl::OkStatus();
+}
