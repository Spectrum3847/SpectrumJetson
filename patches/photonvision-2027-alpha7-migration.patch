+ */
+
+package org.photonvision.vision.objects;
+
+import java.awt.Color;
+import java.lang.ref.Cleaner;
+import java.lang.ref.Cleaner.Cleanable;
+import java.util.ArrayList;
+import java.util.List;
+import org.opencv.core.Mat;
+import org.opencv.core.Rect2d;
+import org.opencv.core.Size;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+import org.photonvision.common.util.ColorHelper;
+import org.photonvision.jni.TensorRtJNI;
+import org.photonvision.vision.pipe.impl.NeuralNetworkPipeResult;
+
+/**
+ * SpectrumJetson: runs a YOLO TensorRT engine on the Jetson's GPU. The frame is letterboxed here
+ * (as the other backends do); the native side converts it to the network input on the GPU, runs
+ * the engine, and decodes raw ([1, 4+nc, N], NMS here) or end-to-end ([1, K, 6]) outputs.
+ */
+public class TensorRtObjectDetector implements ObjectDetector {
+    private static final Logger logger = new Logger(TensorRtObjectDetector.class, LogGroup.General);
+
+    private final Cleaner cleaner = Cleaner.create();
+    private final Cleanable cleanable;
+
+    // Captures only the pointer, not this object, so the cleaner can run.
+    private static Runnable cleanupAction(long ptr) {
+        return () -> TensorRtJNI.destroy(ptr);
+    }
+
+    private final long ptr;
+    private final TensorRtModel model;
+    private final Size inputSize;
+
+    public TensorRtObjectDetector(TensorRtModel model, Size requestedSize) {
+        this.model = model;
+        if (!TensorRtJNI.load()) {
+            throw new RuntimeException("The TensorRT backend (libspectrumtrt.so) could not be loaded");
+        }
+        ptr = TensorRtJNI.create(model.modelFile.getPath());
+        if (ptr == 0) {
+            throw new RuntimeException(
+                    "Failed to load TensorRT engine "
+                            + model.modelFile.getPath()
+                            + " (build it on this Jetson with trtexec; see the log above)");
+        }
+        int[] s = TensorRtJNI.inputSize(ptr);
+        inputSize = new Size(s[0], s[1]);
+        if (inputSize.width != requestedSize.width || inputSize.height != requestedSize.height) {
+            logger.warn(
+                    "Model "
+                            + model.getNickname()
+                            + " says "
+                            + requestedSize
+                            + " but the engine's input is "
+                            + inputSize
+                            + "; using the engine's");
+        }
+        cleanable = cleaner.register(this, cleanupAction(ptr));
+        logger.info("Loaded TensorRT model " + model.getNickname() + " (" + inputSize + ")");
+    }
+
+    @Override
+    public TensorRtModel getModel() {
+        return model;
+    }
+
+    @Override
+    public List<String> getClasses() {
+        return model.properties.labels();
+    }
+
+    @Override
+    public List<NeuralNetworkPipeResult> detect(Mat in, double nmsThresh, double boxThresh) {
+        Mat letterboxed = new Mat();
+        Letterbox scale =
+                Letterbox.letterbox(in, letterboxed, inputSize, ColorHelper.colorToScalar(Color.GRAY));
+        float[] r;
+        try {
+            if (letterboxed.channels() != 3) {
+                logger.error("TensorRT models need a colour (BGR) image");
+                return List.of();
+            }
+            r = TensorRtJNI.detect(ptr, letterboxed.getNativeObjAddr(), boxThresh, nmsThresh, getClasses().size());
+        } finally {
+            letterboxed.release();
+        }
+        if (r == null || r.length == 0) return List.of();
+        var unscaled = new ArrayList<NeuralNetworkPipeResult>(r.length / 6);
+        for (int i = 0; i + 5 < r.length; i += 6) {
+            unscaled.add(
+                    new NeuralNetworkPipeResult(
+                            new Rect2d(r[i], r[i + 1], r[i + 2], r[i + 3]), (int) r[i + 4], r[i + 5]));
+        }
+        return scale.resizeDetections(unscaled);
+    }
+
+    @Override
+    public void release() {
+        cleanable.clean();
+    }
+}
