+// SpectrumJetson (detector-13): with the stage graphs, Detect() waited for the GPU three times a
+// frame: for the point count (to pick stage 2's bucket), for the selected-point and quad counts
+// (stage 3's buckets), and for the fit quads. Each wait leaves the GPU idle while the camera thread
+// wakes up and launches the next graph. Chained, stages 2 and 3 go in right behind stage 1 with
+// buckets guessed from the last frames' counts (a little above the largest lately), and Detect()
+// waits once. Any bucket at least as large as the real count gives exactly the same output
+// (detector-11's padding), so the host only checks afterwards that each count fit its bucket; when
+// one didn't (a much busier frame), stages 2 and 3 run again with the right buckets as before.
+// SPECTRUM_DETECTOR_CHAIN=0 or 0 in /tmp/spectrum-detector-chain (re-read every 2 s): off.
+bool SpectrumChainedStages() {
+  static const bool on = [] {
+    const char* v = std::getenv("SPECTRUM_DETECTOR_CHAIN");
+    return !(v && std::string(v) == "0");
+  }();
+  static SpectrumKnob knob("/tmp/spectrum-detector-chain", 1);
+  return on && knob.Get() != 0;
+}
