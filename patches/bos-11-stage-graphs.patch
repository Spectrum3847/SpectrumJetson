+    ValidPeaks peak_filter;
+    CHECK_CUDA(cub::DeviceSelect::If(temp_storage_compressed_union_marker_pair_device_.get(),
+                                     temp_storage_bytes, input_iterator,
+                                     compressed_peaks_device_.get(),
+                                     num_compressed_peaks_device_.get(), bucket,
+                                     peak_filter, stream));
+  }
+  {
+    Peak pad;
+    pad.error = 0;
+    pad.filtered_point_index = 0xffffffff;
+    pad.blob_index = Peak::kNoPeak();  // after every real peak's blob
+    LaunchPadTail(compressed_peaks_device_.get(), num_compressed_peaks_device_.get(),
