+            String v = System.getenv(name);
+            return v == null || v.isBlank() ? def : Double.parseDouble(v.trim());
         } catch (NumberFormatException e) {
-            return 30;
+            return def;
         }
     }
 
+    /** The Java pipeline's rate while results are published natively. */
