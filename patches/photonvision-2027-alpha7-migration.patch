+
+          <div class="text-h6 mt-4">Tags</div>
+          <v-row>
+            <v-col cols="12" md="6">
+              <v-btn-toggle v-model="mapMode" density="compact" mandatory class="mb-2">
+                <v-btn value="2d" size="small">Map</v-btn>
+                <v-btn value="3d" size="small">3D</v-btn>
+              </v-btn-toggle>
+              <FieldCalMap v-if="mapMode === '2d'" :layout="layout" :offsets="offsets" focus-seen />
+              <Suspense v-else>
+                <FieldCal3D :layout="layout" :offsets="offsets" />
+                <template #fallback>Loading the 3D field…</template>
+              </Suspense>
+              <div class="text-caption">
+                Arrows: each tag's offset from the layout, drawn 10× larger. Red: moved.
+                <span v-if="results.alignment.tagsIgnored?.length"
+                  >Lined up on the tags that agree; not used for that:
+                  {{ results.alignment.tagsIgnored.join(", ") }}.</span
+                >
+              </div>
+            </v-col>
+            <v-col cols="12" md="6">
+              <v-table density="compact">
+                <thead>
+                  <tr>
+                    <th>Tag</th>
+                    <th>Seen</th>
+                    <th>Offset (cm)</th>
+                    <th>Angle (°)</th>
+                    <th></th>
+                  </tr>
+                </thead>
+                <tbody>
+                  <tr v-for="(t, id) in results.tags" :key="id">
+                    <td>{{ id }}</td>
+                    <td>{{ t.observations }}</td>
+                    <td>{{ fmt(t.offsetCm) }} ± {{ fmt(t.sigmaRelCm) }}</td>
+                    <td>{{ fmt(t.angleDeg, 2) }}</td>
+                    <td>
+                      <v-chip size="small" :color="verdictColor(t.verdict)">{{ t.verdict }}</v-chip>
+                    </td>
+                  </tr>
+                </tbody>
+              </v-table>
+            </v-col>
+          </v-row>
+
+          <div class="mt-4">
+            <v-btn color="primary" class="mr-2 mb-2" :disabled="busy" prepend-icon="mdi-map-check" @click="applyLayout"
+              >Use this layout in PhotonVision</v-btn
+            >
+            <v-btn
+              v-if="status.latestBackup"
+              variant="tonal"
+              class="mr-2 mb-2"
+              :disabled="busy"
+              prepend-icon="mdi-undo"
+              @click="undoLayout"
+              >Undo the last layout change</v-btn
+            >
+            <v-btn variant="text" class="mb-2" :href="fileUrl('corrected-layout.json')" prepend-icon="mdi-download"
+              >Layout for robot code</v-btn
+            >
+            <v-btn variant="text" class="mb-2" :href="fileUrl('mounts.json')" prepend-icon="mdi-download">Mounts</v-btn>
+            <v-btn variant="text" class="mb-2" :href="fileUrl('report.md')" prepend-icon="mdi-download">Report</v-btn>
