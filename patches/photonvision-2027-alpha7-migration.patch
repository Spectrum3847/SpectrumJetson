diff --git a/photon-client/src/views/FieldCalibrationView.vue b/photon-client/src/views/FieldCalibrationView.vue
new file mode 100644
index 0000000000000000000000000000000000000000..5d1b869f53950ced24401c644785cb7e5c04b988
--- /dev/null
+++ b/photon-client/src/views/FieldCalibrationView.vue
@@ -0,0 +1,746 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-30): field calibration. Tune the camera settings at one spot, then
+// push the robot by hand to still spots while every camera records; the Jetson then solves every
+// tag's real pose and every camera's mount (tools/fieldcal, with the 971 GPU detector).
+import { computed, onBeforeUnmount, onMounted, ref, watch } from "vue";
+import axios from "axios";
+import { useStateStore } from "@/stores/StateStore";
+import { useSettingsStore } from "@/stores/settings/GeneralSettingsStore";
+import FieldCalMap from "@/components/fieldcal/FieldCalMap.vue";
+import FieldCal3D from "@/components/fieldcal/FieldCal3D.vue";
+import type { Control, MapOffset, MapPoint, MapSuggestion, TuneCamera } from "@/types/FieldCalTypes";
+import CameraTuneCard from "@/components/fieldcal/CameraTuneCard.vue";
+
+type Mount = { x: number; y: number; z: number; rollDeg: number; pitchDeg: number; yawDeg: number };
+type Status = {
+  state: "IDLE" | "RECORDING" | "SOLVING" | "SOLVED" | "FAILED";
+  session: string;
+  message: string;
+  toolInstalled: boolean;
+  seconds: number;
+  rewindRecording: boolean;
+  rewindSession: string;
+  still?: boolean;
+  stillSeconds?: number;
+  holdSeconds?: number;
+  spotCaptured?: boolean;
+  live?: Record<string, { tags: number[]; pose: number[] | null; multiTag: boolean }>;
+  spots: { views: Record<string, number[]>; cameraPoses: Record<string, number[]> }[];
+  tagSpots: Record<string, number>;
+  cameraSpots: Record<string, number>;
+  solveLog: string[];
+  tuning: {
+    running: boolean;
+    phase: string;
+    stepsDone: number;
+    stepsTotal: number;
+    result: string;
+    cameras: Record<string, TuneCamera>;
+  };
+  controls: Record<string, Record<string, Control | number | boolean>>;
+  preview: Record<string, { margins: Record<string, number>; ageMs: number }>;
+  locks: Record<string, string[]>;
+  robotMounts: Record<string, Mount>;
+  robotConnected: boolean;
+  cameras: Record<string, { calibration: { resolution: string } | null; videoMode?: string }>;
+  runs: string[];
+  recordings: string[];
+  latestBackup: string;
+};
+type TagResult = {
+  observations: number;
+  rmsPx: number;
+  sigmaRelCm: number;
+  sigmaDeg: number;
+  dxCm?: number;
+  dyCm?: number;
+  dzCm?: number;
+  offsetCm?: number;
+  angleDeg?: number;
+  verdict: string;
+};
+type MountResult = {
+  rigFrame: Mount;
+  sigma: Record<string, number>;
+  robotToCamera?: Mount;
+  cad?: Mount;
+  minusCad?: Mount;
+};
+type Results = {
+  referenceCamera: string;
+  spots: number;
+  observations: number;
+  dropped: number;
+  rmsPxByCamera: Record<string, number>;
+  tags: Record<string, TagResult>;
+  mounts: Record<string, MountResult>;
+  anchor: string;
+  correctedTags: number[];
+  lensCheck: Record<string, { centrePx: number | null; edgePx: number | null; recalibrate: boolean }>;
+  notes: string[];
+  alignment: { tagsUsed?: number[]; tagsIgnored?: number[] };
+};
+
+const status = ref<Status | null>(null);
+const busy = ref(false);
+const results = ref<Results | null>(null);
+const resultsRun = ref("");
+const beep = ref(true);
+const mapMode = ref<"2d" | "3d">("2d");
+let timer: ReturnType<typeof setTimeout> | undefined;
+
+const layout = computed(() => useSettingsStore().currentFieldLayout);
+const recording = computed(() => status.value?.state === "RECORDING");
+
+const load = async () => {
+  try {
+    status.value = (await axios.get("/fieldcal")).data;
+  } catch {
+    status.value = null;
+  }
+  clearTimeout(timer);
+  timer = setTimeout(load, recording.value || status.value?.tuning?.running ? 400 : 2000);
+};
+const act = async (body: object, done?: string) => {
+  busy.value = true;
+  try {
+    const r = await axios.post("/fieldcal", body);
+    if (typeof r.data === "object") status.value = r.data;
+    if (done) useStateStore().showSnackbarMessage({ message: done, color: "success" });
+  } catch (e: any) {
+    useStateStore().showSnackbarMessage({ message: e?.response?.data || "Request failed", color: "error" });
+  } finally {
+    busy.value = false;
+    load();
+  }
+};
+
+// ---- readiness
+const cameraNames = computed(() => Object.keys(status.value?.cameras ?? {}).sort());
+const calibrated = (name: string) => {
+  const c = status.value?.cameras[name];
+  if (!c?.calibration) return false;
+  return !c.videoMode || c.videoMode.startsWith(c.calibration.resolution);
+};
+const mountsFromRobot = computed(() => Object.keys(status.value?.robotMounts ?? {}).length);
+
+// ---- recording guidance
+const spotCount = computed(() => status.value?.spots.length ?? 0);
+const inView = computed(() => {
+  const s = new Set<number>();
+  for (const c of Object.values(status.value?.live ?? {})) c.tags.forEach((t) => s.add(t));
+  return [...s];
+});
+const liveCameras = computed(() =>
+  Object.entries(status.value?.live ?? {}).map(([name, c]) => ({ name, pose: c.pose }))
+);
+const spotPoints = computed<MapPoint[]>(() =>
+  (status.value?.spots ?? [])
+    .map((s, i) => {
+      const poses = Object.values(s.cameraPoses);
+      if (!poses.length) return null;
+      return {
+        x: poses.reduce((a, p) => a + p[0], 0) / poses.length,
+        y: poses.reduce((a, p) => a + p[1], 0) / poses.length,
+        label: String(i + 1)
+      };
+    })
+    .filter((p): p is MapPoint & { label: string } => p !== null)
+);
+const tagSeen = (id: number) => status.value?.tagSpots[String(id)] ?? 0;
+const seenTags = computed(() => layout.value.tags.filter((t) => tagSeen(t.ID) > 0));
+const wellSeen = computed(() => seenTags.value.filter((t) => tagSeen(t.ID) >= 2));
+const needMore = computed(() => seenTags.value.filter((t) => tagSeen(t.ID) === 1));
+
+const yawOf = (q: { W: number; X: number; Y: number; Z: number }) =>
+  Math.atan2(2 * (q.W * q.Z + q.X * q.Y), 1 - 2 * (q.Y * q.Y + q.Z * q.Z));
+const here = computed(() => {
+  const poses = liveCameras.value.map((c) => c.pose).filter((p): p is number[] => !!p);
+  if (poses.length) {
+    return {
+      x: poses.reduce((a, p) => a + p[0], 0) / poses.length,
+      y: poses.reduce((a, p) => a + p[1], 0) / poses.length
+    };
+  }
+  const last = spotPoints.value[spotPoints.value.length - 1];
+  return last ? { x: last.x, y: last.y } : null;
+});
+// Next: in front of the nearest tag seen from only one spot (2.5 m out, facing it).
+const suggestion = computed<MapSuggestion | null>(() => {
+  if (!recording.value || !needMore.value.length) return null;
+  const h = here.value;
+  const scored = needMore.value
+    .map((t) => {
+      const yaw = yawOf(t.pose.rotation.quaternion);
+      const f = layout.value.field;
+      const x = Math.min(f.length - 0.6, Math.max(0.6, t.pose.translation.x + 2.5 * Math.cos(yaw)));
+      const y = Math.min(f.width - 0.6, Math.max(0.6, t.pose.translation.y + 2.5 * Math.sin(yaw)));
+      const d = h ? Math.hypot(x - h.x, y - h.y) : 0;
+      return { tag: t.ID, x, y, faceX: t.pose.translation.x, faceY: t.pose.translation.y, d };
+    })
+    .sort((a, b) => a.d - b.d);
+  return scored[0];
+});
+const headingBins = computed(() => {
+  const bins = new Set<number>();
+  for (const s of status.value?.spots ?? []) {
+    const p = Object.values(s.cameraPoses)[0];
+    if (p) bins.add(Math.round(((p[2] * 180) / Math.PI + 360) / 45) % 8);
+  }
+  return bins.size;
+});
+const checklist = computed(() => [
+  { ok: spotCount.value >= 12, text: `${spotCount.value} spots (aim for 12–20)` },
+  {
+    ok: seenTags.value.length > 0 && needMore.value.length === 0,
+    text: `${wellSeen.value.length} of ${seenTags.value.length} tags seen from 2+ spots`
+  },
+  {
+    ok: cameraNames.value.length > 0 && cameraNames.value.every((c) => (status.value?.cameraSpots[c] ?? 0) >= 3),
+    text: `Every camera saw tags at 3+ spots (${cameraNames.value
+      .map((c) => `${c} ${status.value?.cameraSpots[c] ?? 0}`)
+      .join(", ")})`
+  },
+  { ok: headingBins.value >= 3, text: "The robot turned to several headings" }
+]);
+const banner = computed(() => {
+  const s = status.value;
+  if (!s || !recording.value) return null;
+  if (!inView.value.length)
+    return { color: "error", text: "No camera sees a tag here. Push the robot to where cameras see tags." };
+  if (s.spotCaptured)
+    return { color: "success", text: `Spot ${spotCount.value} captured. Push the robot to the next spot.` };
+  if (s.still)
+    return {
+      color: "warning",
+      text: "Hold still…",
+      progress: Math.min(100, (100 * (s.stillSeconds ?? 0)) / (s.holdSeconds ?? 1.5))
+    };
+  return { color: "info", text: "Moving. Push the robot to a new spot 1–2 m away, then hold it still." };
+});
+
+// A short beep when a spot counts, for whoever is pushing and not watching the screen.
+let lastSpots = 0;
+watch(spotCount, (n) => {
+  if (n > lastSpots && beep.value) {
+    try {
+      const ctx = new AudioContext();
+      const o = ctx.createOscillator();
+      o.frequency.value = 880;
+      o.connect(ctx.destination);
+      o.start();
+      o.stop(ctx.currentTime + 0.15);
+    } catch {
+      // no audio
+    }
+  }
+  lastSpots = n;
+});
+
+// ---- tuning
+const tuning = computed(() => status.value?.tuning);
+const tuneProgress = computed(() =>
+  tuning.value?.stepsTotal ? (100 * tuning.value.stepsDone) / tuning.value.stepsTotal : 0
+);
+const camerasSeeingTags = computed(() =>
+  cameraNames.value.filter((c) => {
+    const p = status.value?.preview[c];
+    return p && p.ageMs < 2000 && Object.keys(p.margins).length > 0;
+  })
+);
+// ---- results
+const loadResults = async (run: string) => {
+  resultsRun.value = run;
+  results.value = null;
+  if (!run) return;
+  try {
+    results.value = (await axios.get(`/fieldcal/file?session=${encodeURIComponent(run)}&name=results.json`)).data;
+  } catch {
+    results.value = null;
+  }
+};
+watch(
+  () => [status.value?.state, status.value?.session],
+  ([st, s]) => {
+    if (st === "SOLVED" && s && s !== resultsRun.value) loadResults(s as string);
+  }
+);
+watch(
+  () => status.value?.runs,
+  (runs) => {
+    if (!resultsRun.value && runs?.length) loadResults(runs[0]);
+  }
+);
+const offsets = computed<Record<string, MapOffset> | undefined>(() => {
+  if (!results.value) return undefined;
+  const o: Record<string, MapOffset> = {};
+  for (const [id, t] of Object.entries(results.value.tags)) {
+    if (t.dxCm === undefined) continue;
+    o[id] = { dxCm: t.dxCm, dyCm: t.dyCm ?? 0, moved: t.verdict === "moved" };
+  }
+  return o;
+});
+const verdictColor = (v: string) =>
+  v === "moved" ? "error" : v.startsWith("as drawn, but") || v.startsWith("seen once") ? "warning" : "success";
+const fileUrl = (name: string) =>
+  `/api/fieldcal/file?session=${encodeURIComponent(resultsRun.value)}&name=${name}&download=1`;
+const java = computed(() => {
+  if (!results.value) return "";
+  const lines = [`// Field calibration ${resultsRun.value}: robotToCamera for each camera`];
+  for (const [c, m] of Object.entries(results.value.mounts)) {
+    const f = m.robotToCamera;
+    if (!f) continue;
+    lines.push(
+      `Transform3d ${c.charAt(0).toLowerCase() + c.slice(1)}ToCamera = new Transform3d(`,
+      `    new Translation3d(${f.x.toFixed(4)}, ${f.y.toFixed(4)}, ${f.z.toFixed(4)}),`,
+      `    new Rotation3d(Units.degreesToRadians(${f.rollDeg.toFixed(2)}), Units.degreesToRadians(${f.pitchDeg.toFixed(
+        2
+      )}), Units.degreesToRadians(${f.yawDeg.toFixed(2)})));`
+    );
+  }
+  return lines.length > 1 ? lines.join("\n") : "";
+});
+const copyJava = () => navigator.clipboard?.writeText(java.value);
+const applyLayout = () => {
+  if (
+    window.confirm(
+      "Put the corrected layout into PhotonVision?\n\nThe layout in use now is saved first, and Undo puts it back. " +
+        "PhotonVision restarts (about 20 s). Robot code needs the same layout: download it here too."
+    )
+  )
+    act({ action: "apply", session: resultsRun.value }, "Layout applied; PhotonVision is restarting");
+};
+const undoLayout = () => {
+  if (
+    window.confirm(
+      `Put back the layout saved before the last apply (${status.value?.latestBackup})? PhotonVision restarts.`
+    )
+  )
+    act({ action: "undo" }, "Previous layout restored; PhotonVision is restarting");
+};
+const fmt = (v: number | undefined, d = 1) => (v === undefined || v === null ? "" : v.toFixed(d));
+const fmtTime = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
+const solveRecording = ref("");
+
+onMounted(load);
+onBeforeUnmount(() => clearTimeout(timer));
+</script>
+
+<template>
+  <div class="pa-3">
+    <v-card class="mb-3 rounded-12" color="surface">
+      <v-card-title>Field calibration</v-card-title>
+      <v-card-text>
+        <p class="mb-3">
+          Finds where this field's tags really are and where every camera sits on the robot, from the robot's own
+          cameras. Robot on and <b>disabled</b>, pushed by hand. Tune the camera settings at one spot, then record 10–20
+          spots; the Jetson does the rest in about a minute.
+        </p>
+        <div v-if="status">
+          <div class="check">
+            <v-icon :color="status.toolInstalled ? 'success' : 'error'">
+              {{ status.toolInstalled ? "mdi-check-circle" : "mdi-close-circle" }}
+            </v-icon>
+            <span v-if="status.toolInstalled">Solver installed on this Jetson.</span>
+            <span v-else>
+              The solver isn't installed: run <code>scripts/jetson/13-build-fieldcal-detect.sh --install</code> on the
+              Jetson.
+            </span>
+          </div>
+          <div v-for="c in cameraNames" :key="c" class="check">
+            <v-icon :color="calibrated(c) ? 'success' : 'error'">
+              {{ calibrated(c) ? "mdi-check-circle" : "mdi-close-circle" }}
+            </v-icon>
+            {{ c }}:
+            <span v-if="calibrated(c)">lens calibrated at {{ status.cameras[c].calibration?.resolution }}</span>
+            <span v-else
+              >not calibrated at its current resolution ({{ status.cameras[c].videoMode }}): calibrate it first (Camera
+              page)</span
+            >
+            <span v-if="status.robotMounts[c]">
+              · mount from robot code: {{ fmt(status.robotMounts[c].z, 3) }} m high, pitch
+              {{ fmt(status.robotMounts[c].pitchDeg) }}°</span
+            >
+          </div>
+          <div class="check">
+            <v-icon :color="mountsFromRobot ? 'success' : 'warning'">
+              {{ mountsFromRobot ? "mdi-check-circle" : "mdi-alert-circle" }}
+            </v-icon>
+            <span v-if="mountsFromRobot"
+              >Camera mounts from robot code for {{ mountsFromRobot }} camera(s): the solve compares against them and
+              anchors x, y and yaw.</span
+            >
+            <span v-else>
+              {{ status.robotConnected ? "Robot code isn't sending camera mounts" : "No robot connected" }}: publish
+              each camera's <code>robotToCamera</code> (Transform3d struct) at
+              <code>/photonvision/&lt;camera&gt;/robotToCamera</code>. Without them, height, pitch and roll are still
+              found; x, y and yaw are relative.
+            </span>
+          </div>
+          <div class="check">
+            <v-icon color="success">mdi-check-circle</v-icon>
