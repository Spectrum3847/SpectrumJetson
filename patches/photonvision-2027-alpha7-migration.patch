+    /**
+     * POST /api/fieldcal {"action": "start" | "stop" | "solve" | "cancel" | "tune" | "cancelTune" |
+     * "applyTuning" | "setControl" | "apply" | "undo", "session": name, "camera": nickname, "control",
+     * "value", "locked": {camera: [control]}}. "tune" steps one camera ("camera"), or every camera,
+     * through its settings with the robot still, leaving the locked controls alone ("setLock" with
+     * "camera", "control", "on"; kept on the Jetson, or "locked" for this run only); "applyTuning"
+     * writes that camera's (or every camera's) recommendations into its pipeline in use;
+     * "setControl" sets one control by hand. "apply" puts a solve's corrected layout into PhotonVision (after saving the
+     * current one) and restarts; "undo" puts back the layout saved by the last apply.
+     */
+    public static void onFieldCalActionRequest(Context ctx) {
+        var fc = FieldCalibration.getInstance();
+        try {
+            var req = Jsonb.instance().type(FieldCalRequest.class).fromJson(ctx.body());
+            switch (req.action() == null ? "" : req.action()) {
+                case "start" -> fc.start();
+                case "stop" -> fc.stop();
+                case "solve" -> {
+                    if (req.session() != null && !req.session().isEmpty()) fc.solve(req.session());
+                    else fc.stopAndSolve();
+                }
+                case "cancel" -> fc.cancelSolve();
+                case "tune" -> fc.tune(req.camera(), req.locked());
+                case "setLock" -> {
+                    if (req.camera() == null || req.control() == null || req.on() == null) {
+                        throw new IllegalArgumentException("setLock needs camera, control and on");
+                    }
+                    fc.setLock(req.camera(), req.control(), req.on());
+                }
+                case "setControl" -> {
+                    if (req.camera() == null || req.control() == null || req.value() == null) {
+                        throw new IllegalArgumentException("setControl needs camera, control and value");
+                    }
+                    fc.setControl(req.camera(), req.control(), req.value());
+                }
+                case "cancelTune" -> fc.cancelTune();
+                case "applyTuning" -> fc.applyTuning(req.camera());
+                case "apply", "undo" -> {
+                    Path layout;
+                    if (req.action().equals("apply")) {
+                        layout = FieldCalibration.resultFile(req.session(), "corrected-layout.json");
+                        if (layout == null) throw new IllegalArgumentException("That recording has no solved layout");
+                        var backup = fc.backupLayout();
+                        logger.info("Field calibration: applying " + layout + " (previous layout saved to " + backup + ")");
+                    } else {
+                        layout = FieldCalibration.latestBackup();
+                        if (layout == null) throw new IllegalArgumentException("No saved layout to go back to");
+                        logger.info("Field calibration: putting back " + layout);
+                    }
+                    if (!ConfigManager.getInstance().saveUploadedFieldLayout(layout)) {
+                        throw new IOException("PhotonVision couldn't load " + layout.getFileName());
+                    }
+                    if (req.action().equals("undo")) Files.delete(layout);
+                    ctx.status(200);
+                    ctx.result("Layout saved; restarting PhotonVision");
+                    restartProgram();
+                    return;
+                }
+                default -> throw new IllegalArgumentException("Unknown action " + req.action());
+            }
+            onFieldCalStatusRequest(ctx);
+        } catch (IllegalArgumentException | IllegalStateException | JsonException e) {
+            ctx.status(400);
+            ctx.result(e.getMessage());
+        } catch (IOException | InterruptedException e) {
+            ctx.status(500);
+            ctx.result("Field calibration: " + e.getMessage());
+        }
+    }
