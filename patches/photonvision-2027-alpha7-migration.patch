diff --git a/photon-client/src/components/settings/RewindCard.vue b/photon-client/src/components/settings/RewindCard.vue
new file mode 100644
index 00000000..9fd9ee91
--- /dev/null
+++ b/photon-client/src/components/settings/RewindCard.vue
@@ -0,0 +1,169 @@
+<script setup lang="ts">
+// SpectrumJetson Rewind: records each camera's own MJPEG frames to the SSD while robot code sets
+// /photonvision/rewind/record (or "Record now" here, for bench tests). See docs/REWIND.md.
+import { onBeforeUnmount, onMounted, ref } from "vue";
+import axios from "axios";
+import PvSwitch from "@/components/common/pv-switch.vue";
+import { useStateStore } from "@/stores/StateStore";
+import { useTheme } from "vuetify";
+
+const theme = useTheme();
+
+type RewindCamera = { camera: string; fps: number; frames: number; MB: number; problem: string };
+type RewindStatus = {
+  recording: boolean;
+  session: string;
+  reason: string;
+  seconds: number;
+  stopReason: string;
+  manual: boolean;
+  robotConnected: boolean;
+  robotRequest: boolean;
+  diskLow: boolean;
+  freeGB: number;
+  usedGB: number;
+  sessionCount: number;
+  settings: { fps: number; quotaGB: number; minFreeGB: number };
+  cameras: RewindCamera[];
+  recent: { name: string; MB: number }[];
+};
+
+const status = ref<RewindStatus | null>(null);
+const busy = ref(false);
+let timer: ReturnType<typeof setInterval> | undefined;
+
+const load = async () => {
+  try {
+    status.value = (await axios.get("/rewind")).data;
+  } catch {
+    status.value = null;
+  }
+};
+const post = async (body: object, message: string) => {
+  busy.value = true;
+  try {
+    status.value = (await axios.post("/rewind", body)).data;
+    useStateStore().showSnackbarMessage({ message, color: "success" });
+  } catch (e: any) {
+    useStateStore().showSnackbarMessage({
+      message: e?.response?.data || "Rewind request failed",
+      color: "error"
+    });
+    await load();
+  } finally {
+    busy.value = false;
+  }
+};
+const setManual = (on: boolean) => post({ manual: on }, on ? "Recording (bench)" : "Bench recording stopped");
+const deleteSession = (name: string) => {
+  if (window.confirm(`Delete recording ${name}?`)) post({ delete: name }, `Deleted ${name}`);
+};
+const downloadUrl = (name: string) => `/api/rewind/download?session=${encodeURIComponent(name)}`;
+const fmtTime = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
+
+onMounted(() => {
+  load();
+  timer = setInterval(load, 2000);
+});
+onBeforeUnmount(() => clearInterval(timer));
+</script>
+
+<template>
+  <v-card v-if="status" class="mb-3 rounded-12" color="surface">
+    <v-card-title class="pb-10px">Rewind (camera recording)</v-card-title>
+    <v-card-text class="pt-0">
+      <v-alert
+        class="mb-3"
+        density="compact"
+        :color="status.recording ? 'error' : 'buttonActive'"
+        :icon="status.recording ? 'mdi-record-rec' : 'mdi-information-outline'"
+        :variant="theme.global.current.value.dark ? 'tonal' : 'elevated'"
+      >
+        <template v-if="status.recording">
+          Recording <b>{{ status.session }}</b> ({{ status.reason === "robot" ? "robot code asked" : "bench" }},
+          {{ fmtTime(status.seconds) }})
+        </template>
+        <template v-else-if="status.diskLow">Not recording: the SSD is nearly full.</template>
+        <template v-else>
+          Not recording. Robot code starts recording by setting <code>/photonvision/rewind/record</code> to
+          true{{ status.robotConnected ? "" : " (no robot connected)" }}.
+          <span v-if="status.stopReason">Last stop: {{ status.stopReason }}.</span>
+        </template>
+      </v-alert>
+
+      <pv-switch
+        :model-value="status.manual"
+        :disabled="busy"
+        label="Record now (bench)"
+        tooltip="Records every camera until turned off, for bench tests. Robot code normally controls recording."
+        :label-cols="4"
+        @update:model-value="(v) => setManual(!!v)"
+      />
+
+      <v-table v-if="status.recording" density="compact" class="mb-3">
+        <thead>
+          <tr>
+            <th>Camera</th>
+            <th>Saved fps</th>
+            <th>Frames</th>
+            <th>MB</th>
+            <th></th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr v-for="c in status.cameras" :key="c.camera">
+            <td>{{ c.camera }}</td>
+            <td>{{ c.fps }}</td>
+            <td>{{ c.frames }}</td>
+            <td>{{ c.MB }}</td>
+            <td class="text-error">{{ c.problem }}</td>
+          </tr>
+        </tbody>
+      </v-table>
+
+      <div class="mb-2">
+        {{ status.sessionCount }} recording(s), {{ status.usedGB.toFixed(1) }} GB of
+        {{ status.settings.quotaGB }} GB allowed; {{ status.freeGB.toFixed(0) }} GB free on the SSD. Saving
+        {{ status.settings.fps }} frames/s per camera. The oldest recordings are deleted past the limit.
+        <v-icon size="small">mdi-download</v-icon> downloads a recording as a zip of one video (.avi) per camera. A
+        match is about 1 GB: download over Ethernet or USB, not the robot radio.
+      </div>
+      <v-table v-if="status.recent.length" density="compact">
+        <thead>
+          <tr>
+            <th>Recent recordings</th>
+            <th>MB</th>
+            <th></th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr v-for="r in status.recent" :key="r.name">
+            <td>{{ r.name }}</td>
+            <td>{{ r.MB }}</td>
+            <td class="text-no-wrap">
+              <template v-if="r.name !== status.session">
+                <!-- A plain link: the browser saves the zip straight to disk as it streams. -->
+                <v-btn
+                  size="x-small"
+                  variant="text"
+                  icon="mdi-download"
+                  title="Download (a zip of one .avi per camera, plus frame times)"
+                  :href="downloadUrl(r.name)"
+                  :download="`${r.name}.zip`"
+                />
+                <v-btn
+                  size="x-small"
+                  variant="text"
+                  icon="mdi-delete"
+                  title="Delete"
+                  :disabled="busy"
+                  @click="deleteSession(r.name)"
+                />
+              </template>
+            </td>
+          </tr>
+        </tbody>
+      </v-table>
+    </v-card-text>
+  </v-card>
+</template>
diff --git a/photon-client/src/components/settings/RobotStateCard.vue b/photon-client/src/components/settings/RobotStateCard.vue
new file mode 100644
index 00000000..f2599c13
--- /dev/null
+++ b/photon-client/src/components/settings/RobotStateCard.vue
@@ -0,0 +1,195 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-50): the robot's state as PhotonVision sees it, and idle mode
+// (photonvision-49): fewer frames while the robot is disabled, switchable for full-speed tests.
+import { computed, onBeforeUnmount, onMounted, ref } from "vue";
+import PvSwitch from "@/components/common/pv-switch.vue";
+import PvSlider from "@/components/common/pv-slider.vue";
+import PvSelect, { type SelectItem } from "@/components/common/pv-select.vue";
+import { useStateStore } from "@/stores/StateStore";
+import { useCameraSettingsStore } from "@/stores/settings/CameraSettingsStore";
+import { useTheme } from "vuetify";
+import { loadRobotState, robotState, setRobotState, type RobotStateChange } from "@/lib/RobotState";
+
+// photonvision-51: each pipeline number, with what every camera has there, so a profile set up at
+// mismatched numbers shows before a match rather than during one.
+const eventPipelineItems = computed<SelectItem[]>(() => {
+  const cameras = Object.values(useCameraSettingsStore().cameras);
+  const most = Math.max(1, ...cameras.map((c) => c.pipelineNicknames?.length ?? 0));
+  return Array.from({ length: most }, (_, index) => {
+    const byName = new Map<string, string[]>();
+    const missing: string[] = [];
+    for (const c of cameras) {
+      const name = c.pipelineNicknames?.[index];
+      if (name === undefined) missing.push(c.nickname);
+      else byName.set(name, [...(byName.get(name) ?? []), c.nickname]);
+    }
+    const parts = [...byName.entries()].map(([name, on]) =>
+      on.length === cameras.length ? `${name} (every camera)` : `${name} (${on.join(", ")})`
+    );
+    if (missing.length) parts.push(`none on ${missing.join(", ")}`);
+    return { name: `${index}: ${parts.join("; ")}`, value: index };
+  });
+});
+
+const theme = useTheme();
+const busy = ref(false);
+let timer: ReturnType<typeof setInterval> | undefined;
+
+const set = async (change: RobotStateChange) => {
+  busy.value = true;
+  try {
+    await setRobotState(change);
+  } catch {
+    useStateStore().showSnackbarMessage({ message: "Couldn't change the robot state settings", color: "error" });
+  } finally {
+    busy.value = false;
+  }
+};
+
+onMounted(() => {
+  loadRobotState();
+  timer = setInterval(loadRobotState, 1000);
+});
+onBeforeUnmount(() => clearInterval(timer));
+</script>
+
+<template>
+  <v-card v-if="robotState" class="mb-3 rounded-12" color="surface">
+    <v-card-title class="pb-10px">Robot state</v-card-title>
+    <v-card-text class="pt-0">
+      <v-alert
+        class="mb-3"
+        density="compact"
+        :color="robotState.idleNow ? 'warning' : 'buttonActive'"
+        :icon="robotState.robotConnected ? 'mdi-robot' : 'mdi-robot-off'"
+        :variant="theme.global.current.value.dark ? 'tonal' : 'elevated'"
+      >
+        <template v-if="!robotState.robotConnected">No robot connected: every camera runs at full speed.</template>
+        <template v-else>
+          Robot
+          <b>{{ robotState.enabled ? (robotState.autonomous ? "enabled (auto)" : "enabled") : "disabled" }}</b
+          >{{ robotState.fmsAttached ? ", field (FMS) connected" : "" }}.
+          {{ robotState.idleNow ? `Cameras idling at ${robotState.idleFps} fps.` : "Cameras at full speed." }}
+        </template>
+      </v-alert>
+      <pv-switch
+        :model-value="robotState.idleWhileDisabled"
+        :disabled="busy"
+        label="Idle while the robot is disabled"
+        tooltip="While a robot is connected and disabled, each camera processes only this many frames a second: less power and heat between matches, and still plenty to set the starting pose. Full speed again within 5 ms of enable. Turn off to test full speed with the robot disabled."
+        :label-cols="4"
+        @update:model-value="(v) => set({ idleWhileDisabled: !!v })"
+      />
+      <pv-slider
+        :model-value="robotState.idleFps"
+        :disabled="busy || !robotState.idleWhileDisabled"
+        label="Idle frames a second"
+        tooltip="Per camera, while the robot is disabled. 30 is plenty to set the pose before auto."
+        :min="5"
+        :max="60"
+        :step="5"
+        :slider-cols="8"
+        @update:model-value="(v) => set({ idleFps: v })"
+      />
+      <v-divider class="my-3" />
+      <pv-switch
+        :model-value="robotState.farSearch"
+        :disabled="busy"
+        label="Far-tag search when the pose is weak"
+        tooltip="Tags are normally searched for on a half-size image, which misses tags under ~20 px (far away). When no camera sees two good near tags for 0.25 s, one camera at a time also searches its full-size image (and follows far tags it finds with small full-size crops): about 1.7x the range. It stops as soon as any camera has a good view again, so it costs nothing while the pose is good."
+        :label-cols="4"
+        @update:model-value="(v) => set({ farSearch: !!v })"
+      />
+      <pv-slider
+        :model-value="robotState.farSweepsPerSecond"
+        :disabled="busy || !robotState.farSearch"
+        label="Full-size searches a second"
+        tooltip="Across all cameras, while searching. Each takes ~5 ms of GPU; 30 a second is ~16%."
+        :min="5"
+        :max="60"
+        :step="5"
+        :slider-cols="8"
+        @update:model-value="(v) => set({ farSweepsPerSecond: v })"
+      />
+      <p class="text-caption pb-1" data-testid="far-search-status">
+        <template v-if="!robotState.farSearch">Off: tags are only searched for on the half-size image.</template>
+        <template v-else-if="robotState.farSearchSweeps === undefined">Status unknown (older detector library).</template>
+        <template v-else>
+          {{ robotState.farSearchStarved ? "Searching now: no camera has a good view." : "Waiting: a camera has a good view." }}
+          Since start: {{ robotState.farSearchStarvedSeconds?.toFixed(0) }} s searching,
+          {{ robotState.farSearchSweeps }} full-size searches ({{ robotState.farSearchSweepMs?.toFixed(1) }} ms each),
+          {{ robotState.farSearchTags }} far tags found.
+        </template>
+      </p>
+      <v-divider class="my-3" />
+      <pv-switch
+        :model-value="robotState.quietAfterMatch"
+        :disabled="busy"
+        label="Quiet after a match"
+        tooltip="Power cuts only damage an SSD while it's being written. When a match ends (field connected, teleop, then disabled), the Jetson stops writing to the SSD: Rewind stops and logs go to memory. The cameras keep running. Any enable ends it within a fraction of a second."
+        :label-cols="4"
+        @update:model-value="(v) => set({ quietAfterMatch: !!v })"
+      />
+      <pv-slider
+        :model-value="robotState.quietAfterDisabledSeconds"
+        :disabled="busy"
+        label="Quiet after disabled for (s)"
+        tooltip="Also go quiet after the robot has been disabled this long, on or off the field (pit, practice). 0 = never."
+        :min="0"
+        :max="600"
+        :step="10"
+        :slider-cols="8"
+        @update:model-value="(v) => set({ quietAfterDisabledSeconds: v })"
+      />
+      <v-alert
+        v-if="robotState.thermalLimitNow"
+        type="warning"
+        density="compact"
+        class="mb-2"
+        data-testid="thermal-limit"
+      >
+        Too hot: every camera is capped at {{ robotState.thermalLimitFps }} fps until the chip is under 88 °C.
+      </v-alert>
+      <p class="text-caption pb-1" data-testid="quiet-status">
+        <template v-if="robotState.quietNow">Quiet now ({{ robotState.quietReason }}): the SSD isn't being written.</template>
+        <template v-else>Writing normally.</template>
+        <template v-if="robotState.quietLastLeaveMs >= 0"> Last switch back to writing took {{ robotState.quietLastLeaveMs }} ms.</template>
+        <template v-if="!robotState.quietHelper"> The quiet-mode helper isn't installed (10-data-partition.sh).</template>
+        <template v-if="robotState.quietError"> Problem: {{ robotState.quietError }}</template>
+        Robot code can decide instead with /photonvision/jetson/quiet.
+      </p>
+      <v-divider class="my-3" />
+      <pv-switch
+        :model-value="robotState.eventProfileOnFms"
+        :disabled="busy"
+        label="Event pipeline when the field connects"
+        tooltip="When the field (FMS) connects, every camera switches to the pipeline number below, once. Anything after that sticks: a switch on the dashboard, robot code choosing a pipeline, or turning this off. Cameras without that number, in driver mode or calibrating are left alone."
+        :label-cols="4"
+        @update:model-value="(v) => set({ eventProfileOnFms: !!v })"
+      />
+      <pv-select
+        :model-value="robotState.eventPipeline"
+        :disabled="busy || !robotState.eventProfileOnFms"
+        label="Event pipeline"
+        tooltip="The pipeline number every camera switches to. Each entry lists what the cameras have at that number."
+        :items="eventPipelineItems"
+        :select-cols="8"
+        @update:model-value="(v) => set({ eventPipeline: Number(v) })"
+      />
+      <div class="d-flex align-center pt-2">
+        <v-btn
+          size="small"
+          variant="tonal"
+          color="buttonActive"
+          :disabled="busy || !robotState.eventProfileOnFms"
+          @click="set({ switchNow: true })"
+        >
+          Switch now
+        </v-btn>
+        <span class="text-caption pl-3" data-testid="last-event-switch">
+          {{ robotState.lastEventSwitch ? `Last: ${robotState.lastEventSwitch}` : "Not switched since PhotonVision started." }}
+        </span>
+      </div>
+    </v-card-text>
+  </v-card>
+</template>
diff --git a/photon-client/src/components/settings/SnapshotsCard.vue b/photon-client/src/components/settings/SnapshotsCard.vue
