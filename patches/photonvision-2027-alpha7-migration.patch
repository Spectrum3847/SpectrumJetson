+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package org.photonvision.vision.frame.provider;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.ArrayList;
+import org.junit.jupiter.api.Test;
+import org.photonvision.vision.frame.provider.StuckCameraWatchdog.Action;
+
+/** SpectrumJetson (photonvision-29). */
+public class StuckCameraWatchdogTest {
+    private long nowNs = 1_000_000_000_000L;
+
+    private StuckCameraWatchdog make() {
+        return new StuckCameraWatchdog(() -> nowNs);
+    }
+
+    /** Polls every 250 ms (the grab timeout) for {@code seconds}, collecting actions with times. */
+    private ArrayList<String> stuckFor(StuckCameraWatchdog w, double seconds) {
+        var out = new ArrayList<String>();
+        long start = nowNs;
+        while (nowNs - start < (long) (seconds * 1e9)) {
+            nowNs += 250_000_000L;
+            var a = w.noFrame();
+            if (a != Action.NONE) out.add(a + "@" + Math.round((nowNs - start) / 1e9));
+        }
+        return out;
+    }
+
+    @Test
+    public void shortGapsDoNothing() {
+        var w = make();
+        assertEquals(0, stuckFor(w, 2.5).size());
+        assertEquals("", w.good());
+        assertEquals(0, stuckFor(w, 2.5).size());
+    }
+
+    @Test
+    public void escalatesReconnectThenUsbResetThenEvery30s() {
+        var w = make();
+        var actions = stuckFor(w, 70);
+        // Reconnect at 3 s; USB reset 5 s later (8 s); then every 30 s (38 s, 68 s).
+        assertEquals(java.util.List.of("RECONNECT@3", "USB_RESET@8", "USB_RESET@38", "USB_RESET@68"), actions);
+        assertEquals(4, w.recoveries());
+        assertEquals("a USB reset", w.good());
+        assertEquals("", w.good());
+    }
+
+    @Test
+    public void aReconnectThatWorksStopsThere() {
+        var w = make();
+        assertEquals(java.util.List.of("RECONNECT@3"), stuckFor(w, 4));
+        assertEquals("a reconnect", w.good());
+        assertEquals(0, stuckFor(w, 2).size());
+    }
+
+    @Test
+    public void modeFixReconnectsShareTheThrottle() {
+        var w = make();
+        nowNs += 2_000_000_000L;
+        w.noteReconnect(); // photonvision-27 reconnected at 2 s
+        // Stuck from the start: no reconnect of our own until 5 s after that one (7 s).
+        assertEquals(java.util.List.of("RECONNECT@5"), stuckFor(w, 5.5));
+    }
+
+    @Test
+    public void disconnectedIsNotStuck() {
+        var w = make();
+        for (int i = 0; i < 40; i++) { // 10 s unplugged
+            nowNs += 250_000_000L;
+            w.notConnected();
+        }
+        assertEquals(0, stuckFor(w, 2.5).size());
+    }
+}
diff --git a/photon-core/src/test/java/org/photonvision/vision/target/TagContrastTest.java b/photon-core/src/test/java/org/photonvision/vision/target/TagContrastTest.java
