+cudaGraphExec_t GpuDetector::RecordedStageGraph(int stage, size_t points_bucket,
+                                                size_t quads_bucket) const {
+  auto it = stage_graphs_.find(std::make_tuple(stage, points_bucket, quads_bucket));
