+package org.photonvision.vision.objects;
+
+import io.avaje.jsonb.Json;
+import io.avaje.jsonb.Jsonb;
+import java.io.File;
+import java.nio.file.Path;
+import java.util.List;
+import org.opencv.core.Size;
+import org.photonvision.common.configuration.NeuralNetworkModelManager.Family;
+import org.photonvision.common.configuration.NeuralNetworkModelManager.Version;
+import org.photonvision.common.configuration.NeuralNetworkModelsSettings.ModelProperties;
+
+/**
+ * SpectrumJetson: a YOLO model as a TensorRT engine, built on the Jetson itself with trtexec.
+ * Engines only run on the GPU and TensorRT version they were built for. See
+ * SpectrumJetson's scripts/jetson/12-install-yolo-model.sh.
+ */
+public class TensorRtModel implements Model {
+    @Json
+    record Sidecar(String nickname, List<String> labels, Integer width, Integer height, String version) {}
+
+    public final File modelFile;
+    public final ModelProperties properties;
+
+    public TensorRtModel(ModelProperties properties) throws IllegalArgumentException {
+        modelFile = new File(properties.modelPath().toString());
+        if (!modelFile.exists()) {
+            throw new IllegalArgumentException("Model file does not exist: " + modelFile);
+        }
+        if (properties.labels() == null || properties.labels().isEmpty()) {
+            throw new IllegalArgumentException("Labels must be provided");
+        }
+        if (properties.resolutionWidth() <= 0 || properties.resolutionHeight() <= 0) {
+            throw new IllegalArgumentException("Resolution must be greater than 0");
+        }
+        if (properties.family() != Family.TENSORRT) {
+            throw new IllegalArgumentException("Model family must be TENSORRT");
+        }
+        this.properties = properties;
+    }
+
+    /**
+     * Reads a sidecar JSON file next to an engine copied into the models folder. The sidecar has
+     * nickname, labels, width, height, and version. Returns null when it is missing or invalid.
+     */
+    public static ModelProperties propertiesFromSidecar(Path enginePath) {
+        String p = enginePath.toString();
+        File sidecar = new File(p.substring(0, p.length() - Family.TENSORRT.extension().length()) + ".json");
+        if (!sidecar.isFile()) return null;
+        try {
+            Sidecar data = Jsonb.instance().type(Sidecar.class).fromJson(sidecar.toPath());
+            if (data == null || data.labels() == null || data.labels().isEmpty()) return null;
+            Version version = Version.valueOf(data.version() == null ? "YOLOV11" : data.version());
+            return new ModelProperties(
+                    enginePath,
+                    data.nickname() == null ? enginePath.getFileName().toString() : data.nickname(),
+                    data.labels(),
+                    data.width() == null ? 640 : data.width(),
+                    data.height() == null ? 640 : data.height(),
+                    Family.TENSORRT,
+                    version);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** The unique identifier for the model, its path. */
+    public Path getPath() {
+        return properties.modelPath();
+    }
+
+    public String getNickname() {
+        return properties.nickname();
+    }
+
+    public Family getFamily() {
+        return properties.family();
+    }
+
+    public ModelProperties getProperties() {
+        return properties;
+    }
+
+    public ObjectDetector load() {
+        return new TensorRtObjectDetector(
+                this, new Size(properties.resolutionWidth(), properties.resolutionHeight()));
+    }
+
+    @Override
+    public String toString() {
+        return "TensorRtModel{modelFile=" + modelFile + ", properties=" + properties + '}';
+    }
+}
