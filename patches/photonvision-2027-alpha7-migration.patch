+
+package org.photonvision.fieldcal;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.opencv.core.Core;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+import org.photonvision.vision.pipeline.CVPipelineSettings;
+import org.photonvision.vision.pipeline.result.CVPipelineResult;
+import org.photonvision.vision.processes.VisionModule;
+import org.photonvision.vision.processes.VisionSourceManager;
+
+/**
+ * SpectrumJetson (photonvision-30): picks each camera's settings under the lights it will play
+ * under. With the robot held still where the cameras see tags near and far, it steps every camera
+ * through its settings (all cameras at once, each measured on its own) and measures, from the live
+ * detections: how reliably each tag is found, the decision margin, corner jitter and image
+ * brightness (which also shows whether a control does anything at all on this camera).
+ *
+ * <p>Order (docs/TUNING in patch 26): exposure first, as short as keeps every tag reliable (short
+ * exposure means less motion blur on a moving robot); then gain, brightness, contrast, gamma,
+ * sharpness and backlight compensation, one at a time, each kept only if it clearly beats the
+ * current value. The camera goes back to its pipeline's settings at the end; "apply" writes the
+ * recommendations into the pipeline in use.
+ */
+public class CameraSettingsTuner {
+    private static final Logger logger = new Logger(CameraSettingsTuner.class, LogGroup.General);
+
+    private static final long SETTLE_MS = 400;
+    private static final long MEASURE_MS = 900;
+    private static final long BASELINE_MS = 1500;
+    private static final double MOVED_PX = 3.0;
+    private static final double[] EXPOSURE_FACTORS = {2.0, 1.4, 1.0, 0.7, 0.5, 0.35, 0.25, 0.18};
+
+    /** What one setting gave on one camera. */
+    public static final class StepResult {
+        public String control;
+        public double value;
+        public int frames;
+        public double found; // fraction of the baseline's tags found, averaged over frames
+        public double margin; // mean decision margin of the baseline's tags
+        public double jitterPx; // mean per-tag corner standard deviation
+        public double brightness; // mean pixel value (0-255)
+        public int tags; // tags seen at least once
+    }
+
+    private static final class Sample {
+        Map<Integer, double[]> corners = new HashMap<>();
+        Map<Integer, Double> margins = new HashMap<>();
+        double brightness = -1;
+    }
+
+    private final class Cam {
+        final VisionModule module;
+        final String name;
+        final double[] original; // exposureRaw, autoExposure(0/1), brightness, gain, contrast, gamma, sharpness, backlight
+        final Map<String, double[]> ranges = new LinkedHashMap<>(); // control -> min, max, default
+        final Map<String, Double> current = new LinkedHashMap<>(); // the value in use as the sweep goes
+        final Map<String, Double> recommended = new LinkedHashMap<>();
+        final Map<String, Double> startValues = new LinkedHashMap<>(); // on the camera when tuning began
+        final List<StepResult> results = new ArrayList<>();
+        final Map<String, String> notes = new LinkedHashMap<>();
+        TreeSet<Integer> baselineTags = new TreeSet<>();
+        Map<Integer, double[]> baselineCentres = new HashMap<>();
+        StepResult baseline;
+        String problem = "";
+        String outcome = "";
+        Set<String> locked = Set.of(); // controls the user fixed: not swept, left as they are
+        final List<Sample> samples = new ArrayList<>();
+        long lastBrightnessNs = 0;
+
+        Cam(VisionModule m) {
+            module = m;
+            name = m.getNickname();
+            CVPipelineSettings ps = m.getCurrentPipelineSettings();
+            original =
+                    new double[] {
+                        ps.cameraExposureRaw, ps.cameraAutoExposure ? 1 : 0, ps.cameraBrightness, ps.cameraGain,
+                        ps.cameraContrast, ps.cameraGamma, ps.cameraSharpness, ps.cameraBacklightCompensation
+                    };
+            for (var e : controls(m).entrySet()) {
+                double[] c = e.getValue(); // min, max, default, value
+                ranges.put(e.getKey(), new double[] {c[0], c[1], c[2]});
+                current.put(e.getKey(), c[3]);
+            }
+            startValues.putAll(current);
+        }
+
+        void set(String control, double v) {
+            var s = module.getCameraSettables();
+            module.runOnVisionThread(
+                    () -> {
+                        switch (control) {
+                            case "exposure" -> {
+                                s.setAutoExposure(false);
+                                s.setExposureRaw(v);
+                            }
+                            case "gain" -> s.setGain((int) Math.round(v));
+                            case "brightness" -> s.setBrightness((int) Math.round(v));
+                            case "contrast" -> s.setContrast((int) Math.round(v));
+                            case "gamma" -> s.setGamma((int) Math.round(v));
+                            case "sharpness" -> s.setSharpness((int) Math.round(v));
+                            case "backlight" -> s.setBacklightCompensation((int) Math.round(v));
+                            default -> {}
+                        }
+                    });
+        }
+
+        StepResult measure(String control, double value) {
+            List<Sample> got;
+            synchronized (this) {
+                got = new ArrayList<>(samples);
+            }
+            var r = new StepResult();
+            r.control = control;
+            r.value = value;
+            r.frames = got.size();
+            if (got.isEmpty()) return r;
+            TreeSet<Integer> seen = new TreeSet<>();
+            double foundSum = 0, marginSum = 0, bSum = 0;
+            int marginN = 0, bN = 0;
+            Map<Integer, List<double[]>> byTag = new HashMap<>();
+            for (var s : got) {
+                seen.addAll(s.corners.keySet());
+                int f = 0;
+                for (int id : baselineTags) {
+                    if (s.corners.containsKey(id)) {
+                        f++;
+                        marginSum += s.margins.getOrDefault(id, 0.0);
+                        marginN++;
+                        byTag.computeIfAbsent(id, k -> new ArrayList<>()).add(s.corners.get(id));
+                    }
+                }
+                foundSum += baselineTags.isEmpty() ? 0 : (double) f / baselineTags.size();
+                if (s.brightness >= 0) {
+                    bSum += s.brightness;
+                    bN++;
+                }
+            }
+            r.found = foundSum / got.size();
+            r.margin = marginN > 0 ? marginSum / marginN : 0;
+            r.brightness = bN > 0 ? bSum / bN : -1;
+            r.tags = seen.size();
+            double jSum = 0;
+            int jN = 0;
+            for (var e : byTag.entrySet()) {
+                var list = e.getValue();
+                if (list.size() < 3) continue;
+                double[] mean = new double[8];
+                for (var c : list) for (int i = 0; i < 8; i++) mean[i] += c[i] / list.size();
+                double var = 0;
+                for (var c : list) for (int i = 0; i < 8; i++) var += (c[i] - mean[i]) * (c[i] - mean[i]);
+                jSum += Math.sqrt(var / (list.size() * 4));
+                jN++;
+                // Moved? The tag's centre against the baseline's.
+                double[] b = baselineCentres.get(e.getKey());
+                if (b != null && Math.hypot(centre(mean)[0] - b[0], centre(mean)[1] - b[1]) > MOVED_PX) {
+                    moved = true;
+                }
+            }
+            r.jitterPx = jN > 0 ? jSum / jN : 0;
+            return r;
+        }
+    }
+
+    /**
+     * The camera's tunable controls: {min, max, default, value}, in the units the pipeline stores
+     * (exposure raw, 0-100 brightness and gain, the camera's own units for the rest). A pipeline
+     * value of -1 ("camera default") shows the camera's current value.
+     */
+    public static Map<String, double[]> controls(VisionModule m) {
+        Map<String, double[]> out = new LinkedHashMap<>();
+        CVPipelineSettings ps = m.getCurrentPipelineSettings();
+        var s = m.getCameraSettables();
+        out.put("exposure", new double[] {s.getMinExposureRaw(), s.getMaxExposureRaw(), ps.cameraExposureRaw, ps.cameraExposureRaw});
+        if (m.hasGainControl()) out.put("gain", new double[] {0, 100, 50, Math.max(0, ps.cameraGain)});
+        out.put("brightness", new double[] {0, 100, 50, ps.cameraBrightness});
+        for (var c : s.getExtraControls()) {
+            String key = switch ((String) c.get("key")) {
+                case "cameraContrast" -> "contrast";
+                case "cameraGamma" -> "gamma";
+                case "cameraSharpness" -> "sharpness";
+                case "cameraBacklightCompensation" -> "backlight";
+                default -> null;
+            };
+            if (key == null) continue;
+            double min = ((Number) c.get("min")).doubleValue(), max = ((Number) c.get("max")).doubleValue();
+            if (max <= min) continue;
+            out.put(key, new double[] {min, max, ((Number) c.get("default")).doubleValue(), ((Number) c.get("value")).doubleValue()});
+        }
+        return out;
+    }
+
+    /** Sets one control in the camera's pipeline in use, applies it and saves (as the Input tab does). */
+    public static void setControl(VisionModule m, String control, double v) {
+        CVPipelineSettings ps = m.getCurrentPipelineSettings();
+        int iv = (int) Math.round(v);
+        switch (control) {
+            case "exposure" -> {
+                ps.cameraAutoExposure = false;
+                ps.cameraExposureRaw = v;
+            }
+            case "gain" -> ps.cameraGain = iv;
+            case "brightness" -> ps.cameraBrightness = iv;
+            case "contrast" -> ps.cameraContrast = iv;
+            case "gamma" -> ps.cameraGamma = iv;
+            case "sharpness" -> ps.cameraSharpness = iv;
+            case "backlight" -> ps.cameraBacklightCompensation = iv;
+            default -> throw new IllegalArgumentException("Unknown control " + control);
+        }
+        m.reapplyPipelineCameraSettings();
+        m.saveAndBroadcastAll();
+    }
+
+    /** Whether this camera is being tuned now (manual changes would fight the sweep). */
+    public boolean tuning(String camera) {
+        return running && active.containsKey(camera);
+    }
+
+    private static double[] centre(double[] c) {
+        return new double[] {(c[0] + c[2] + c[4] + c[6]) / 4, (c[1] + c[3] + c[5] + c[7]) / 4};
+    }
+
+    private final Map<String, Cam> cams = new TreeMap<>(); // every camera's last tuning, kept for "apply"
+    private final Map<String, Cam> active = new TreeMap<>(); // the cameras being tuned now
+    private volatile boolean running = false;
+    private volatile boolean cancel = false;
+    private volatile boolean sampling = false;
+    private volatile boolean moved = false;
+    private volatile String phase = "";
+    private volatile int stepsDone = 0, stepsTotal = 0;
+    private volatile String result = "";
+
+    public boolean running() {
+        return running;
+    }
+
+    public void cancel() {
+        cancel = true;
+    }
+
+    /**
+     * Starts the sweep on one camera ({@code only}), or on every running camera if null. Each
+     * camera's results are kept until it's tuned again, so cameras can be tuned one at a time, the
+     * robot turned in between so each faces tags.
+     */
+    public synchronized void start(String only, Map<String, ? extends java.util.Collection<String>> locked) {
+        if (running) throw new IllegalStateException("Tuning is already running");
+        active.clear();
+        for (var m : VisionSourceManager.getInstance().vmm.getModules()) {
+            if (!m.getEnabled()) continue;
+            if (only != null && !only.isEmpty() && !only.equals(m.getNickname())) continue;
+            var c = new Cam(m);
+            if (locked != null && locked.get(c.name) != null) c.locked = Set.copyOf(locked.get(c.name));
+            active.put(c.name, c);
+            cams.put(c.name, c);
+        }
+        if (active.isEmpty()) {
+            throw new IllegalStateException(only == null || only.isEmpty() ? "No cameras running" : "No running camera named " + only);
+        }
+        running = true;
+        cancel = false;
+        moved = false;
+        result = "";
+        var t = new Thread(this::run, "FieldCalTuner");
+        t.setDaemon(true);
+        t.start();
+    }
+
+    /** Every pipeline result of every camera, while the sweep runs. */
+    public void onResult(String camera, CVPipelineResult r) {
+        if (!sampling) return;
+        var c = active.get(camera);
+        if (c == null) return;
+        var s = new Sample();
+        for (var t : r.targets) {
+            var pts = t.getTargetCorners();
+            if (t.getFiducialId() < 0 || pts == null || pts.size() != 4) continue;
+            double[] a = new double[8];
+            for (int i = 0; i < 4; i++) {
+                a[2 * i] = pts.get(i).x;
+                a[2 * i + 1] = pts.get(i).y;
+            }
+            s.corners.put(t.getFiducialId(), a);
+            s.margins.put(t.getFiducialId(), t.getDecisionMargin());
+        }
+        long now = System.nanoTime();
+        if (now - c.lastBrightnessNs > 100_000_000L && r.inputAndOutputFrame != null) {
+            try {
+                var f = r.inputAndOutputFrame;
+                var mat = f.processedImage != null && !f.processedImage.getMat().empty()
+                        ? f.processedImage.getMat()
+                        : f.colorImage != null ? f.colorImage.getMat() : null;
+                if (mat != null && !mat.empty()) {
+                    var mean = Core.mean(mat);
+                    s.brightness = mat.channels() >= 3 ? (mean.val[0] + mean.val[1] + mean.val[2]) / 3 : mean.val[0];
+                    c.lastBrightnessNs = now;
+                }
+            } catch (Exception e) {
+                // frame already released: skip brightness for this sample
+            }
+        }
+        synchronized (c) {
+            c.samples.add(s);
+        }
+    }
+
+    private void collect(long ms) throws InterruptedException {
+        for (var c : active.values()) {
+            synchronized (c) {
+                c.samples.clear();
+            }
+        }
+        sampling = true;
+        Thread.sleep(ms);
+        sampling = false;
+    }
+
+    private void run() {
+        try {
+            List<String> order = List.of("exposure", "gain", "brightness", "contrast", "gamma", "sharpness", "backlight");
+            // Baseline: the camera as it is.
+            phase = "Measuring the camera" + (active.size() > 1 ? "s" : "") + " as set now";
+            collect(BASELINE_MS);
+            for (var c : active.values()) {
+                Map<Integer, Integer> count = new HashMap<>();
+                Map<Integer, double[]> sum = new HashMap<>();
+                synchronized (c) {
+                    for (var s : c.samples) {
+                        for (var e : s.corners.entrySet()) {
+                            count.merge(e.getKey(), 1, Integer::sum);
+                            double[] cc = centre(e.getValue());
+                            sum.merge(e.getKey(), cc, (a, b) -> new double[] {a[0] + b[0], a[1] + b[1]});
+                        }
+                    }
+                    int n = c.samples.size();
+                    for (var e : count.entrySet()) {
+                        if (n > 0 && e.getValue() >= 0.6 * n) {
+                            c.baselineTags.add(e.getKey());
+                            double[] s = sum.get(e.getKey());
+                            c.baselineCentres.put(e.getKey(), new double[] {s[0] / e.getValue(), s[1] / e.getValue()});
+                        }
+                    }
+                }
+                if (c.baselineTags.isEmpty()) c.problem = "no tags in view: turn the robot so this camera sees tags";
+                c.baseline = c.measure("baseline", 0);
+            }
+            stepsTotal = 0;
+            for (var c : active.values()) stepsTotal = Math.max(stepsTotal, plannedSteps(c, order));
+            stepsDone = 0;
+
+            for (String control : order) {
+                if (cancel || moved) break;
+                // Every camera's values for this control; cameras without it just hold.
+                Map<Cam, List<Double>> values = new LinkedHashMap<>();
+                for (var c : active.values()) {
+                    if (!c.problem.isEmpty() || !c.ranges.containsKey(control) || c.locked.contains(control)) continue;
+                    values.put(c, candidates(c, control));
+                }
+                int n = values.values().stream().mapToInt(List::size).max().orElse(0);
+                for (int i = 0; i < n && !cancel && !moved; i++) {
+                    phase = "Trying " + control + " (" + (i + 1) + " of " + n + ")";
+                    for (var e : values.entrySet()) {
+                        var list = e.getValue();
+                        e.getKey().set(control, list.get(Math.min(i, list.size() - 1)));
+                    }
+                    Thread.sleep(SETTLE_MS);
+                    collect(MEASURE_MS);
+                    for (var e : values.entrySet()) {
+                        var list = e.getValue();
+                        if (i < list.size()) e.getKey().results.add(e.getKey().measure(control, list.get(i)));
+                    }
+                    stepsDone++;
+                }
+                // Keep the best value of this control for the rest of the sweep.
+                for (var e : values.keySet()) {
+                    double best = choose(e, control);
+                    e.current.put(control, best);
+                    e.recommended.put(control, best);
+                    e.set(control, best);
+                }
+                if (!values.isEmpty()) Thread.sleep(SETTLE_MS);
+            }
+            boolean anyTags = active.values().stream().anyMatch(c -> c.problem.isEmpty());
+            result = moved
+                    ? "The robot moved: hold it still and tune again."
+                    : cancel
+                            ? "Stopped."
+                            : !anyTags
+                                    ? (active.size() > 1 ? "No camera sees" : "This camera doesn't see")
+                                            + " tags here: turn the robot so it faces tags, near and far, then tune again."
+                                    : "Done.";
+        } catch (InterruptedException e) {
+            result = "Stopped.";
+        } catch (Exception e) {
+            logger.error("Field calibration: settings tuning failed", e);
+            result = "Tuning failed: " + e.getMessage();
+        } finally {
+            sampling = false;
+            for (var c : active.values()) {
+                c.outcome = moved ? "The robot moved: hold it still and tune again." : cancel ? "Stopped." : c.problem.isEmpty() ? "Done." : c.problem;
+            }
+            // Back to the pipelines' own settings; "apply" is separate.
+            for (var c : active.values()) {
+                try {
+                    c.module.reapplyPipelineCameraSettings();
+                } catch (Exception e) {
+                    logger.warn("Field calibration: couldn't restore " + c.name + "'s settings: " + e.getMessage());
+                }
+            }
+            if (moved || cancel) for (var c : active.values()) c.recommended.clear();
+            phase = "";
+            running = false;
+            logger.info("Field calibration: settings tuning " + result);
+        }
+    }
+
+    private int plannedSteps(Cam c, List<String> order) {
+        int n = 0;
+        if (!c.problem.isEmpty()) return 0;
+        for (String k : order) if (c.ranges.containsKey(k) && !c.locked.contains(k)) n += candidates(c, k).size();
+        return n;
+    }
+
+    /** The values to try for one control on one camera. */
+    private static List<Double> candidates(Cam c, String control) {
+        double[] r = c.ranges.get(control);
+        double min = r[0], max = r[1], def = r[2];
+        double cur = c.current.getOrDefault(control, def);
+        TreeSet<Double> v = new TreeSet<>();
+        switch (control) {
+            case "exposure" -> {
+                double base = cur > 0 ? cur : Math.max(min, (max - min) * 0.1);
+                for (double f : EXPOSURE_FACTORS) v.add((double) Math.round(clamp(base * f, Math.max(min, 1), max)));
+                // Longest first: the list is walked shortest-to-longest below, but order doesn't matter.
+            }
+            case "gain", "brightness" -> {
+                for (double d : new double[] {-20, -10, 0, 10, 20}) v.add((double) Math.round(clamp(cur + d, min, max)));
+            }
+            case "backlight" -> {
+                for (double x = min; x <= max && v.size() < 4; x += Math.max(1, Math.round((max - min) / 3))) v.add(x);
+                v.add(cur);
+            }
+            default -> {
+                v.add(min);
+                v.add((double) Math.round((min + def) / 2));
+                v.add(def);
+                v.add((double) Math.round((def + max) / 2));
+                v.add(max);
+                v.add(cur);
+            }
+        }
+        return new ArrayList<>(v);
+    }
+
+    private static double clamp(double x, double lo, double hi) {
+        return Math.max(lo, Math.min(hi, x));
+    }
+
+    /**
+     * The value to keep. Exposure: the shortest that still finds the baseline's tags as reliably as
+     * the best setting and keeps 85% of its margin. Others: the best margin among values that find
+     * the tags as reliably, but only if it beats the current value's margin by 5%.
+     */
+    private static double choose(Cam c, String control) {
+        List<StepResult> rs = c.results.stream().filter(r -> r.control.equals(control) && r.frames > 0).toList();
+        double cur = c.current.getOrDefault(control, c.ranges.get(control)[2]);
+        if (rs.isEmpty()) return cur;
+        double bestFound = rs.stream().mapToDouble(r -> r.found).max().orElse(0);
+        double bestMargin = rs.stream().mapToDouble(r -> r.margin).max().orElse(0);
+        // Does the control do anything? (Some cameras ignore gain.)
+        double bMin = rs.stream().filter(r -> r.brightness >= 0).mapToDouble(r -> r.brightness).min().orElse(-1);
+        double bMax = rs.stream().filter(r -> r.brightness >= 0).mapToDouble(r -> r.brightness).max().orElse(-1);
+        boolean noEffect =
+                bMin >= 0
+                        && bMax - bMin < 1.5
+                        && rs.stream().mapToDouble(r -> r.margin).max().orElse(0)
+                                        - rs.stream().mapToDouble(r -> r.margin).min().orElse(0)
+                                < 2;
+        if (noEffect && !control.equals("exposure")) {
+            c.notes.put(control, "no visible effect on this camera");
+            return cur;
+        }
+        if (control.equals("exposure")) {
+            return rs.stream()
+                    .filter(r -> r.found >= bestFound - 0.03 && r.margin >= 0.85 * bestMargin)
+                    .mapToDouble(r -> r.value)
+                    .min()
+                    .orElse(cur);
+        }
+        var curR = rs.stream().filter(r -> r.value == cur).findFirst().orElse(null);
+        var best = rs.stream()
+                .filter(r -> r.found >= bestFound - 0.02)
+                .max((a, b) -> Double.compare(a.margin, b.margin))
+                .orElse(null);
+        if (best == null || curR == null) return cur;
+        if (best.value != cur && best.margin > curR.margin * 1.05 && best.found >= curR.found - 0.01) return best.value;
+        return cur;
+    }
+
+    /** Writes one camera's recommendations (or every camera's, if null) into its pipeline in use, and saves. */
+    public synchronized List<String> apply(String only) {
+        if (running) throw new IllegalStateException("Tuning is still running");
+        List<String> changed = new ArrayList<>();
+        for (var c : cams.values()) {
+            if (only != null && !only.isEmpty() && !only.equals(c.name)) continue;
+            if (c.recommended.isEmpty()) continue;
+            CVPipelineSettings ps = c.module.getCurrentPipelineSettings();
+            for (var e : c.recommended.entrySet()) {
+                int v = (int) Math.round(e.getValue());
+                switch (e.getKey()) {
+                    case "exposure" -> {
+                        ps.cameraAutoExposure = false;
+                        ps.cameraExposureRaw = e.getValue();
+                    }
+                    case "gain" -> ps.cameraGain = v;
+                    case "brightness" -> ps.cameraBrightness = v;
+                    case "contrast" -> ps.cameraContrast = v;
+                    case "gamma" -> ps.cameraGamma = v;
+                    case "sharpness" -> ps.cameraSharpness = v;
+                    case "backlight" -> ps.cameraBacklightCompensation = v;
+                    default -> {}
+                }
+            }
+            c.module.reapplyPipelineCameraSettings();
+            c.module.saveAndBroadcastAll();
+            changed.add(c.name + " (pipeline " + c.module.getCurrentPipelineIndex() + ")");
+        }
+        logger.info("Field calibration: applied tuned settings to " + changed);
+        return changed;
+    }
+
+    public synchronized Map<String, Object> status() {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("running", running);
+        m.put("phase", phase);
+        m.put("stepsDone", stepsDone);
+        m.put("stepsTotal", stepsTotal);
+        m.put("result", result);
+        Map<String, Object> cm = new TreeMap<>();
+        for (var c : cams.values()) {
+            Map<String, Object> e = new LinkedHashMap<>();
+            e.put("problem", c.problem);
+            e.put("outcome", c.outcome);
+            e.put("tuning", running && active.containsKey(c.name));
+            e.put("locked", c.locked);
+            e.put("baselineTags", c.baselineTags);
+            e.put("baseline", c.baseline);
+            Map<String, Object> orig = new LinkedHashMap<>();
+            orig.put("exposure", c.original[1] > 0 ? -1 : c.original[0]); // -1: auto exposure
+            orig.put("gain", c.original[3]);
+            orig.put("brightness", c.original[2]);
+            orig.put("contrast", c.original[4]);
+            orig.put("gamma", c.original[5]);
+            orig.put("sharpness", c.original[6]);
+            orig.put("backlight", c.original[7]);
+            e.put("pipeline", orig);
+            e.put("startValues", c.startValues);
+            e.put("ranges", c.ranges);
+            e.put("recommended", c.recommended);
+            e.put("notes", c.notes);
+            e.put("results", c.results);
+            e.put("pipelineIndex", c.module.getCurrentPipelineIndex());
+            cm.put(c.name, e);
+        }
+        m.put("cameras", cm);
+        return m;
+    }
+}
