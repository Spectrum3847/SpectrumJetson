+// The angle sort, line fits, peaks and quad fits over points_bucket selected points and
+// quads_bucket quads. Leaves the number of fit quads in stage_counts_host_[1].
+absl::Status GpuDetector::EnqueueThirdStage(size_t points_bucket, size_t quads_bucket,
+                                            cudaStream_t stream) {
+  const int bucket = static_cast<int>(points_bucket);
+  const int* num_points = num_selected_blobs_device_.get();
+  {
+    IndexPoint pad;
+    pad.key = kPadKey;
+    LaunchPadTail(selected_blobs_device_.get(), num_points, points_bucket, pad, stream);
+    size_t temp_storage_bytes = radix_sort_tmpstorage_device_.size();
+    QuadIndexPointDecomposer decomposer;
+    CHECK_CUDA(cub::DeviceRadixSort::SortKeys(
