# Your team's settings for every setup script (host and Jetson). Sourced, not executed.
# Another team: change this section, then follow the README's Quick Start.

# Team number: PhotonVision's NetworkTables team, and the robot network 10.TE.AM.x.
TEAM_NUMBER=${TEAM_NUMBER:-8515}
# The Jetson's fixed address on the robot network (Ethernet). Default 10.TE.AM.15.
JETSON_STATIC_IP=${JETSON_STATIC_IP:-10.$((TEAM_NUMBER / 100)).$((TEAM_NUMBER % 100)).15}
# The laptop's saved Wi-Fi connection the Jetson joins for setup (prestage-rootfs.sh copies it).
WIFI_CONNECTION=${WIFI_CONNECTION:-spectrum3847}
# Cooling: quiet (the stock fan, NVIDIA's profile), full, or off (fanless heatsink plate: fan
# stopped, cameras capped at 60 fps from 95 C until under 88 C; README "Fanless"). It's also on
# Settings > Robot state, and saved on the Jetson. Empty keeps the Jetson's choice; a fresh install
# with it empty is fanless (ours, sealed under the plate). With the stock heatsink and fan, set
# FAN=quiet before installing, or choose "Fan" on the Settings page afterwards.
FAN=${FAN:-}
# SSH key the laptop uses for the Jetson (prestage-rootfs.sh puts the .pub half in the image).
KEY=${KEY:-$HOME/.ssh/jetson_ed25519}

# Jetson Linux (L4T) release. JetPack 7.2.1 = L4T 39.2.1: Ubuntu 24.04 target (glibc 2.39, which
# WPILib 2027's ARM libraries need), kernel 6.8, CUDA 13.2.2, TensorRT 10.16.2. The flash host is
# still Ubuntu 22.04 (or 20.04). L4T_VERSION=36.5.2 is the previous one (JetPack 6.2.3, Ubuntu 22.04
# target), which the 2026 PhotonVision patch stack runs on. NVIDIA capitalized the names from r38 on.
L4T_VERSION=${L4T_VERSION:-39.2.1}
if [[ $L4T_VERSION == 36.* ]]; then
  L4T_URL_BASE=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v5.2/releases
  L4T_BSP_TARBALL=Jetson_Linux_r${L4T_VERSION}_aarch64.tbz2
  L4T_ROOTFS_TARBALL=Tegra_Linux_Sample-Root-Filesystem_r${L4T_VERSION}_aarch64.tbz2
else
  L4T_URL_BASE=https://developer.nvidia.com/downloads/embedded/L4T/r39_Release_v2.1/release
  L4T_BSP_TARBALL=Jetson_Linux_R${L4T_VERSION}_aarch64.tbz2
  L4T_ROOTFS_TARBALL=Tegra_Linux_Sample-Root-Filesystem_R${L4T_VERSION}_aarch64.tbz2
fi

# Where tarballs are downloaded and Linux_for_Tegra is extracted (outside the repo).
L4T_WORKDIR=${L4T_WORKDIR:-$HOME/nvidia/r${L4T_VERSION}}
L4T_DIR=$L4T_WORKDIR/Linux_for_Tegra

# Orin Nano 8GB (P3767-0005) on the P3768 devkit carrier, Super power modes.
BOARD=jetson-orin-nano-devkit-super

# USB ID of an Orin Nano in Force Recovery Mode.
RCM_USB_ID=0955:7523

# Default user baked into the image so first boot skips oem-config.
# The password is always prompted for, never stored here.
JETSON_USER=${JETSON_USER:-spectrum3847}
JETSON_HOSTNAME=${JETSON_HOSTNAME:-photonvision-3847}
