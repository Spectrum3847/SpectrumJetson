+
+package org.photonvision.common.hardware.metrics;
+
+import io.avaje.jsonb.JsonType;
+import io.avaje.jsonb.Jsonb;
+import io.avaje.jsonb.Types;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import org.photonvision.PhotonVersion;
+import org.photonvision.common.configuration.ConfigManager;
+import org.photonvision.common.dataflow.networktables.NetworkTablesManager;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+import org.photonvision.common.util.TimedTaskManager;
+import org.photonvision.vision.target.ExcludedTags;
+import org.wpilib.networktables.PubSubOption;
+import org.wpilib.networktables.StringPublisher;
+import org.wpilib.vision.camera.CameraServerJNI;
+
+/**
+ * SpectrumJetson (photonvision-24): the Jetson-wide settings on NetworkTables as one JSON string,
+ * /photonvision/jetson/settingsJson, rebuilt every 5 s, for the robot log. It holds the build,
+ * Spectrum runtime settings, excluded tags, field-layout information, and the USB payload cap.
+ */
+public final class JetsonSettingsPublisher {
+    private static final Logger logger = new Logger(JetsonSettingsPublisher.class, LogGroup.General);
+    private static final Jsonb jsonb = Jsonb.instance();
+    private static final JsonType<Map<String, Object>> mapJson =
+            jsonb.type(Types.mapOf(Object.class));
+    private static JetsonSettingsPublisher instance;
+    private static volatile Map<String, Object> latest = null;
+
+    public static synchronized void start() {
+        if (instance == null) instance = new JetsonSettingsPublisher();
+    }
+
+    /** The latest snapshot, or null before the first one, for Rewind's session.json. */
+    public static Map<String, Object> snapshot() {
+        return latest;
+    }
+
+    private final StringPublisher publisher;
+    private boolean loggedFailure = false;
+
+    private JetsonSettingsPublisher() {
+        publisher =
+                NetworkTablesManager.getInstance()
+                        .getNTInst()
+                        .getTable("photonvision")
+                        .getSubTable("jetson")
+                        .getStringTopic("settingsJson")
+                        .publish(PubSubOption.IGNORE_DUPLICATES);
+        TimedTaskManager.getInstance().addTask("JetsonSettings", this::publish, 2000, 5000);
+    }
+
+    private void publish() {
+        try {
+            Map<String, Object> root = new LinkedHashMap<>();
+            root.put("photonVersion", PhotonVersion.versionString);
+            root.put("buildDate", PhotonVersion.buildDate);
+            root.put("hostname", CameraServerJNI.getHostname());
+
+            Map<String, Object> environment = new LinkedHashMap<>();
+            new TreeMap<>(System.getenv())
+                    .forEach((key, value) -> {
+                        if (key.startsWith("SPECTRUM_")) environment.put(key, value);
+                    });
+            root.put("environment", environment);
+
+            Map<String, Object> overrides = new LinkedHashMap<>();
+            for (String file : new String[] {"/tmp/spectrum-jpeg-decoder", "/tmp/spectrum-971-cuda-sync"}) {
+                String value = read(Path.of(file));
+                if (value != null) overrides.put(file, value);
+            }
+            root.put("runtimeOverrides", overrides);
+
+            List<Integer> tags = new ArrayList<>(ExcludedTags.getInstance().active());
+            root.put("excludedTags", tags);
+
+            var layout = ConfigManager.getInstance().getConfig().getFieldLayout();
+            if (layout != null) {
+                Map<String, Object> fieldLayout = new LinkedHashMap<>();
+                fieldLayout.put("tags", layout.getTags().size());
+                fieldLayout.put("lengthM", layout.getFieldLength());
+                fieldLayout.put("widthM", layout.getFieldWidth());
+                fieldLayout.put("fingerprint", fingerprint(jsonb.toJson(layout.getTags())));
+                root.put("fieldLayout", fieldLayout);
+            }
+
+            String cap = read(Path.of("/sys/module/uvcvideo/parameters/payload_cap"));
+            if (cap != null) root.put("uvcPayloadCap", cap);
+
+            latest = root;
+            publisher.set(mapJson.toJson(root));
+            loggedFailure = false;
+        } catch (Exception e) {
+            if (!loggedFailure) logger.warn("Could not publish Jetson settings: " + e);
+            loggedFailure = true;
+        }
+    }
+
+    /** First 12 hex characters of a SHA-256, enough to tell layouts apart in a log. */
+    private static String fingerprint(String value) throws Exception {
+        var digest = MessageDigest.getInstance("SHA-256");
+        return HexFormat.of().formatHex(digest.digest(value.getBytes(StandardCharsets.UTF_8))).substring(0, 12);
+    }
+
+    private static String read(Path path) {
+        try {
+            return Files.exists(path) ? Files.readString(path).strip() : null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/photon-core/src/main/java/org/photonvision/common/hardware/metrics/JetsonTelemetry.java b/photon-core/src/main/java/org/photonvision/common/hardware/metrics/JetsonTelemetry.java
