diff --git a/photon-client/src/components/fieldcal/FieldCalMap.vue b/photon-client/src/components/fieldcal/FieldCalMap.vue
new file mode 100644
index 00000000..b70eea25
--- /dev/null
+++ b/photon-client/src/components/fieldcal/FieldCalMap.vue
@@ -0,0 +1,211 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-30): the field from above for the field-calibration page. Tags are
+// coloured by how many still spots have seen them; live cameras, captured spots, the suggested
+// next spot, and (on results) each tag's solved offset, exaggerated so centimetres show.
+import { computed } from "vue";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+import type { MapCamera, MapOffset, MapPoint, MapSuggestion } from "@/types/FieldCalTypes";
+
+const props = defineProps<{
+  layout: AprilTagFieldLayout;
+  tagSpots?: Record<string, number>;
+  inView?: number[];
+  cameras?: MapCamera[];
+  spots?: MapPoint[];
+  suggestion?: MapSuggestion | null;
+  offsets?: Record<string, MapOffset>;
+  focusSeen?: boolean;
+}>();
+
+const OFFSET_SCALE = 10; // 1 cm drawn as 10 cm
+
+const yawOf = (q: { W: number; X: number; Y: number; Z: number }) =>
+  Math.atan2(2 * (q.W * q.Z + q.X * q.Y), 1 - 2 * (q.Y * q.Y + q.Z * q.Z));
+
+const W = computed(() => props.layout.field.width);
+const L = computed(() => props.layout.field.length);
+
+const tags = computed(() =>
+  props.layout.tags.map((t) => ({
+    id: t.ID,
+    x: t.pose.translation.x,
+    y: t.pose.translation.y,
+    yaw: yawOf(t.pose.rotation.quaternion),
+    spots: props.tagSpots?.[String(t.ID)] ?? 0
+  }))
+);
+
+// With focusSeen, zoom to the tags seen so far (the part of the field in use), plus a margin.
+const view = computed(() => {
+  let x0 = 0,
+    y0 = 0,
+    x1 = L.value,
+    y1 = W.value;
+  const seen = tags.value.filter((t) => t.spots > 0 || props.inView?.includes(t.id) || props.offsets?.[String(t.id)]);
+  if (props.focusSeen && seen.length >= 2) {
+    x0 = Math.max(0, Math.min(...seen.map((t) => t.x)) - 2);
+    x1 = Math.min(L.value, Math.max(...seen.map((t) => t.x)) + 2);
+    y0 = Math.max(0, Math.min(...seen.map((t) => t.y)) - 2);
+    y1 = Math.min(W.value, Math.max(...seen.map((t) => t.y)) + 2);
+  }
+  return { x0, y0, x1, y1 };
+});
+const viewBox = computed(() => {
+  const v = view.value;
+  // SVG y points down: field y = W at the top.
+  return `${v.x0 - 0.4} ${W.value - v.y1 - 0.4} ${v.x1 - v.x0 + 0.8} ${v.y1 - v.y0 + 0.8}`;
+});
+const sy = (y: number) => W.value - y;
+
+const tagColor = (t: { id: number; spots: number }) => {
+  if (props.offsets) {
+    const o = props.offsets[String(t.id)];
+    return o ? (o.moved ? "#e53935" : "#43a047") : "#9e9e9e";
+  }
+  if (t.spots >= 2) return "#43a047";
+  if (t.spots === 1) return "#fb8c00";
+  return props.inView?.includes(t.id) ? "#1e88e5" : "#9e9e9e";
+};
+</script>
+
+<template>
+  <svg :viewBox="viewBox" class="fieldcal-map" preserveAspectRatio="xMidYMid meet">
+    <rect :x="0" :y="0" :width="L" :height="W" class="field" />
+    <line :x1="L / 2" :y1="0" :x2="L / 2" :y2="W" class="midline" />
+
+    <!-- captured spots -->
+    <g v-for="(s, i) in spots ?? []" :key="'s' + i">
+      <circle :cx="s.x" :cy="sy(s.y)" r="0.16" class="spot" />
+      <text :x="s.x" :y="sy(s.y) + 0.09" class="spot-label">{{ s.label ?? i + 1 }}</text>
+    </g>
+
+    <!-- tags: the face, and a tick pointing the way it faces -->
+    <g v-for="t in tags" :key="t.id">
+      <line
+        :x1="t.x + 0.22 * Math.sin(t.yaw)"
+        :y1="sy(t.y - 0.22 * Math.cos(t.yaw))"
+        :x2="t.x - 0.22 * Math.sin(t.yaw)"
+        :y2="sy(t.y + 0.22 * Math.cos(t.yaw))"
+        :stroke="tagColor(t)"
+        stroke-width="0.12"
+        stroke-linecap="round"
+      />
+      <line
+        :x1="t.x"
+        :y1="sy(t.y)"
+        :x2="t.x + 0.3 * Math.cos(t.yaw)"
+        :y2="sy(t.y + 0.3 * Math.sin(t.yaw))"
+        :stroke="tagColor(t)"
+        stroke-width="0.05"
+      />
+      <circle v-if="inView?.includes(t.id)" :cx="t.x" :cy="sy(t.y)" r="0.35" class="in-view" />
+      <text :x="t.x + 0.6 * Math.cos(t.yaw)" :y="sy(t.y + 0.6 * Math.sin(t.yaw)) + 0.1" class="tag-label">
+        {{ t.id }}
+      </text>
+      <!-- solved offset (results) -->
+      <line
+        v-if="offsets?.[String(t.id)]"
+        :x1="t.x"
+        :y1="sy(t.y)"
+        :x2="t.x + (offsets[String(t.id)].dxCm / 100) * OFFSET_SCALE"
+        :y2="sy(t.y + (offsets[String(t.id)].dyCm / 100) * OFFSET_SCALE)"
+        :stroke="offsets[String(t.id)].moved ? '#e53935' : '#43a047'"
+        stroke-width="0.06"
+        marker-end="url(#fc-arrow)"
+      />
+    </g>
+
+    <!-- the suggested next spot -->
+    <g v-if="suggestion" class="suggestion">
+      <line
+        :x1="suggestion.x"
+        :y1="sy(suggestion.y)"
+        :x2="suggestion.faceX"
+        :y2="sy(suggestion.faceY)"
+        stroke="#8e24aa"
+        stroke-width="0.05"
+        stroke-dasharray="0.15 0.1"
+      />
+      <circle :cx="suggestion.x" :cy="sy(suggestion.y)" r="0.45" class="suggest-ring" />
+      <text :x="suggestion.x" :y="sy(suggestion.y) + 0.12" class="suggest-label">next</text>
+    </g>
+
+    <!-- live cameras: where each is and which way it looks -->
+    <g v-for="c in (cameras ?? []).filter((c) => c.pose)" :key="c.name">
+      <line
+        :x1="c.pose![0]"
+        :y1="sy(c.pose![1])"
+        :x2="c.pose![0] + 0.7 * Math.cos(c.pose![2])"
+        :y2="sy(c.pose![1] + 0.7 * Math.sin(c.pose![2]))"
+        stroke="#00acc1"
+        stroke-width="0.07"
+        marker-end="url(#fc-arrow-cam)"
+      />
+      <circle :cx="c.pose![0]" :cy="sy(c.pose![1])" r="0.12" fill="#00acc1" />
+    </g>
+
+    <defs>
+      <marker id="fc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
+        <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
+      </marker>
+      <marker id="fc-arrow-cam" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto">
+        <path d="M0,0 L10,5 L0,10 z" fill="#00acc1" />
+      </marker>
+    </defs>
+  </svg>
+</template>
+
+<style scoped>
+.fieldcal-map {
+  width: 100%;
+  max-height: 60vh;
+  background: rgba(127, 127, 127, 0.06);
+  border-radius: 8px;
+}
+.field {
+  fill: rgba(76, 175, 80, 0.07);
+  stroke: rgba(127, 127, 127, 0.8);
+  stroke-width: 0.04;
+}
+.midline {
+  stroke: rgba(127, 127, 127, 0.4);
+  stroke-width: 0.03;
+  stroke-dasharray: 0.2 0.15;
+}
+.tag-label {
+  font-size: 0.3px;
+  text-anchor: middle;
+  fill: currentColor;
+}
+.in-view {
+  fill: none;
+  stroke: #1e88e5;
+  stroke-width: 0.04;
+}
+.spot {
+  fill: rgba(33, 150, 243, 0.25);
+  stroke: #1e88e5;
+  stroke-width: 0.03;
+}
+.spot-label {
+  font-size: 0.2px;
+  text-anchor: middle;
+  fill: currentColor;
+}
+.suggest-ring {
+  fill: rgba(142, 36, 170, 0.15);
+  stroke: #8e24aa;
+  stroke-width: 0.05;
+  animation: pulse 1.2s ease-in-out infinite;
+}
+.suggest-label {
+  font-size: 0.28px;
+  text-anchor: middle;
+  fill: #8e24aa;
+}
+@keyframes pulse {
+  50% {
+    opacity: 0.4;
+  }
+}
+</style>
