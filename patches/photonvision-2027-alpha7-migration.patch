+        if (tuner.running()) throw new IllegalStateException("Camera settings tuning is running");
+        resetLive();
+        RewindManager.getInstance().setManual(true, LABEL);
+        session = RewindManager.getInstance().currentSessionName();
+        state = State.RECORDING;
