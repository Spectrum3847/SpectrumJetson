 #include "cuda_runtime.h"
 #include "device_launch_parameters.h"
 
+#include <exception>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace frc::apriltag {
+
+// SpectrumJetson: a failed CUDA call throws CudaError instead of LOG(FATAL), so
+// the JNI caller can skip the frame (or rebuild the detector) rather than
+// aborting the whole JVM. Destructors use LOG_IF_CUDA_ERROR (a throw there
+// would std::terminate).
+class CudaError : public std::runtime_error {
+ public:
+  CudaError(const std::string &what, cudaError_t error)
+      : std::runtime_error(what), error_(error) {}
+  cudaError_t error() const { return error_; }
+
+ private:
+  cudaError_t error_;
+};
+
+// Collects the streamed message; throws when the full-expression ends.
+class CudaErrorThrower {
+ public:
+  CudaErrorThrower(const char *expr, cudaError_t error, const char *file, int line)
+      : error_(error) {
+    os_ << file << ":" << line << " Check failed: " << expr << " ("
+        << cudaGetErrorString(error) << ") ";
+  }
+  ~CudaErrorThrower() noexcept(false) {
+    if (std::uncaught_exceptions() == 0) throw CudaError(os_.str(), error_);
+  }
+  template <typename T>
+  CudaErrorThrower &operator<<(const T &value) {
+    os_ << value;
+    return *this;
+  }
+
+ private:
+  std::ostringstream os_;
+  cudaError_t error_;
+};
+
+}  // namespace frc::apriltag
+
 // CHECKs that a cuda method returned success.
 // TODO(austin): This will not handle if and else statements quite right, fix if
 // we care.
-#define CHECK_CUDA(condition)                                             \
-  if (auto c = condition)                                                 \
-  LOG(FATAL) << "Check failed: " #condition " (" << cudaGetErrorString(c) \
-             << ") "
+#define CHECK_CUDA(condition)                              \
+  if (cudaError_t spectrum_cuda_error_ = (condition))      \
+  ::frc::apriltag::CudaErrorThrower(#condition, spectrum_cuda_error_, __FILE__, \
+                                    __LINE__)
+
+// Non-throwing variant for destructors.
+#define LOG_IF_CUDA_ERROR(condition)                                \
+  if (cudaError_t spectrum_cuda_error_ = (condition))               \
+  LOG(ERROR) << "CUDA call failed: " #condition " ("                 \
+             << cudaGetErrorString(spectrum_cuda_error_) << ") "
 
