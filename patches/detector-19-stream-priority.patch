index bce3c1b..9a25225 100644
--- a/third_party/971apriltag/cuda.h
+++ b/third_party/971apriltag/cuda.h
@@ -2,6 +2,8 @@
 #define FRC_ORIN_CUDA_H_
 
 #include <chrono>
+#include <cstdlib>
+#include <cstring>
 #include <span>
 
 #include "absl/log/check.h"
@@ -77,7 +79,19 @@ class CudaEvent;
 // relative ordering between kernels on the same stream.
 class CudaStream {
  public:
-  CudaStream() { CHECK_CUDA(cudaStreamCreate(&stream_)); }
+  // SpectrumJetson (detector-19): SPECTRUM_TAG_STREAM_PRIORITY=high creates the detector's streams
+  // at the GPU's highest priority, so its kernels go ahead of queued TensorRT object-detection
+  // work (libspectrumtrt.so uses the lowest). Unset (the default): cudaStreamCreate, as before.
+  CudaStream() {
+    const char *p = getenv("SPECTRUM_TAG_STREAM_PRIORITY");
+    if (p != nullptr && strcmp(p, "high") == 0) {
+      int least = 0, greatest = 0;
+      CHECK_CUDA(cudaDeviceGetStreamPriorityRange(&least, &greatest));
+      CHECK_CUDA(cudaStreamCreateWithPriority(&stream_, cudaStreamDefault, greatest));
+    } else {
+      CHECK_CUDA(cudaStreamCreate(&stream_));
+    }
+  }
 
   CudaStream(const CudaStream&) = delete;
   CudaStream& operator=(const CudaStream&) = delete;
