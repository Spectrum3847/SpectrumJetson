+
+package org.photonvision.vision.processes;
+
+import io.avaje.json.JsonException;
+import io.avaje.jsonb.Json;
+import io.avaje.jsonb.JsonType;
+import io.avaje.jsonb.Jsonb;
+import java.io.IOException;
+import java.lang.management.ManagementFactory;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.photonvision.common.dataflow.networktables.NetworkTablesManager;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+
+/**
+ * SpectrumJetson (photonvision-49): while connected to a robot that is disabled, each camera
+ * processes at most idleFps frames a second (default 30, or SPECTRUM_IDLE_FPS; switched off or
+ * changed from Settings > Robot state, photonvision-50). The frames in between
+ * are never grabbed, so neither the JPEG decode nor the detector runs for them: less power and
+ * heat between matches, and 30 results a second is still plenty to seed the pose before auto. Full
+ * rate again within 5 ms of enable. Off the robot (no NetworkTables connection) nothing changes,
+ * so bench tests and tuning see every frame.
+ *
+ * <p>Also runs a full garbage collection 0.5 s after each enabled-to-disabled transition, so the
+ * heap is clean going into the next match instead of collecting during it.
+ */
+public final class IdleMode {
+    private static final Logger logger = new Logger(IdleMode.class, LogGroup.VisionModule);
+    private static volatile boolean listening = false;
+
+    /**
+     * Saved in /opt/photonvision/spectrum-robot-state.json (photonvision-50), set from Settings >
+     * Robot state or the dashboard's "Full speed" button. SPECTRUM_IDLE_FPS is only the default.
+     */
+    @Json
+    public static class Settings {
+        public boolean idleWhileDisabled = true;
+        public double idleFps = readFps();
+        /** photonvision-51: switch every camera to eventPipeline when the FMS connects. */
+        public boolean eventProfileOnFms = false;
+        public int eventPipeline = 0;
+        /** photonvision-55: full-size searches for far tags while no camera has a good view. */
+        public boolean farSearch = true;
+        public double farSweepsPerSecond = 30;
+        /** photonvision-56: stop writing to the SSD once a match ends... */
+        public boolean quietAfterMatch = true;
+        /** ...or after this long disabled (0 = never). */
+        public int quietAfterDisabledSeconds = 60;
+    }
+
+    private static final Path SETTINGS_FILE = Path.of("/opt/photonvision/spectrum-robot-state.json");
+    private static final JsonType<Settings> json = Jsonb.instance().type(Settings.class);
+    private static volatile Settings settings = load();
+    private static volatile long periodNanos = period(settings);
+
+    private IdleMode() {}
+
+    private static double readFps() {
+        String env = System.getenv("SPECTRUM_IDLE_FPS");
+        if (env == null || env.isBlank()) return 30;
+        try {
+            return Math.max(0, Double.parseDouble(env.trim()));
+        } catch (NumberFormatException e) {
+            return 30;
+        }
+    }
+
+    private static Settings load() {
+        try {
+            if (Files.exists(SETTINGS_FILE)) return json.fromJson(Files.readString(SETTINGS_FILE));
+        } catch (IOException | JsonException e) {
+            logger.error("Couldn't read " + SETTINGS_FILE + "; using the defaults", e);
+        }
+        return new Settings();
+    }
+
+    private static long period(Settings s) {
+        return s.idleWhileDisabled && s.idleFps > 0 ? (long) (1e9 / s.idleFps) : 0;
+    }
+
+    public static Settings getSettings() {
+        return settings;
+    }
+
+    /** Changes and saves the settings; null leaves a field as it is. */
+    public static synchronized Settings update(
+            Boolean idleWhileDisabled, Double idleFps, Boolean eventProfileOnFms, Integer eventPipeline) {
+        return update(idleWhileDisabled, idleFps, eventProfileOnFms, eventPipeline, null, null);
+    }
+
+    public static synchronized Settings update(
+            Boolean idleWhileDisabled,
+            Double idleFps,
+            Boolean eventProfileOnFms,
+            Integer eventPipeline,
+            Boolean farSearch,
+            Double farSweepsPerSecond) {
+        return update(idleWhileDisabled, idleFps, eventProfileOnFms, eventPipeline, farSearch, farSweepsPerSecond, null, null);
+    }
+
+    public static synchronized Settings update(
+            Boolean idleWhileDisabled,
+            Double idleFps,
+            Boolean eventProfileOnFms,
+            Integer eventPipeline,
+            Boolean farSearch,
+            Double farSweepsPerSecond,
+            Boolean quietAfterMatch,
+            Integer quietAfterDisabledSeconds) {
+        var s = new Settings();
+        s.quietAfterMatch = quietAfterMatch != null ? quietAfterMatch : settings.quietAfterMatch;
+        s.quietAfterDisabledSeconds =
+                quietAfterDisabledSeconds != null
+                        ? Math.max(0, Math.min(3600, quietAfterDisabledSeconds))
+                        : settings.quietAfterDisabledSeconds;
+        s.idleWhileDisabled = idleWhileDisabled != null ? idleWhileDisabled : settings.idleWhileDisabled;
+        s.idleFps = idleFps != null ? Math.max(1, Math.min(120, idleFps)) : settings.idleFps;
+        s.eventProfileOnFms = eventProfileOnFms != null ? eventProfileOnFms : settings.eventProfileOnFms;
+        s.eventPipeline = eventPipeline != null ? Math.max(0, eventPipeline) : settings.eventPipeline;
+        s.farSearch = farSearch != null ? farSearch : settings.farSearch;
+        s.farSweepsPerSecond =
+                farSweepsPerSecond != null ? Math.max(1, Math.min(120, farSweepsPerSecond)) : settings.farSweepsPerSecond;
+        settings = s;
+        periodNanos = period(s);
+        farSearchApplied = false;
+        farSearchNextTryMs = 0;
+        applyFarSearch();
+        try {
+            Files.writeString(SETTINGS_FILE, json.toJson(s));
+        } catch (IOException e) {
+            logger.error("Couldn't save " + SETTINGS_FILE, e);
+        }
+        logger.info(
+                s.idleWhileDisabled
+                        ? "Idle mode on: " + s.idleFps + " fps per camera while the robot is disabled"
+                        : "Idle mode off: full speed while the robot is disabled");
+        logger.info(
+                s.eventProfileOnFms
+                        ? "Event profile: every camera to pipeline " + s.eventPipeline + " when the FMS connects"
+                        : "Event profile off");
+        return s;
+    }
+
+    /** True while frames should be limited: a robot is connected and disabled. */
+    // photonvision-55: hand the far-search settings to the detector library once it's loaded.
+    private static volatile boolean farSearchApplied = false;
+
+    private static volatile long farSearchNextTryMs = 0;
+
+    private static void applyFarSearch() {
+        if (farSearchApplied) return;
+        // At most every 5 s: a missing native method throws, and this runs on every frame.
+        long now = System.currentTimeMillis();
+        if (now < farSearchNextTryMs) return;
+        farSearchNextTryMs = now + 5000;
+        try {
+            org.photonvision.jni.GpuDetectorJNI.setFarSearch(settings.farSearch, settings.farSweepsPerSecond);
+            farSearchApplied = true;
+        } catch (UnsatisfiedLinkError | NoClassDefFoundError e) {
+            // Library not loaded yet (or an older one without the far search): try again later.
+        }
+    }
+
+    /** The far search's counters, or null without a detector library that has it. */
+    public static double[] farSearchStatus() {
+        try {
+            return org.photonvision.jni.GpuDetectorJNI.farSearchStatus();
+        } catch (UnsatisfiedLinkError | NoClassDefFoundError e) {
+            return null;
+        }
+    }
+
+    /** True while frames are limited: idle (a disabled robot), or the thermal limit. */
+    public static boolean active() {
+        if (!farSearchApplied) applyFarSearch();
+        if (!listening) startListening(); // the GC on disable runs with idle off too
+        return idleNow() || thermalLimitNow();
+    }
+
+    /** Idle: a robot is connected and disabled (and idle mode is on). */
+    private static boolean idleNow() {
+        if (periodNanos == 0) return false;
+        var ntm = NetworkTablesManager.getInstance();
+        if (!ntm.getNTInst().isConnected()) return false;
+        var ds = ntm.getDriverStation();
+        return ds != null && !ds.current().m_enabled();
+    }
+
+    /**
+     * photonvision-57: the thermal limit. On a fanless heatsink (09-robot-tuning.sh FAN=off),
+     * spectrum-fan-guard sets /run/spectrum-thermal-limit when the chip reaches 95 C and clears it
+     * below 88 C. While it's set every camera is capped at THERMAL_FPS, enabled or not: far better
+     * than the chip throttling itself at 99 C or shutting down at 104 C. Checked twice a second.
+     */
+    private static final java.nio.file.Path THERMAL_FLAG = java.nio.file.Path.of("/run/spectrum-thermal-limit");
+
+    public static final double THERMAL_FPS = 60;
+    private static final long THERMAL_PERIOD_NANOS = (long) (1e9 / THERMAL_FPS);
+    private static volatile boolean thermal = false;
+    private static volatile long thermalCheckedMs = 0;
+
+    public static boolean thermalLimitNow() {
+        long now = System.currentTimeMillis();
+        if (now - thermalCheckedMs > 500) {
+            thermalCheckedMs = now;
+            boolean was = thermal;
+            thermal = Files.exists(THERMAL_FLAG);
+            if (thermal != was) {
+                if (thermal) logger.warn("Thermal limit: every camera capped at " + THERMAL_FPS + " fps until the chip cools");
+                else logger.info("Thermal limit lifted: full frame rate");
+            }
+        }
+        return thermal;
+    }
+
+    /** The frame period now: idle's, else the thermal limit's, else 0 (no limit). */
+    public static long periodNanos() {
+        if (idleNow()) return periodNanos;
+        if (thermalLimitNow()) return THERMAL_PERIOD_NANOS;
+        return 0;
+    }
+
+    /**
+     * Sleeps until {@code lastGrabNanos + period} while idle; returns early (within 5 ms) if the
+     * robot is enabled. Returns false if interrupted.
+     */
+    public static boolean waitForNextFrame(long lastGrabNanos) {
+        while (active()) {
+            long waitNanos = lastGrabNanos + periodNanos() - System.nanoTime();
+            if (waitNanos <= 0) break;
+            try {
+                Thread.sleep(Math.max(1, Math.min(5, waitNanos / 1_000_000)));
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** For Settings > Robot state and the dashboard (photonvision-50). */
+    public static java.util.Map<String, Object> status() {
+        var ntm = NetworkTablesManager.getInstance();
+        var ds = ntm.getDriverStation();
+        var word = ds == null ? null : ds.current();
+        boolean connected = ntm.getNTInst().isConnected();
+        var m = new java.util.HashMap<String, Object>();
+        m.put("idleWhileDisabled", settings.idleWhileDisabled);
+        m.put("idleFps", settings.idleFps);
+        m.put("robotConnected", connected);
+        m.put("enabled", connected && word != null && word.m_enabled());
+        m.put("autonomous", connected && word != null && word.m_autonomous());
+        m.put("fmsAttached", connected && word != null && word.m_fmsAttached());
+        m.put("idleNow", idleNow());
+        m.put("thermalLimitNow", thermalLimitNow()); // photonvision-57
+        m.put("thermalLimitFps", THERMAL_FPS);
+        m.put("eventProfileOnFms", settings.eventProfileOnFms);
+        m.put("eventPipeline", settings.eventPipeline);
+        m.put("lastEventSwitch", lastEventSwitch);
+        m.put("farSearch", settings.farSearch);
+        m.put("farSweepsPerSecond", settings.farSweepsPerSecond);
+        m.put("quietAfterMatch", settings.quietAfterMatch);
+        m.put("quietAfterDisabledSeconds", settings.quietAfterDisabledSeconds);
+        m.putAll(QuietMode.status());
+        var far = farSearchStatus();
+        if (far != null && far.length >= 8) {
+            m.put("farSearchStarved", far[1] > 0);
+            m.put("farSearchSweeps", (long) far[2]);
+            m.put("farSearchCrops", (long) far[3]);
+            m.put("farSearchTags", (long) far[4]);
+            m.put("farSearchStarvedSeconds", far[5]);
+            m.put("farSearchSweepMs", far[2] > 0 ? far[6] / far[2] : 0);
+        }
+        return m;
+    }
+
+    private static synchronized void startListening() {
+        if (listening) return;
+        var ds = NetworkTablesManager.getInstance().getDriverStation();
+        if (ds == null) return;
+        listening = true;
+        QuietMode.start(); // photonvision-56
+        logger.info(
+                periodNanos > 0
+                        ? "Idle mode: " + settings.idleFps + " fps per camera while the robot is disabled"
+                        : "Idle mode off: full speed while the robot is disabled");
+        ds.addTransitionListener(
+                (old, now) -> {
+                    // photonvision-51: once, as the FMS connects; anything after that (the
+                    // dashboard, robot code) is left alone.
+                    if (!old.m_fmsAttached() && now.m_fmsAttached() && settings.eventProfileOnFms) {
+                        switchAllTo(settings.eventPipeline, "the field (FMS) connected");
+                    }
+                    // photonvision-53: a snapshot of the settings the first time the field connects
+                    // each day, off this (NetworkTables) thread.
+                    if (!old.m_fmsAttached() && now.m_fmsAttached()) {
+                        new Thread(
+                                        () -> {
+                                            try {
+                                                if (!org.photonvision.common.configuration.SettingsSnapshots.fieldSnapshotToday()) {
+                                                    org.photonvision.common.configuration.SettingsSnapshots.create(
+                                                            "Field connected " + java.time.LocalDate.now(), "field connected");
+                                                }
+                                            } catch (Exception e) {
+                                                logger.error("Couldn't take the field-connected snapshot", e);
+                                            }
+                                        },
+                                        "SpectrumFieldSnapshot")
+                                .start();
+                    }
+                    if (old.m_enabled() && !now.m_enabled()) {
+                        var gc =
+                                new Thread(
+                                        () -> {
+                                            try {
+                                                Thread.sleep(500);
+                                            } catch (InterruptedException e) {
+                                                return;
+                                            }
+                                            collect();
+                                        },
+                                        "SpectrumGcWhileDisabled");
+                        gc.setDaemon(true);
+                        gc.start();
+                    }
+                });
+    }
+
+    private static volatile String lastEventSwitch = "";
+
+    /**
+     * photonvision-51: every camera that has pipeline {@code index} to it, skipping cameras in
+     * driver mode, calibrating or focusing (as the dashboard's Switch all does). Returns and
+     * remembers a one-line summary.
+     */
+    public static synchronized String switchAllTo(int index, String why) {
+        var switched = new java.util.ArrayList<String>();
+        var skipped = new java.util.ArrayList<String>();
+        // The name most cameras have at this number; a camera with another name there is named
+        // in the summary, as Switch all on the dashboard does (a profile at mismatched numbers).
+        var nameCounts = new java.util.HashMap<String, Integer>();
+        for (var module : VisionSourceManager.getInstance().vmm.getModules()) {
+            var names = module.pipelineManager.getPipelineNicknames();
+            if (names.size() > index) nameCounts.merge(names.get(index), 1, Integer::sum);
+        }
+        String usual =
+                nameCounts.entrySet().stream().max(java.util.Map.Entry.comparingByValue()).map(java.util.Map.Entry::getKey).orElse("");
+        for (var module : VisionSourceManager.getInstance().vmm.getModules()) {
+            String name = module.visionSource.getSettables().getConfiguration().nickname;
+            int current = module.pipelineManager.getRequestedIndex();
+            if (current == -1) skipped.add(name + " (driver mode)");
+            else if (current < -1) skipped.add(name + " (calibrating or focusing)");
+            else if (module.pipelineManager.getPipelineNicknames().size() <= index)
+                skipped.add(name + " (no pipeline " + index + ")");
+            else {
+                if (current != index) {
+                    module.setPipeline(index);
+                    module.saveAndBroadcastAll();
+                }
+                String theirs = module.pipelineManager.getPipelineNicknames().get(index);
+                switched.add(theirs.equals(usual) ? name : name + " (its " + index + " is '" + theirs + "')");
+            }
+        }
+        String summary =
+                java.time.LocalTime.now().withNano(0)
+                        + ": "
+                        + why
+                        + ", pipeline "
+                        + index
+                        + ": "
+                        + (switched.isEmpty() ? "no camera switched" : "switched " + String.join(", ", switched))
+                        + (skipped.isEmpty() ? "" : "; not switched: " + String.join(", ", skipped));
+        lastEventSwitch = summary;
+        logger.info("Event profile: " + summary);
+        return summary;
+    }
+
+    private static void collect() {
+        var mem = ManagementFactory.getMemoryMXBean();
+        long before = mem.getHeapMemoryUsage().getUsed();
+        long start = System.nanoTime();
+        System.gc();
+        long ms = (System.nanoTime() - start) / 1_000_000;
+        long after = mem.getHeapMemoryUsage().getUsed();
+        logger.info(
+                String.format(
+                        "Robot disabled: garbage collected in %d ms, heap %d -> %d MB",
+                        ms, before >> 20, after >> 20));
+    }
+}
diff --git a/photon-core/src/main/java/org/photonvision/vision/processes/MountEstimatePublisher.java b/photon-core/src/main/java/org/photonvision/vision/processes/MountEstimatePublisher.java
