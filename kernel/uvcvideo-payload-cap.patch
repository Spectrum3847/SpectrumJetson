+/*
+ * SpectrumJetson: the payload_cap module parameter's cap for this camera, or 0:
+ * its USB port's entry (e.g. "1-2.4:944") if there is one, else its model's.
+ */
+static u32 uvc_payload_cap(struct uvc_streaming *stream)
+{
+	const char *p, *port = dev_name(&stream->dev->udev->dev);
+	size_t n = strlen(port);
+	u16 vid = le16_to_cpu(stream->dev->udev->descriptor.idVendor);
+	u16 pid = le16_to_cpu(stream->dev->udev->descriptor.idProduct);
+	long by_port = -1;
+	u32 by_id = 0;
+
+	kernel_param_lock(THIS_MODULE);
+	for (p = uvc_payload_cap_param; *p; ) {
+		unsigned int v, d, cap;
+
+		if (!strncmp(p, port, n) && p[n] == ':' &&
+		    sscanf(p + n + 1, "%u", &cap) == 1)
+			by_port = cap;
+		else if (sscanf(p, "%x:%x:%u", &v, &d, &cap) == 3 &&
+			 v == vid && d == pid)
+			by_id = cap;
+		p = strchr(p, ',');
+		if (!p)
+			break;
+		p++;
+	}
+	kernel_param_unlock(THIS_MODULE);
+	return by_port >= 0 ? by_port : by_id;
+}
