+/* SpectrumJetson napa-04: whether every frame row a blob's candidate can read has been fed. The candidate
+ * (rough quad, border probe, edge fits, decode, refinement) samples around the black square: its white border
+ * one cell beyond, plus the fit/refine windows. Without this gate a blob finalized near the arrived edge read
+ * the previous frame's rows still in the buffer (a found tag's decision margin could differ from napa_detect).
+ * Bound: 3 cells (the square's height / W cells) + 8 px below the blob's last level row. */
+static int blob_rows_fed(const napa_stream *S, const stream_level *L, int r) {
+    if (S->fed >= S->h) return 1;
+    const blob_box *b = &L->B[r];
+    const int W = S->det->fam.width;
+    int bh = (b->maxy - b->miny + 1) * L->s;
+    int need = (b->maxy + 1) * L->s + (3 * bh + W - 1) / W + 8;
+    return S->fed >= need;
+}
+
 /* Blobs whose last run is in a row before `upto` - 1 ... finished once row `upto` - 1 is labeled:
  * a blob ending at row y is final when row y + 1 is done. */
 static int finalize_rows(napa_stream *S, stream_level *L, int upto_done) {
@@ -2775,6 +2791,16 @@
             int r = find_root(L->P, i);
             if (L->done[r] || L->B[r].maxy != y) continue;
             L->done[r] = 1;
+            if (!blob_rows_fed(S, L, r)) { /* SpectrumJetson napa-04: later, when its rows are in */
+                if (L->npend == L->pend_cap) {
+                    int cap = L->pend_cap ? 2 * L->pend_cap : 64;
+                    int32_t *p = (int32_t *)realloc(L->pend, (size_t)cap * sizeof(int32_t));
+                    if (p == NULL) return -2;
+                    L->pend = p, L->pend_cap = cap;
+                }
+                L->pend[L->npend++] = r;
+                continue;
+            }
             if (finalize_blob(S, L, r)) return -2;
         }
     }
@@ -2782,6 +2808,22 @@
     return 0;
 }
 
+/* SpectrumJetson napa-04: run the pending blobs whose frame rows have now been fed (all of them once the
+ * frame is complete). */
+static int finalize_pending(napa_stream *S, stream_level *L) {
+    int k = 0;
+    for (int i = 0; i < L->npend; i++) {
+        int r = L->pend[i];
+        if (S->fed < S->h && !blob_rows_fed(S, L, r)) {
+            L->pend[k++] = r;
+            continue;
+        }
+        if (finalize_blob(S, L, r)) return -2;
+    }
+    L->npend = k;
+    return 0;
+}
