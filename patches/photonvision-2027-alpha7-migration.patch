+import org.photonvision.vision.processes.CameraSettingsPublisher;
+
+/**
+ * SpectrumJetson (photonvision-30): field calibration from the web UI. Push the robot by hand to
+ * still spots while every camera records (Rewind, labelled {@code fieldcal}); then, on the Jetson,
+ * tools/fieldcal replays the recording through the 971 GPU detector and solves every tag's pose on
+ * the field and every camera's mount.
+ *
+ * <p>While recording, every camera's live detections drive the guidance: when the robot has held
+ * still long enough for a spot to count, which tags have been seen from how many spots, and where
+ * each camera is on the field right now. The solve itself uses only the recording.
+ *
+ * <p>Camera mounts come from robot code, which owns them: each camera's current {@code
+ * robotToCamera} (from CAD, or a past calibration) as a {@code Transform3d} struct at {@code
+ * /photonvision/<camera>/robotToCamera}. The solve anchors x, y and yaw to them and reports how the
+ * solved mounts differ; the solved mounts are published back at {@code
+ * /photonvision/<camera>/fieldcal/robotToCamera}. Without them, x, y and yaw stay relative.
+ *
+ * <p>Files: results in {@link #RUNS}{@code /<recording>/} (report.md, results.json,
+ * corrected-layout.json, mounts.json, and robot-mounts.json, the mounts robot code sent); the
+ * layout in use before each "apply" in {@link #BACKUPS}. The solver and the replay tool are
+ * installed in {@link #TOOL} by scripts/jetson/13-build-fieldcal-detect.sh --install.
+ */
+public class FieldCalibration {
+    private static final Logger logger = new Logger(FieldCalibration.class, LogGroup.General);
+    private static final Jsonb jsonb = Jsonb.builder().serializeNulls(true).build();
+    private static final JsonType<Map<String, Map<String, Map<String, Double>>>> mountsJson =
+            jsonb.type(
+                    Types.newParameterizedType(
+                            Map.class,
+                            String.class,
+                            Types.newParameterizedType(
+                                    Map.class,
+                                    String.class,
+                                    Types.newParameterizedType(
+                                            Map.class,
+                                            String.class,
+                                            Types.newParameterizedType(
+                                                    Map.class, String.class, Double.class)))));
+    private static final JsonType<Map<String, List<String>>> locksJson =
+            jsonb.type(
+                    Types.newParameterizedType(
+                            Map.class,
+                            String.class,
+                            Types.newParameterizedType(List.class, String.class)));
+
+    public static final Path ROOT = Path.of("/opt/photonvision/fieldcal");
+    public static final Path RUNS = ROOT.resolve("runs");
+    public static final Path BACKUPS = ROOT.resolve("layout-backups");
+    /** The settings each camera's tuning leaves alone (the page's lock boxes), kept across restarts. */
+    public static final Path LOCKS = ROOT.resolve("locks.json");
+    public static final Path TOOL = Path.of("/opt/spectrum/fieldcal");
+    public static final String LABEL = "fieldcal";
+    /** Results files the web UI may download. */
+    public static final Set<String> RESULT_FILES =
+            Set.of("report.md", "results.json", "corrected-layout.json", "mounts.json");
+
+    // Live stillness: the same idea as tools/fieldcal's segments.py. A camera's tag corners are
+    // sampled every SAMPLE_NS; more than MOTION_PX between samples (or a completely different set
+    // of tags) is motion. A spot counts after STILL_NS with no motion from any camera.
+    private static final long SAMPLE_NS = 100_000_000L;
+    private static final long MAX_GAP_NS = 500_000_000L;
+    private static final double MOTION_PX = 1.5;
+    private static final long STILL_NS = 1_500_000_000L;
+    private static final long POSE_STALE_NS = 1_000_000_000L;
+
+    public enum State {
+        IDLE,
+        RECORDING,
+        SOLVING,
+        SOLVED,
+        FAILED
+    }
+
+    private static final class CamLive {
+        long sampleNs = 0;
+        Map<Integer, double[]> corners = Map.of();
+        Set<Integer> tagsNow = Set.of();
+        long tagsNs = 0;
+        double[] fieldPose = null; // x, y, yaw (rad): where the camera is on the field
+        long fieldPoseNs = 0;
+        boolean fromMultiTag = false;
+    }
+
+    /** One still stretch the live guidance counted. */
+    private static final class Spot {
+        final int index;
+        final Map<String, Set<Integer>> views = new TreeMap<>();
+        final Map<String, double[]> cameraPoses = new TreeMap<>();
+
+        Spot(int index) {
+            this.index = index;
+        }
+    }
+
+    private static FieldCalibration INSTANCE;
+
+    public static synchronized FieldCalibration getInstance() {
+        if (INSTANCE == null) INSTANCE = new FieldCalibration();
+        return INSTANCE;
+    }
+
+    private volatile State state = State.IDLE;
+    private volatile String session = "";
+    private volatile String message = "";
+    private long recordStartNs = 0;
+
+    private final Map<String, CamLive> live = new TreeMap<>();
+    private long lastMotionNs = 0;
+    private long lastStillEvidenceNs = 0;
+    private Spot current = null;
+    private final List<Spot> spots = new ArrayList<>();
+    private final Map<Integer, Set<Integer>> tagSpots = new TreeMap<>(); // tag -> spots that saw it
+    private final Map<String, Integer> cameraSpots = new TreeMap<>();
+
+    private final Map<String, StructSubscriber<Transform3d>> mountSubs = new TreeMap<>();
+    private final Map<String, StructPublisher<Transform3d>> solvedPubs = new TreeMap<>();
+    private final ArrayDeque<String> solveLog = new ArrayDeque<>();
+    private Process solveProcess = null;
+    private final CameraSettingsTuner tuner = new CameraSettingsTuner();
+
+    private FieldCalibration() {}
+
+    // ---- control (from the web UI)
+
+    public synchronized void start() {
+        if (state == State.RECORDING) return;
+        if (state == State.SOLVING) throw new IllegalStateException("A solve is running");
+        if (tuner.running()) throw new IllegalStateException("Camera settings tuning is running");
+        resetLive();
+        RewindManager.getInstance().setManual(true, LABEL);
+        session = RewindManager.getInstance().currentSessionName();
+        state = State.RECORDING;
+        message = "";
+        recordStartNs = System.nanoTime();
+        logger.info("Field calibration: recording started" + (session.isEmpty() ? "" : " (" + session + ")"));
+    }
+
+    /** Stops recording; returns the recording's name. */
+    public synchronized String stop() {
+        if (state != State.RECORDING) return session;
+        String s = RewindManager.getInstance().currentSessionName();
+        if (!s.isEmpty()) session = s;
+        RewindManager.getInstance().setManual(false, "");
+        state = State.IDLE;
+        logger.info("Field calibration: recording stopped (" + session + ", " + spots.size() + " spots)");
+        return session;
+    }
+
+    /** Stop recording, let the recorders finish their files, then solve that recording. */
+    public void stopAndSolve() throws IOException, InterruptedException {
+        String name = stop();
+        Thread.sleep(1500); // recorders close on their next frame; session.json's end ~1 s later
+        solve(name);
+    }
+
+    public synchronized void solve(String name) throws IOException {
+        if (state == State.RECORDING) throw new IllegalStateException("Stop recording first");
+        if (state == State.SOLVING) throw new IllegalStateException("A solve is already running");
+        Path rec = RewindManager.sessionDir(name);
+        if (rec == null) throw new IllegalArgumentException("No such recording: " + name);
+        if (!toolInstalled()) {
+            throw new IllegalStateException(
+                    "The solver isn't installed on this Jetson: run scripts/jetson/13-build-fieldcal-detect.sh --install");
+        }
+        Path out = RUNS.resolve(name);
+        Files.createDirectories(out);
+        Path layout = out.resolve("official-layout.json");
+        ConfigManager.getInstance().getConfig().getFieldLayout().serialize(layout);
+
+        List<String> cmd = new ArrayList<>(
+                List.of("nice", "-n", "10", "python3", "-m", "fieldcal", "solve", rec.toString(),
+                        "--layout", layout.toString(), "--out", out.toString()));
+        var mounts = robotMounts();
+        Path cad = out.resolve("robot-mounts.json");
+        Files.deleteIfExists(cad);
+        if (!mounts.isEmpty()) {
+            Files.writeString(cad, jsonb.toJsonPretty(mounts) + System.lineSeparator(), StandardCharsets.UTF_8);
+            cmd.addAll(List.of("--cad", cad.toString()));
+        }
+        var pb = new ProcessBuilder(cmd).redirectErrorStream(true);
+        pb.environment().put("PYTHONPATH", TOOL.toString());
+        pb.environment().put("FIELDCAL_971_DETECT", TOOL.resolve("fieldcal_detect").toString());
+        solveLog.clear();
+        session = name;
+        state = State.SOLVING;
+        message = "";
+        solveProcess = pb.start();
+        var proc = solveProcess;
+        logger.info("Field calibration: solving " + name + ": " + String.join(" ", cmd));
+        var t = new Thread(() -> runSolve(proc, out), "FieldCalSolve");
+        t.setDaemon(true);
+        t.start();
+    }
+
+    private void runSolve(Process proc, Path out) {
+        try (var r = new BufferedReader(new InputStreamReader(proc.getInputStream(), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                synchronized (this) {
+                    solveLog.addLast(line);
+                    while (solveLog.size() > 300) solveLog.removeFirst();
+                }
+            }
+            int code = proc.waitFor();
+            synchronized (this) {
+                boolean ok = code == 0 && Files.exists(out.resolve("results.json"));
+                state = ok ? State.SOLVED : State.FAILED;
+                if (ok) publishSolvedMounts(out);
+                message = ok ? "" : lastLogLine("The solve failed (exit code " + code + ")");
+                solveProcess = null;
+                logger.info("Field calibration: solve of " + session + (ok ? " done" : " failed: " + message));
+            }
+        } catch (Exception e) {
+            synchronized (this) {
+                state = State.FAILED;
+                message = "The solve failed: " + e.getMessage();
+                solveProcess = null;
+            }
+            logger.error("Field calibration: solve failed", e);
+        }
+    }
+
+    private String lastLogLine(String fallback) {
+        for (var it = solveLog.descendingIterator(); it.hasNext(); ) {
+            String l = it.next().strip();
+            if (!l.isEmpty() && !l.startsWith("note:")) return l;
+        }
+        return fallback;
+    }
+
+    public synchronized void cancelSolve() {
+        if (solveProcess != null) solveProcess.destroy();
+    }
+
+    /**
+     * The mounts robot code is sending right now, by camera: {x, y, z (m), rollDeg, pitchDeg,
+     * yawDeg}, the format tools/fieldcal's --cad reads.
+     */
+    public synchronized Map<String, Map<String, Double>> robotMounts() {
+        for (String name : CameraSettingsPublisher.snapshots().keySet()) {
+            mountSubs.computeIfAbsent(
+                    name,
+                    n ->
+                            NetworkTablesManager.getInstance()
+                                    .getNTInst()
+                                    .getStructTopic("/photonvision/" + n + "/robotToCamera", Transform3d.struct)
+                                    .subscribe(null));
+        }
+        Map<String, Map<String, Double>> out = new TreeMap<>();
+        for (var e : mountSubs.entrySet()) {
+            Transform3d t = e.getValue().get();
+            if (t == null) continue;
+            Map<String, Double> m = new LinkedHashMap<>();
+            m.put("x", t.getX());
+            m.put("y", t.getY());
+            m.put("z", t.getZ());
+            m.put("rollDeg", Math.toDegrees(t.getRotation().getX()));
+            m.put("pitchDeg", Math.toDegrees(t.getRotation().getY()));
+            m.put("yawDeg", Math.toDegrees(t.getRotation().getZ()));
+            out.put(e.getKey(), m);
+        }
+        return out;
+    }
+
+    /** Publishes the solved mounts for robot code to log or compare. */
+    private void publishSolvedMounts(Path out) {
+        try {
+            Map<String, Map<String, Map<String, Double>>> mounts =
+                    mountsJson.fromJson(out.resolve("mounts.json"));
+            for (var entry : mounts.entrySet()) {
+                Map<String, Double> values = entry.getValue().get("robotToCamera");
+                if (values == null) continue;
+                var transform =
+                        new Transform3d(
+                                new Translation3d(values.get("x"), values.get("y"), values.get("z")),
+                                new Rotation3d(
+                                        Math.toRadians(values.get("rollDeg")),
+                                        Math.toRadians(values.get("pitchDeg")),
+                                        Math.toRadians(values.get("yawDeg"))));
+                solvedPubs
+                        .computeIfAbsent(
+                                entry.getKey(),
+                                name ->
+                                        NetworkTablesManager.getInstance()
+                                                .getNTInst()
+                                                .getStructTopic(
+                                                        "/photonvision/" + name + "/fieldcal/robotToCamera",
+                                                        Transform3d.struct)
+                                                .publish())
+                        .set(transform);
+            }
+        } catch (RuntimeException e) {
+            logger.warn("Field calibration: can't publish the solved mounts: " + e.getMessage());
+        }
+    }
+
+    /** Copies the layout in use now to {@link #BACKUPS}; returns the copy. */
+    public Path backupLayout() throws IOException {
+        Files.createDirectories(BACKUPS);
+        String stamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyyMMdd-HHmmss"));
+        Path p = BACKUPS.resolve("layout-" + stamp + ".json");
+        ConfigManager.getInstance().getConfig().getFieldLayout().serialize(p);
+        return p;
+    }
+
+    /** A results file of a solve, or null (only the files in {@link #RESULT_FILES}). */
+    public static Path resultFile(String name, String file) {
+        if (name == null || file == null || name.isEmpty() || !RewindManager.safeName(name).equals(name)) return null;
+        if (!RESULT_FILES.contains(file)) return null;
+        Path p = RUNS.resolve(name).resolve(file);
+        return p.getParent().getParent().equals(RUNS) && Files.isRegularFile(p) ? p : null;
+    }
+
+    public static Path latestBackup() {
+        try (Stream<Path> s = Files.list(BACKUPS)) {
+            return s.filter(p -> p.getFileName().toString().endsWith(".json")).sorted().reduce((a, b) -> b).orElse(null);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    public static boolean toolInstalled() {
+        return Files.isRegularFile(TOOL.resolve("fieldcal").resolve("__main__.py"))
+                && Files.isExecutable(TOOL.resolve("fieldcal_detect"));
+    }
+
+    // ---- live guidance (every camera's pipeline results)
+
+    private synchronized void resetLive() {
+        live.clear();
+        spots.clear();
+        tagSpots.clear();
+        cameraSpots.clear();
+        current = null;
+        lastMotionNs = System.nanoTime();
+        lastStillEvidenceNs = 0;
+    }
+
+    // ---- camera settings tuning
+
+    /**
+     * Tunes one camera's settings, or every camera's if {@code camera} is null. {@code locked}:
+     * per camera, the controls to leave as they are.
+     */
+    public synchronized void tune(String camera, Map<String, List<String>> locked) {
+        if (state == State.RECORDING) throw new IllegalStateException("Stop recording first");
+        if (state == State.SOLVING) throw new IllegalStateException("A solve is running");
+        tuner.start(camera, locked != null ? locked : locks());
+    }
+
+    /** Locks or unlocks one setting of one camera for tuning. */
+    public synchronized void setLock(String camera, String control, boolean on) throws IOException {
+        var all = locks();
+        var set = new TreeSet<>(all.getOrDefault(camera, List.of()));
+        if (on) set.add(control);
+        else set.remove(control);
+        all.put(camera, new ArrayList<>(set));
+        Files.createDirectories(ROOT);
+        Files.writeString(LOCKS, locksJson.toJson(all), StandardCharsets.UTF_8);
+    }
+
+    /** {camera: [locked controls]}. */
+    public synchronized Map<String, List<String>> locks() {
+        try {
+            if (Files.exists(LOCKS)) {
+                return new TreeMap<>(locksJson.fromJson(LOCKS));
+            }
+        } catch (RuntimeException e) {
+            logger.warn("Field calibration: bad " + LOCKS + ": " + e.getMessage());
+        }
+        return new TreeMap<>();
+    }
+
+    /** A manual change from the page: one control of one camera's pipeline in use. */
+    public void setControl(String camera, String control, double value) {
+        var m = module(camera);
+        if (tuner.tuning(camera)) throw new IllegalStateException(camera + " is being tuned: wait, or stop the tuning");
+        CameraSettingsTuner.setControl(m, control, value);
+    }
+
+    private static org.photonvision.vision.processes.VisionModule module(String camera) {
+        for (var m : org.photonvision.vision.processes.VisionSourceManager.getInstance().vmm.getModules()) {
+            if (m.getNickname().equals(camera)) return m;
+        }
+        throw new IllegalArgumentException("No camera named " + camera);
+    }
+
+    public void cancelTune() {
+        tuner.cancel();
+    }
+
+    public List<String> applyTuning(String camera) {
+        return tuner.apply(camera);
+    }
+
+    // ---- preview: what each camera sees right now, while the page is open
+
+    private static final long PREVIEW_NS = 250_000_000L;
+    private volatile long lastPollNs = 0;
+    private final Map<String, Map<String, Object>> preview = new java.util.concurrent.ConcurrentHashMap<>();
+    private final Map<String, Long> previewNs = new java.util.concurrent.ConcurrentHashMap<>();
+
+    private void previewSample(String camera, CVPipelineResult result, long now) {
+        Long last = previewNs.get(camera);
+        if (last != null && now - last < PREVIEW_NS) return;
+        previewNs.put(camera, now);
+        Map<String, Double> margins = new TreeMap<>();
+        for (var t : result.targets) {
+            if (t.getFiducialId() >= 0) margins.put(Integer.toString(t.getFiducialId()), (double) Math.round(t.getDecisionMargin()));
+        }
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("margins", margins);
+        m.put("ageMs", 0);
+        m.put("ns", now);
+        preview.put(camera, m);
+    }
+
+    /** Called with every pipeline result of every camera; cheap unless recording or tuning. */
+    public void onResult(String camera, CVPipelineResult result) {
+        if (tuner.running()) tuner.onResult(camera, result);
+        if (lastPollNs != 0 && System.nanoTime() - lastPollNs < 5_000_000_000L) {
+            previewSample(camera, result, System.nanoTime());
+        }
+        if (state != State.RECORDING) return;
+        long now = System.nanoTime();
+        synchronized (this) {
+            var c = live.computeIfAbsent(camera, k -> new CamLive());
+            // Where the camera is: multi-tag if there is one, else the least ambiguous single tag.
+            double[] pose = null;
+            boolean multi = false;
+            if (result.multiTagResult != null && result.multiTagResult.isPresent()) {
+                var p = new Pose3d().plus(result.multiTagResult.get().estimatedPose.best);
+                pose = new double[] {p.getX(), p.getY(), p.getRotation().getZ()};
+                multi = true;
+            } else {
+                var layout = ConfigManager.getInstance().getConfig().getFieldLayout();
+                for (var t : result.targets) {
+                    if (t.getPoseAmbiguity() < 0 || t.getPoseAmbiguity() > 0.15) continue;
+                    var tag = layout.getTagPose(t.getFiducialId());
+                    if (tag.isEmpty()) continue;
+                    var p = tag.get().transformBy(t.getBestCameraToTarget3d().inverse());
+                    pose = new double[] {p.getX(), p.getY(), p.getRotation().getZ()};
+                    break;
+                }
+            }
+            if (pose != null) {
+                c.fieldPose = pose;
+                c.fieldPoseNs = now;
+                c.fromMultiTag = multi;
+            }
+            if (now - c.sampleNs < SAMPLE_NS) return;
+
+            Map<Integer, double[]> corners = new HashMap<>();
+            for (var t : result.targets) {
+                var pts = t.getTargetCorners();
+                if (t.getFiducialId() < 0 || pts == null || pts.size() != 4) continue;
+                double[] a = new double[8];
+                for (int i = 0; i < 4; i++) {
+                    a[2 * i] = pts.get(i).x;
+                    a[2 * i + 1] = pts.get(i).y;
+                }
+                corners.put(t.getFiducialId(), a);
+            }
+            // Motion since this camera's last sample.
+            if (!corners.isEmpty() && c.sampleNs > 0 && now - c.sampleNs < MAX_GAP_NS) {
+                double m = -1;
+                for (var e : corners.entrySet()) {
+                    double[] prev = c.corners.get(e.getKey());
+                    if (prev == null) continue;
+                    for (int i = 0; i < 4; i++) {
+                        m = Math.max(m, Math.hypot(e.getValue()[2 * i] - prev[2 * i], e.getValue()[2 * i + 1] - prev[2 * i + 1]));
+                    }
+                }
+                if (m > MOTION_PX || (m < 0 && !c.corners.isEmpty())) {
+                    motion(now);
+                } else if (m >= 0) {
+                    lastStillEvidenceNs = now;
+                }
+            }
+            c.sampleNs = now;
+            c.corners = corners;
+            c.tagsNow = new TreeSet<>(corners.keySet());
+            c.tagsNs = now;
+
+            // A spot counts once everything has been still for STILL_NS.
+            if (lastStillEvidenceNs > lastMotionNs && now - lastMotionNs >= STILL_NS) {
+                if (current == null) {
+                    current = new Spot(spots.size());
+                    spots.add(current);
+                }
+                for (var e : live.entrySet()) {
+                    var cl = e.getValue();
+                    if (now - cl.tagsNs > MAX_GAP_NS || cl.tagsNow.isEmpty()) continue;
+                    var set = current.views.computeIfAbsent(e.getKey(), k -> new TreeSet<>());
+                    if (set.isEmpty()) cameraSpots.merge(e.getKey(), 1, Integer::sum);
+                    for (int id : cl.tagsNow) {
+                        if (set.add(id)) tagSpots.computeIfAbsent(id, k -> new TreeSet<>()).add(current.index);
+                    }
+                    if (cl.fieldPose != null && now - cl.fieldPoseNs < POSE_STALE_NS) {
+                        current.cameraPoses.put(e.getKey(), cl.fieldPose.clone());
+                    }
+                }
+            }
+        }
+    }
+
+    private void motion(long now) {
+        lastMotionNs = now;
+        current = null;
+    }
+
+    // ---- status (GET /api/fieldcal)
+
+    public synchronized Map<String, Object> status() {
+        long now = System.nanoTime();
+        lastPollNs = now; // the page is open: keep the preview going
+        Map<String, Object> pv = new TreeMap<>();
+        preview.forEach((cam, m) -> {
+            var copy = new LinkedHashMap<>(m);
+            copy.put("ageMs", (now - (long) m.get("ns")) / 1_000_000);
+            copy.remove("ns");
+            pv.put(cam, copy);
+        });
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("state", state.name());
+        m.put("session", session);
+        m.put("message", message);
+        m.put("toolInstalled", toolInstalled());
+        m.put("seconds", state == State.RECORDING ? (now - recordStartNs) / 1e9 : 0);
+        var rewind = RewindManager.getInstance().status();
+        m.put("rewindRecording", rewind.get("recording"));
+        m.put("rewindSession", rewind.get("session"));
+
+        if (state == State.RECORDING) {
+            boolean anyTags = live.values().stream().anyMatch(c -> now - c.tagsNs < MAX_GAP_NS && !c.tagsNow.isEmpty());
+            boolean still = anyTags && lastStillEvidenceNs > lastMotionNs;
+            m.put("still", still);
+            m.put("stillSeconds", still ? (now - lastMotionNs) / 1e9 : 0.0);
+            m.put("holdSeconds", STILL_NS / 1e9);
+            m.put("spotCaptured", current != null);
+            Map<String, Object> cams = new TreeMap<>();
+            for (var e : live.entrySet()) {
+                var c = e.getValue();
+                Map<String, Object> cm = new LinkedHashMap<>();
+                cm.put("tags", now - c.tagsNs < MAX_GAP_NS ? c.tagsNow : List.of());
+                cm.put("pose", c.fieldPose != null && now - c.fieldPoseNs < POSE_STALE_NS ? c.fieldPose : null);
+                cm.put("multiTag", c.fromMultiTag);
+                cams.put(e.getKey(), cm);
+            }
+            m.put("live", cams);
+        }
+        List<Map<String, Object>> sp = new ArrayList<>();
+        for (var s : spots) {
+            Map<String, Object> e = new LinkedHashMap<>();
+            e.put("views", s.views);
+            e.put("cameraPoses", s.cameraPoses);
+            sp.add(e);
+        }
+        m.put("spots", sp);
+        Map<String, Integer> ts = new TreeMap<>();
+        tagSpots.forEach((k, v) -> ts.put(Integer.toString(k), v.size()));
+        m.put("tagSpots", ts);
+        m.put("cameraSpots", cameraSpots);
+        m.put("solveLog", new ArrayList<>(solveLog));
+        m.put("tuning", tuner.status());
+        Map<String, Object> controls = new TreeMap<>();
+        for (var mod : org.photonvision.vision.processes.VisionSourceManager.getInstance().vmm.getModules()) {
+            try {
+                Map<String, Object> c = new LinkedHashMap<>();
+                CameraSettingsTuner.controls(mod).forEach((k, v) -> c.put(k, Map.of("min", v[0], "max", v[1], "default", v[2], "value", v[3])));
+                c.put("pipelineIndex", mod.getCurrentPipelineIndex());
+                c.put("autoExposure", mod.getCurrentPipelineSettings().cameraAutoExposure);
+                controls.put(mod.getNickname(), c);
+            } catch (Exception e) {
+                // camera unplugged: its controls come back on the next poll
+            }
+        }
+        m.put("controls", controls);
+        m.put("preview", pv);
+        m.put("locks", locks());
+        m.put("robotMounts", robotMounts());
+        m.put("robotConnected", NetworkTablesManager.getInstance().getNTInst().isConnected());
+        m.put("cameras", CameraSettingsPublisher.snapshots());
+        m.put("runs", runs());
+        var b = latestBackup();
+        m.put("latestBackup", b == null ? "" : b.getFileName().toString());
+        return m;
+    }
+
+    /** Recordings with results, newest first. */
+    private static List<String> runs() {
+        List<String> out = new ArrayList<>();
+        try (Stream<Path> s = Files.list(RUNS)) {
+            s.filter(p -> Files.exists(p.resolve("results.json")))
+                    .map(p -> p.getFileName().toString())
+                    .sorted((a, b) -> b.compareTo(a))
+                    .forEach(out::add);
+        } catch (IOException e) {
+            // no runs yet
+        }
+        return out;
+    }
+
+    /** Field-calibration recordings (Rewind sessions labelled fieldcal), newest first. */
+    public static List<String> recordings() {
+        List<String> out = new ArrayList<>();
+        try (Stream<Path> s = Files.list(RewindManager.SESSIONS)) {
+            s.map(p -> p.getFileName().toString())
+                    .filter(n -> n.contains("_" + LABEL + "_"))
+                    .sorted((a, b) -> b.compareTo(a))
+                    .forEach(out::add);
+        } catch (IOException e) {
+            // none
+        }
+        return out;
+    }
+}
