+void GpuDetector::SetEdgeBorder(int px) {
+  EdgeBorder edge;
+  if (px > 0) {
+    edge.px = px;
+    edge.max_x = static_cast<int32_t>(width_) - 1 - px;
+    edge.max_y = static_cast<int32_t>(height_) - 1 - px;
+  }
+  if (edge.px == edge_border_.px) return;
+  edge_border_ = edge;
+  // The blob filter's parameters are baked into the recorded stage graphs: record them again.
+  for (auto& [k, exec] : stage_graphs_) cudaGraphExecDestroy(exec);
+  stage_graphs_.clear();
+}
