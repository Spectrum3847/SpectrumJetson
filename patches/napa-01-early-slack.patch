+/* SpectrumJetson: the early decode's slack (bits looser than the final decode, on border cells and the
+ * Hamming limit). 2 is NAPA's built-in value. Returns 0, or -1 for a NULL handle or slack outside 0-3. */
+int napa_set_early_slack(napa_detector *det, int slack) {
+    if (det == NULL || slack < 0 || slack > 3) return -1;
+    det->early_slack = slack;
+    return 0;
+}
