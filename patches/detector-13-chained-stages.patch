+// detector-13: the counts a frame needed. The guesses follow the largest count of the last frames,
+// decaying ~3% a frame, so a busy moment keeps the buckets up for a second or so.
+void GpuDetector::NoteStageCounts(size_t points, size_t selected, size_t quads) {
+  auto track = [](size_t& held, size_t now) { held = std::max(now, held - held / 32); };
+  track(chain_points_, points);
+  track(chain_selected_, selected);
+  track(chain_quads_, quads);
+  ++chain_frames_;
+  if (!SpectrumChainedStages()) return;
+  // Ask for the graphs the next frames will guess (recorded between frames, RecordStageGraphs).
+  const size_t points_capacity = sorted_union_marker_pair_device_.size();
+  StageGraph(2, StageBucket(chain_points_ + chain_points_ / 8, points_capacity), 0);
+  StageGraph(3, StageBucket(chain_selected_ + chain_selected_ / 8, points_capacity),
+             StageBucket(chain_quads_ + chain_quads_ / 8, kMaxBlobs));
+}
+
+// detector-13: stages 2 and 3 with guessed buckets, launched behind stage 1, one wait. Unavailable:
+// no guess yet, or its graphs aren't recorded yet. *missed: a count didn't fit its guessed bucket;
+// the caller runs DetectGraphStages, which launches stages 2 and 3 again with the right buckets.
+absl::Status GpuDetector::DetectChainedStages(int* num_selected_blobs, int* num_quad_peaked_quads,
+                                              bool* done, bool* missed) {
+  *missed = false;
+  if (chain_frames_ < 2) return absl::UnavailableError("no counts yet");
+  const size_t points_capacity = sorted_union_marker_pair_device_.size();
+  const size_t points_bucket = StageBucket(chain_points_ + chain_points_ / 8, points_capacity);
+  const size_t selected_bucket = StageBucket(chain_selected_ + chain_selected_ / 8, points_capacity);
+  const size_t quads_bucket = StageBucket(chain_quads_ + chain_quads_ / 8, kMaxBlobs);
+  cudaGraphExec_t second = RecordedStageGraph(2, points_bucket, 0);
+  cudaGraphExec_t third = RecordedStageGraph(3, selected_bucket, quads_bucket);
+  if (!second || !third) return absl::UnavailableError("guessed graphs not recorded yet");
+  CHECK_CUDA(cudaGraphLaunch(second, stream_.get()));
+  CHECK_CUDA(cudaGraphLaunch(third, stream_.get()));
+  CHECK_CUDA(cudaStreamSynchronize(stream_.get()));
+  const size_t n = static_cast<size_t>(*num_compressed_union_marker_pair_host_.get());
+  const size_t num_quads = *num_quads_host_.get();
+  const int selected = stage_counts_host_.get()[0];
+  // As DetectGraphStages, in the same order: too many quads is an error whatever the buckets.
+  if (n <= points_bucket && num_quads > kMaxBlobs) {
+    return absl::ResourceExhaustedError(
+        "more candidate quads (" + std::to_string(num_quads) +
+        ") than the detector's buffers hold (" + std::to_string(kMaxBlobs) +
+        "): frame skipped");
+  }
+  if (n > points_bucket || static_cast<size_t>(selected) > selected_bucket ||
+      num_quads > quads_bucket) {
+    *missed = true;
+    return absl::OkStatus();
+  }
+  NoteStageCounts(n, static_cast<size_t>(selected), num_quads);
+  *num_selected_blobs = selected;
+  if (selected == 0) {
+    *done = true;
+    return absl::OkStatus();
+  }
+  *num_quad_peaked_quads = stage_counts_host_.get()[1];
+  return absl::OkStatus();
+}
