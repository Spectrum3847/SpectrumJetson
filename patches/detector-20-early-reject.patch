+
+int spectrum_early_check(apriltag_detector_t* td, const float p[4][2], int reversed_border, image_u8_t* im,
+                         int slack, int mode);  // detector-20
 };
 
+// SpectrumJetson (detector-20): SPECTRUM_DETECTOR_EARLY_REJECT=N checks each quad on its unrefined corners
+// (border + payload, N errors of slack; apriltag.c's spectrum_early_check) and drops it before RefineEdges
+// when it can't be a tag. Unset or negative = off (the default). SPECTRUM_DETECTOR_EARLY_MODE: border (the
+// border rings only) or scales (also at 0.92x and 1.08x). SPECTRUM_DETECTOR_EARLY_STATS=FILE: one line per
+// DecodeTags (detector-replay measurements): detector,quads,passed,detections,early_cpu_us,refine_cpu_us,
+// decode_cpu_us,wall_us (thread CPU time summed over the decode workers).
+namespace spectrum_early {
+inline int Slack() {
+  static const int v = [] {
+    const char* e = std::getenv("SPECTRUM_DETECTOR_EARLY_REJECT");
+    return e && *e ? std::atoi(e) : -1;
+  }();
+  return v;
+}
+inline int Mode() {
+  static const int v = [] {
+    const char* e = std::getenv("SPECTRUM_DETECTOR_EARLY_MODE");
+    if (!e) return 0;
+    const std::string m = e;
+    return m == "border" ? 1 : m == "scales" ? 2 : 0;
+  }();
+  return v;
+}
+inline FILE* Stats() {
+  static FILE* f = [] {
+    const char* e = std::getenv("SPECTRUM_DETECTOR_EARLY_STATS");
+    return e && *e ? std::fopen(e, "w") : nullptr;
+  }();
+  return f;
+}
+std::atomic<long> quads{0}, passed{0}, early_ns{0}, refine_ns{0}, decode_ns{0};
+inline long ThreadNs() {
+  timespec t;
+  clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+  return t.tv_sec * 1000000000L + t.tv_nsec;
+}
+}  // namespace spectrum_early
+
 namespace frc::apriltag {
 namespace {
 
