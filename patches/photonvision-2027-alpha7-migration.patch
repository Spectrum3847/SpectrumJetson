+    </v-card>
+
+    <!-- Step 4: results -->
+    <v-card v-if="status && status.runs.length" class="mb-3 rounded-12" color="surface">
+      <v-card-title>4. Results</v-card-title>
+      <v-card-text>
+        <v-select
+          :model-value="resultsRun"
