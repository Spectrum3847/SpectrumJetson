     after_filter_.Synchronize();
   }
 
+  // SpectrumJetson: a frame with no candidate blobs (uniform image: covered lens, dark pit,
+  // plain wall) leaves num_selected_blobs_host == 0. FitLines then launched a <<<0, 128>>>
+  // kernel, an invalid launch configuration that surfaced in the next CUB call as status 101
+  // on every such frame. Nothing can be detected, so report no detections.
+  if (num_selected_blobs_host == 0) {
+    for (int i = 0; i < zarray_size(detections_); ++i) {
+      apriltag_detection_t* det;
+      zarray_get(detections_, i, &det);
+      apriltag_detection_destroy(det);
+    }
+    zarray_truncate(detections_, 0);
+    return absl::OkStatus();
+  }
+
