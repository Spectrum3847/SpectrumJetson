+package org.photonvision.common.hardware.metrics;
+
+/**
+ * SpectrumJetson (photonvision-76): the board's input voltage (the INA3221's VDD_IN), sampled
+ * often so a short dip between once-a-second publishes still shows up. Keeps the latest reading, the
+ * lowest since the last {@link #takeSecond()}, and the lowest since PhotonVision started.
+ *
+ * <p>Why: at TXMAN1 cameras dropped off USB mid-match ("disabled by hub (EMI?)") and only the
+ * power could be suspected, never checked: the voltage was read for {@code powerW} and thrown away.
+ * The INA3221 averages over a few milliseconds, so a dip shorter than that can still be missed.
+ */
+final class InputVoltage {
+    private double lastMv = Double.NaN;
+    private double secondMinMv = Double.NaN;
+    private double lowestMv = Double.NaN;
+
+    /** One reading, in millivolts. */
+    synchronized void sample(double mv) {
+        lastMv = mv;
+        if (Double.isNaN(secondMinMv) || mv < secondMinMv) secondMinMv = mv;
+        if (Double.isNaN(lowestMv) || mv < lowestMv) lowestMv = mv;
+    }
+
+    /** {latest, lowest since the last call, lowest since start}, in volts; NaN before any sample. */
+    synchronized double[] takeSecond() {
+        double[] v = {lastMv / 1000, secondMinMv / 1000, lowestMv / 1000};
+        secondMinMv = Double.NaN;
+        return v;
+    }
+}
